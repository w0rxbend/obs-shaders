// Lens Dirt — procedural noise-based sensor dust/smudge overlay
// Strength: controls how dark the dirt patches get (0.0 = invisible, 1.0 = full black)
// Scale:    controls the size of the noise pattern (higher = smaller patches)

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.7;

uniform float scale <
    string label = "Scale";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 60.0;
    float step = 0.1;
> = 20.0;

uniform texture2d image;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash(float2 p)
{
    p = frac(p * 0.3183099 + float2(.71, .113));
    p *= 50.0;
    return frac(p.x * p.y * (p.x + p.y));
}

float noise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);

    float a = hash(i);
    float b = hash(i + float2(1, 0));
    float c = hash(i + float2(0, 1));
    float d = hash(i + float2(1, 1));

    float2 u = f * f * (3.0 - 2.0 * f);

    return lerp(
        lerp(a, b, u.x),
        lerp(c, d, u.x),
        u.y
    );
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float4 col = image.Sample(textureSampler, uv);

    // Isotropic dust. uv_size keeps patches from stretching on wide frames.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = float2(uv.x * aspect, uv.y) * scale;

    // Fractal noise: 3 octaves for organic-looking dirt
    float dirt = noise(p);
    dirt += noise(p * 2.5) * 0.5;
    dirt += noise(p * 5.0) * 0.25;
    dirt /= max(1.75, 0.001);

    float mask = smoothstep(0.45, 0.85, dirt);

    // Darken dirt peaks only. Clean pixels stay at source brightness.
    col.rgb *= 1.0 - strength * mask;

    // Slight desaturation in dirt areas for a more realistic look
    float lum = dot(col.rgb, float3(0.299, 0.587, 0.114));
    float3 gray = float3(lum, lum, lum);
    col.rgb = lerp(col.rgb, gray, mask * 0.3);

    return float4(saturate(col.rgb), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
