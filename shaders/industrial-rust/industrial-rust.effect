// K3 — industrial-rust
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Orange-brown rust tone, heavy grain, crushed blacks, scratched-metal sheen
// Chain order: apply after base color correction, before output

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float rust_amount <
    string label = "Rust Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.7;

uniform float grain <
    string label = "Grain";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.15;

uniform float contrast <
    string label = "Contrast";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.8;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float noise2(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Scratch pattern: horizontal streaks
float scratchLine(float2 uv, float t)
{
    float frame    = floor(t * 8.0);
    float yPos     = hash21(float2(frame, 0.3));
    float width    = hash21(float2(frame, 0.7)) * 0.003 + 0.001;
    float dist     = abs(uv.y - yPos);
    float presence = step(hash21(float2(frame, 0.9)), 0.25); // 25% chance per frame
    return presence * saturate(1.0 - dist / max(width, 0.001)) * 0.6;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 src = image.Sample(textureSampler, uv);

    // Desaturate to near mono first
    float luma = dot(src.rgb, float3(0.299, 0.587, 0.114));
    float3 col = lerp(src.rgb, float3(luma, luma, luma), 0.75);

    // Contrast: crush blacks
    col = (col - 0.5) * contrast + 0.5;
    col = saturate(col);
    // Further crush blacks toward 0
    col = col * col * (3.0 - 2.0 * col); // smoothstep on channel values
    col = saturate(col);

    // Rust tint: orange-brown color grade
    // Lift shadows to warm brown, shift mids to orange
    float3 rust_shadow  = float3(0.22, 0.10, 0.03);
    float3 rust_mid     = float3(0.75, 0.40, 0.10);
    float3 rust_high    = float3(0.95, 0.80, 0.55);
    float lumaC = dot(col, float3(0.333, 0.333, 0.334));
    float3 rusted = lerp(rust_shadow, lerp(rust_mid, rust_high, saturate(lumaC * 2.0 - 1.0)), saturate(lumaC * 2.0));
    col = lerp(col, rusted, rust_amount);

    // Square grain cells in source pixels. Coarse layer stays 1/6 of the fine grid.
    float t = floor(elapsed_time * 18.0);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float cells_y = max(uv_size.y, 1.0);
    float2 grid = float2(cells_y * aspect, cells_y);
    float2 gp_fine = uv * grid + float2(t * 13.1, t * 27.3);
    float2 gp_coarse = uv * grid * (1.0 / 6.0) + float2(t * 5.7, t * 11.9);
    float gFine   = (noise2(gp_fine)   - 0.5) * 2.0;
    float gCoarse = (noise2(gp_coarse) - 0.5) * 2.0;
    float grainVal = gFine * 0.7 + gCoarse * 0.3;
    col += grainVal * grain;
    col  = saturate(col);

    // Scratched-metal sheen: bright horizontal streaks
    float scratch = scratchLine(uv, elapsed_time);
    col = saturate(col + float3(scratch, scratch * 0.9, scratch * 0.7));

    // Vignette
    float2 vig_uv = uv * 2.0 - 1.0;
    float vig = saturate(1.0 - dot(vig_uv, vig_uv) * 0.5);
    col *= vig;

    return float4(saturate(col), src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
