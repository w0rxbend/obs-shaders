// Paranormal Camera Twitch
// Mostly stable frame with sudden twitch bursts.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;

uniform float speed = 1.0;
uniform float amount = 1.0;
uniform float zoom_compensation = 0.055;
uniform float center_x = 0.5;
uniform float center_y = 0.5;
uniform bool strong_preset = false;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv;
    return vert_out;
}

float2 rotate2d(float2 p, float a)
{
    float s = sin(a);
    float c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float n)
{
    return frac(sin(n * 113.13) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float preset = strong_preset ? 3.2 : 1.0;
    float t = elapsed_time * speed;
    float pulse = pow(saturate(sin(t * 2.1) * 0.5 + 0.5), 18.0);
    float frame = floor(t * 18.0);
    float2 twitch = (float2(hash11(frame), hash11(frame + 9.0)) - 0.5) * 0.028 * pulse * amount * preset;
    float angle = (hash11(frame + 23.0) - 0.5) * 0.045 * pulse * amount * preset;

    float2 center = float2(center_x, center_y);
    float zoom = 1.0 + max(0.0, zoom_compensation) + length(twitch) * 2.5 + abs(angle) * 1.5;
    float2 p = (v_in.uv - center) / zoom;
    float2 uv = center + rotate2d(p, angle) - twitch;
    return image.Sample(textureSampler, clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0)));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
