// Paranormal Camera Twitch
// Mostly stable frame with sudden twitch bursts.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.0;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.0;

uniform float zoom_compensation <
    string label = "Zoom Compensation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.001;
> = 0.055;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform bool strong_preset = false;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float2 rotate2d(float2 p, float a)
{
    float s = sin(a);
    float c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float n)
{
    return frac(sin(n * 113.13) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float preset = strong_preset ? 3.2 : 1.0;
    float t = elapsed_time * speed;
    float pulse = pow(saturate(sin(t * 2.1) * 0.5 + 0.5), 18.0);
    // Wrap the frame index so the hash does not go flat on a long stream.
    float frame = fmod(floor(t * 18.0), 1024.0);
    float2 twitch = (float2(hash11(frame), hash11(frame + 9.0)) - 0.5) * 0.028 * pulse * amount * preset;
    float angle = (hash11(frame + 23.0) - 0.5) * 0.045 * pulse * amount * preset;

    float2 center = float2(center_x, center_y);
    float zoom = 1.0 + max(0.0, zoom_compensation) + length(twitch) * 2.5 + abs(angle) * 1.5;
    // Height fractions so the twitch roll stays circular on a wide frame.
    float aspect = max(uv_size.x / max(uv_size.y, 1.0), 0.001);
    float2 p = (v_in.uv - center) / max(zoom, 0.001);
    p.x *= aspect;
    p = rotate2d(p, angle);
    p.x /= max(aspect, 0.001);
    float2 uv = center + p - twitch;
    return image.Sample(textureSampler, clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0)));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
