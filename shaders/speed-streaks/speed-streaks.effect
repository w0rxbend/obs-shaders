// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Radial zoom-blur from center simulating speed burst or fast movement
// Chain order: mid — before color grading, after base video

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float streak_amount = 0.04; // 0.0–0.1
uniform float center_x      = 0.5;  // 0.0–1.0
uniform float center_y      = 0.5;  // 0.0–1.0

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv     = v_in.uv;
    float2 center = float2(center_x, center_y);
    float2 dir    = uv - center;

    // 8-tap radial accumulation along the outward direction
    float4 acc = float4(0.0, 0.0, 0.0, 0.0);
    int SAMPLES = 8;
    for (int i = 0; i < SAMPLES; i++)
    {
        float t        = float(i) / float(SAMPLES - 1); // 0..1
        float scale    = 1.0 - streak_amount * t;       // zoom in toward center
        float2 sample_uv = clamp(center + dir * scale, 0.0, 1.0);
        acc += image.Sample(textureSampler, sample_uv);
    }
    acc /= float(SAMPLES);

    return acc;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
