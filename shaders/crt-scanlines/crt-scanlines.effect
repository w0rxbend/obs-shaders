// C9 — crt-scanlines
// CRT monitor effect: scanlines, barrel curvature, phosphor RGB mask.

uniform float line_width <
    string label = "Line width";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;
uniform float darkness <
    string label = "Darkness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;
uniform float curvature <
    string label = "Curvature";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.1;
uniform bool rgb_mask = true;

uniform texture2d image;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// Barrel in pixel aspect so the tube stays round on wide frames.
float2 CRTCurve(float2 uv, float amount)
{
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = uv - 0.5;
    p.x *= aspect;
    float dist = dot(p, p);
    p = p + p * dist * amount;
    p.x /= max(aspect, 0.001);
    return p + 0.5;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // 4 maps the 0–0.3 slider onto the barrel polynomial.
    uv = CRTCurve(uv, curvature * 4.0);

    float4 col = image.Sample(textureSampler, uv);

    // Outside the tube is black. Keep the clamped edge sample's alpha.
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0)
        return float4(0.0, 0.0, 0.0, col.a);

    // One dark gap per line_width * 2 source rows.
    float lineFreq = max(uv_size.y, 1.0) / max(line_width * 2.0, 0.001);
    float scanPos = frac(uv.y * lineFreq);
    float scanMask = smoothstep(0.0, 0.25, scanPos) * (1.0 - smoothstep(0.50, 0.75, scanPos));
    float scanDark = lerp(1.0, scanMask, darkness);
    col.rgb *= scanDark;

    if (rgb_mask)
    {
        float pixelX = floor(uv.x * max(uv_size.x, 1.0));
        float subPix = pixelX - floor(pixelX / max(3.0, 0.001)) * 3.0;

        float3 mask;
        mask.r = step(abs(subPix - 0.0), 0.5);
        mask.g = step(abs(subPix - 1.0), 0.5);
        mask.b = step(abs(subPix - 2.0), 0.5);

        col.rgb = col.rgb * lerp(float3(1.0, 1.0, 1.0), mask * 1.5, 0.25);
    }

    float2 vignUv = uv - 0.5;
    float vignDist = dot(vignUv, vignUv);
    float vign = 1.0 - smoothstep(0.18, 0.55, vignDist * 3.5);
    col.rgb *= lerp(1.0, vign, 0.35);

    return float4(saturate(col.rgb), col.a);
}
