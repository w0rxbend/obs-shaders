// G5 — cinematic-letterbox
// Performance: low
// Webcam safe: yes
// Preserves alpha: no (bars are opaque)
// Use case: Adds solid black letterbox bars top and bottom with optional vignette
// Chain order: Apply last in chain; stacks well over any color grade

uniform float bar_height       = 0.12; // 0.0 – 0.4
uniform float vignette_strength = 0.3; // 0.0 – 1.0
uniform float bar_color_r      = 0.0;
uniform float bar_color_g      = 0.0;
uniform float bar_color_b      = 0.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float3 bar_col = float3(bar_color_r, bar_color_g, bar_color_b);

    // Determine if this pixel is inside a letterbox bar.
    float h = clamp(bar_height, 0.0, 0.49);
    bool  in_bar = (uv.y < h) || (uv.y > (1.0 - h));

    if (in_bar)
    {
        return float4(bar_col, 1.0);
    }

    // Vignette on the visible region only.
    // Re-map UV into the visible strip [h, 1-h] -> [0, 1].
    float strip_h = 1.0 - 2.0 * h;
    float vy      = (uv.y - h) / max(strip_h, 0.001);

    float2 centered = float2(uv.x - 0.5, vy - 0.5);
    float  dist     = length(centered);
    float  vignette = smoothstep(0.3, 0.85, dist) * vignette_strength;

    col.rgb *= (1.0 - vignette);
    col.a    = 1.0;
    return col;
}
