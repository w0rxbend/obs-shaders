// G5 — cinematic-letterbox
// Performance: low
// Webcam safe: yes
// Preserves alpha: no (bars are opaque)
// Use case: Adds solid black letterbox bars top and bottom with optional vignette
// Chain order: Apply last in chain; stacks well over any color grade

uniform float bar_height <
    string label = "Bar height";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.4;
    float step = 0.01;
> = 0.12;

uniform float vignette_strength <
    string label = "Vignette";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.3;

uniform float bar_color_r <
    string label = "Bar red";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float bar_color_g <
    string label = "Bar green";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float bar_color_b <
    string label = "Bar blue";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float3 bar_col = saturate(float3(bar_color_r, bar_color_g, bar_color_b));

    // Cap below 0.5 so the two bars cannot meet and black out the frame.
    float h = clamp(bar_height, 0.0, 0.49);
    bool  in_bar = (uv.y < h) || (uv.y > (1.0 - h));

    if (in_bar)
    {
        return float4(bar_col, 1.0);
    }

    // Vignette on the visible region only.
    // Re-map UV into the visible strip [h, 1-h] -> [0, 1].
    float strip_h = 1.0 - 2.0 * h;
    float vy      = (uv.y - h) / max(strip_h, 0.001);

    float2 centered = float2(uv.x - 0.5, vy - 0.5);
    float  dist     = length(centered);
    float  vignette = smoothstep(0.3, 0.85, dist) * saturate(vignette_strength);

    col.rgb = saturate(col.rgb * (1.0 - vignette));
    return col;
}
