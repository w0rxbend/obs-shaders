// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Desaturation with red preservation for low-health game state
// Chain order: early — before bloom or vignette effects

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float elapsed_time;
uniform float desat_amount  = 0.85; // 0.0–1.0
uniform float red_preserve  = 0.6;  // 0.0–1.0
uniform float pulse_speed   = 0.8;  // 0.0–3.0

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Luminance
    float luma = dot(col.rgb, float3(0.299, 0.587, 0.114));
    float3 gray = float3(luma, luma, luma);

    // Desaturate then re-inject red channel partially
    float3 desat = lerp(col.rgb, gray, desat_amount);
    desat.r = lerp(desat.r, col.r, red_preserve);

    // Dark pulsing vignette
    float2 centered = uv - 0.5;
    float  dist     = length(centered);
    float  vignette = 1.0 - smoothstep(0.35, 0.75, dist);
    float  pulse    = 0.75 + 0.25 * sin(elapsed_time * pulse_speed);
    float  shadow   = vignette * pulse;

    // Darken edges
    float3 result = desat * lerp(0.45, 1.0, shadow);

    return float4(result, col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
