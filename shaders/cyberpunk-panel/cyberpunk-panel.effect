// Inset HUD panel. Dark bezel, cyan-magenta corner brackets, slow scan.
// Source UV stays put so a talking head does not slide.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float inset <
    string label = "Inset";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.25;
    float step = 0.001;
> = 0.07;

uniform float bezel <
    string label = "Bezel";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.88;

uniform float brackets <
    string label = "Brackets";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.85;

uniform float scan <
    string label = "Scan";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

uniform float tint <
    string label = "Tint";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.2;

uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float ArmMask(float2 p, float2 a, float2 b)
{
    float2 ab = b - a;
    float denom = max(dot(ab, ab), 0.001);
    float t = saturate(dot(p - a, ab) / denom);
    float dist = length(p - (a + ab * t));
    float core = 1.0 - saturate(dist / max(0.0028, 0.001));
    float glow = 1.0 - saturate(dist / max(0.012, 0.001));
    return saturate(core + glow * glow * 0.5);
}

float CornerMask(float2 p, float2 corner, float2 dir)
{
    float horizontal = ArmMask(p, corner, corner + float2(dir.x, 0.0));
    float vertical = ArmMask(p, corner, corner + float2(0.0, dir.y));
    return max(horizontal, vertical);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 suv = float2(uv.x * aspect, uv.y);

    float edgeMin = min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y));
    float soft = 0.008;
    float bezelMask = 1.0 - saturate((edgeMin - (inset - soft)) / max(soft, 0.001));
    float panel = 1.0 - bezelMask;

    float luma = dot(col.rgb, float3(0.299, 0.587, 0.114));
    float3 cyanSide = col.rgb * float3(0.88, 1.03, 1.08);
    float3 magSide = col.rgb * float3(1.06, 0.92, 1.02);
    float3 split = lerp(cyanSide, magSide, luma);
    float3 graded = saturate(lerp(col.rgb, split, tint * panel));

    float3 rgb = lerp(graded, float3(0.01, 0.016, 0.028), bezelMask * bezel);

    float hair = 1.0 - saturate(abs(edgeMin - inset) / max(0.0018, 0.001));
    rgb += float3(0.25, 0.75, 0.9) * hair * bezel * 0.45;

    float arm = 0.082;
    float x0 = inset * aspect;
    float x1 = (1.0 - inset) * aspect;
    float y0 = inset;
    float y1 = 1.0 - inset;

    float tlMask = CornerMask(suv, float2(x0, y0), float2(arm, arm));
    float trMask = CornerMask(suv, float2(x1, y0), float2(-arm, arm));
    float blMask = CornerMask(suv, float2(x0, y1), float2(arm, -arm));
    float brMask = CornerMask(suv, float2(x1, y1), float2(-arm, -arm));

    float breathe = 0.9 + 0.1 * sin(elapsed_time * 1.3);
    float bracketAmt = brackets * breathe;
    rgb += float3(0.15, 0.95, 1.0) * tlMask * bracketAmt;
    rgb += float3(1.0, 0.16, 0.76) * trMask * bracketAmt;
    rgb += float3(1.0, 0.16, 0.76) * blMask * bracketAmt;
    rgb += float3(0.15, 0.95, 1.0) * brMask * bracketAmt;

    float sweep = frac(elapsed_time * 0.14);
    float scanY = lerp(y0, y1, sweep);
    float band = 1.0 - saturate(abs(uv.y - scanY) / max(0.008, 0.001));
    float dy = scanY - uv.y;
    float trail = saturate(1.0 - dy / max(0.06, 0.001)) * step(0.0, dy);
    float scanAmt = (band * 0.55 + trail * 0.16) * panel * scan;
    rgb += float3(0.2, 0.9, 1.0) * scanAmt;

    float line = sin(uv.y * max(uv_size.y, 1.0) * 0.42);
    float lineMask = line * 0.5 + 0.5;
    rgb = lerp(rgb, rgb * 0.94, lineMask * 0.08 * panel);

    rgb = saturate(rgb);
    return float4(rgb, col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
