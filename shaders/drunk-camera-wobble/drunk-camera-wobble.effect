// Drunk Camera Wobble
// Slow uneven wobble with mild lens-like bend.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;

uniform float speed = 0.75;
uniform float amount = 1.0;
uniform float zoom_compensation = 0.055;
uniform float center_x = 0.5;
uniform float center_y = 0.5;
uniform bool strong_preset = false;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv;
    return vert_out;
}

float2 rotate2d(float2 p, float a)
{
    float s = sin(a);
    float c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float4 mainImage(VertData v_in) : TARGET
{
    float t = elapsed_time * speed;
    float preset = strong_preset ? 3.0 : 1.0;
    float2 center = float2(center_x, center_y);
    float angle = (sin(t) * 0.028 + sin(t * 1.71 + 2.0) * 0.015) * amount * preset;
    float2 offset = float2(sin(t * 0.63 + 1.2), sin(t * 0.47)) * 0.012 * amount * preset;
    float zoom = 1.0 + max(0.0, zoom_compensation) + abs(angle) * 1.2 + length(offset) * 2.0;

    float2 p = (v_in.uv - center) / zoom;
    p += p * dot(p, p) * sin(t * 1.3) * 0.035 * amount * preset;
    float2 uv = center + rotate2d(p, angle) - offset;
    return image.Sample(textureSampler, clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0)));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
