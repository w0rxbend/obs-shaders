// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Rippling energy shield — multiple concentric animated wave distortions with blue-white highlights on peaks
// Chain order: Apply before any color grading; pair with glow-bloom after for energy glow effect

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float elapsed_time;
uniform float wave_count     = 3.0;   // 1.0–5.0
uniform float wave_speed     = 2.0;   // 0.5–5.0
uniform float distortion     = 0.012; // 0.0–0.03
uniform float tint_strength  = 0.2;   // 0.0–0.5

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    // Map uv to centered coordinates
    float2 centered = uv - 0.5;
    float  dist     = length(centered);

    // --- Multiple concentric wave distortions ---
    float2 disp = float2(0.0, 0.0);
    float  peak_sum = 0.0;

    for (float i = 0.0; i < 5.0; i++)
    {
        if (i >= wave_count) break;

        float freq   = 8.0 + i * 5.5;
        float speed  = wave_speed * (1.0 + i * 0.3);
        float phase  = dist * freq - elapsed_time * speed + i * 1.256;
        float wave   = sin(phase);

        // Displacement direction: radially outward
        float2 dir = (dist > 0.001) ? (centered / dist) : float2(0.0, 1.0);
        disp      += dir * wave * distortion / (i + 1.0);

        // Track wave peaks for tinting
        peak_sum  += saturate(wave * 0.5 + 0.5);
    }

    peak_sum /= wave_count;

    // --- Sample distorted image ---
    float2 warped_uv = clamp(uv + disp, 0.0, 1.0);
    float4 src       = image.Sample(textureSampler, warped_uv);

    // --- Blue-white tint on wave peaks ---
    // Peak tint: blend toward blue-white
    float3 shield_color = float3(0.6, 0.85, 1.0);
    float3 col = src.rgb + shield_color * peak_sum * tint_strength;

    // Slight overall blue-cyan wash
    float luma = dot(col, float3(0.299, 0.587, 0.114));
    float3 blue_wash = float3(luma * 0.85, luma * 0.95, luma * 1.15);
    col = lerp(col, blue_wash, tint_strength * 0.4);

    col = saturate(col);

    return float4(col, src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
