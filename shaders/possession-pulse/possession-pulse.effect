// D8 — possession-pulse
// Animated pulsing desaturation with red flash.
// Pulses between normal and demonic at pulse_speed Hz.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float    elapsed_time;

uniform float pulse_speed = 0.8;
uniform float intensity   = 0.7;
uniform float red_shift   = 0.4;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);
    float3 rgb = col.rgb;

    float luma = dot(rgb, float3(0.299, 0.587, 0.114));

    // Pulse: smoothed sine wave 0..1
    // Using abs(sin) so the wave spends more time near 0 (normal) and
    // briefly spikes to 1 (demonic) for a "flash" feel.
    float rawSine   = sin(elapsed_time * pulse_speed * 3.14159);
    float pulse     = pow(saturate(rawSine), 2.0); // sharpen peak

    // Demonic target: desaturate + boost red + crush shadows
    float3 grey        = float3(luma, luma, luma);
    float  shadowCrush = smoothstep(0.0, 0.4, luma);
    float3 demonicRed  = float3(
        saturate(luma * shadowCrush + red_shift * (1.0 - shadowCrush) * 0.5),
        luma * shadowCrush * 0.4,
        luma * shadowCrush * 0.3
    );

    // Blend: base -> desaturated -> demonic based on pulse
    float3 desat  = lerp(rgb, grey, intensity * 0.5);
    float3 demonic = lerp(desat, demonicRed, pulse * intensity);

    return float4(saturate(demonic), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
