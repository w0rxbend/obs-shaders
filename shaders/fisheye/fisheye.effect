// B1 — fisheye
// Fisheye lens barrel warp toward center.
// strength : warp intensity  (0.0–1.0, default 0.5)
// zoom     : overall zoom factor (0.5–2.0, default 1.0)

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float zoom <
    string label = "Zoom";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform texture2d image;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Center in [-1, 1] and stretch x so the lens stays circular on screen.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = uv * 2.0 - 1.0;
    p.x *= aspect;

    // r' = r * (1 + strength * r^2), applied to the offset. No r divide.
    float r2 = dot(p, p);
    float2 pWarp = p * (1.0 + strength * r2);
    pWarp.x /= max(aspect, 0.001);

    // Larger zoom samples closer to center. Guard a zero slider value.
    float2 uvWarp = (pWarp / max(zoom, 0.001) + 1.0) * 0.5;
    uvWarp = saturate(uvWarp);

    return image.Sample(textureSampler, uvWarp);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
