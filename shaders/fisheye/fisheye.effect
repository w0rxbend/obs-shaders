// B1 — fisheye
// Fisheye lens barrel warp toward center.
// strength : warp intensity  (0.0–1.0, default 0.5)
// zoom     : overall zoom factor (0.5–2.0, default 1.0)

uniform float strength = 0.5;
uniform float zoom     = 1.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Map uv to centered [-1, 1] space
    float2 p = uv * 2.0 - 1.0;

    float r = length(p);

    // Fisheye: r' = r * (1 + strength * r^2)
    float r2      = r * r;
    float rWarp   = r * (1.0 + strength * r2);

    // Apply zoom then remap back: scale the warped direction by rWarp
    float2 pWarp  = (r > 0.0001) ? (p / r) * rWarp : p;

    // Apply zoom (larger zoom = more zoomed in, showing less border black)
    float2 uvWarp = (pWarp / zoom + 1.0) * 0.5;

    // Clamp to valid range — OBS returns black outside [0,1]
    uvWarp = saturate(uvWarp);

    return image.Sample(textureSampler, uvWarp);
}
