// P1 — rain-on-glass
// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Rain droplets on camera lens — UV distortion blobs moving down, refracting image underneath.
// Chain order: Apply early in the chain before colour grades

uniform float4x4 ViewProj;
uniform float rain_density  = 0.5;  // 0.0–1.0
uniform float drop_speed    = 0.8;  // 0.1–3.0
uniform float refraction    = 0.02; // 0.0–0.05
uniform float blur_amount   = 0.004;// 0.0–0.01

uniform float elapsed_time;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

// 2D hash
float hash11(float p)
{
    return frac(sin(p * 127.1) * 43758.5453);
}

float hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

// Soft droplet SDF — returns [0,1] where 1 = centre of drop
float dropSDF(float2 uv, float2 centre, float radius)
{
    float2 d = uv - centre;
    // Squash vertically so drops are taller than wide
    d.y *= 0.6;
    float r = length(d);
    return 1.0 - smoothstep(0.0, radius, r);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float2 refract_dir = float2(0.0, 0.0);
    float  totalWeight = 0.0;

    float activeDrops = 2.0 + rain_density * 6.0;
    float t = elapsed_time * drop_speed;

    float seed0 = hash21(float2(0.0, 3.0));
    float2 c0 = float2(frac(seed0 * 7.17), frac(t * (0.55 + seed0 * 0.45) + seed0));
    float w0 = dropSDF(uv, c0, 0.012 + seed0 * 0.018) * saturate(activeDrops - 0.0);
    refract_dir += normalize(uv - c0 + float2(0.0001, 0.0001)) * w0;
    totalWeight += w0;

    float seed1 = hash21(float2(1.0, 5.0));
    float2 c1 = float2(frac(seed1 * 9.31), frac(t * (0.55 + seed1 * 0.45) + seed1));
    float w1 = dropSDF(uv, c1, 0.012 + seed1 * 0.018) * saturate(activeDrops - 1.0);
    refract_dir += normalize(uv - c1 + float2(0.0001, 0.0001)) * w1;
    totalWeight += w1;

    float seed2 = hash21(float2(2.0, 7.0));
    float2 c2 = float2(frac(seed2 * 11.13), frac(t * (0.55 + seed2 * 0.45) + seed2));
    float w2 = dropSDF(uv, c2, 0.012 + seed2 * 0.018) * saturate(activeDrops - 2.0);
    refract_dir += normalize(uv - c2 + float2(0.0001, 0.0001)) * w2;
    totalWeight += w2;

    float seed3 = hash21(float2(3.0, 11.0));
    float2 c3 = float2(frac(seed3 * 13.71), frac(t * (0.55 + seed3 * 0.45) + seed3));
    float w3 = dropSDF(uv, c3, 0.012 + seed3 * 0.018) * saturate(activeDrops - 3.0);
    refract_dir += normalize(uv - c3 + float2(0.0001, 0.0001)) * w3;
    totalWeight += w3;

    float seed4 = hash21(float2(4.0, 13.0));
    float2 c4 = float2(frac(seed4 * 15.23), frac(t * (0.55 + seed4 * 0.45) + seed4));
    float w4 = dropSDF(uv, c4, 0.012 + seed4 * 0.018) * saturate(activeDrops - 4.0);
    refract_dir += normalize(uv - c4 + float2(0.0001, 0.0001)) * w4;
    totalWeight += w4;

    float seed5 = hash21(float2(5.0, 17.0));
    float2 c5 = float2(frac(seed5 * 17.41), frac(t * (0.55 + seed5 * 0.45) + seed5));
    float w5 = dropSDF(uv, c5, 0.012 + seed5 * 0.018) * saturate(activeDrops - 5.0);
    refract_dir += normalize(uv - c5 + float2(0.0001, 0.0001)) * w5;
    totalWeight += w5;

    float seed6 = hash21(float2(6.0, 19.0));
    float2 c6 = float2(frac(seed6 * 19.19), frac(t * (0.55 + seed6 * 0.45) + seed6));
    float w6 = dropSDF(uv, c6, 0.012 + seed6 * 0.018) * saturate(activeDrops - 6.0);
    refract_dir += normalize(uv - c6 + float2(0.0001, 0.0001)) * w6;
    totalWeight += w6;

    float seed7 = hash21(float2(7.0, 23.0));
    float2 c7 = float2(frac(seed7 * 23.07), frac(t * (0.55 + seed7 * 0.45) + seed7));
    float w7 = dropSDF(uv, c7, 0.012 + seed7 * 0.018) * saturate(activeDrops - 7.0);
    refract_dir += normalize(uv - c7 + float2(0.0001, 0.0001)) * w7;
    totalWeight += w7;

    // Normalise and scale refraction
    float2 warpUV = uv;
    if (totalWeight > 0.0)
    {
        float2 avgDir = refract_dir / totalWeight;
        warpUV += avgDir * refraction * totalWeight;
    }
    warpUV = saturate(warpUV);

    // Soft blur under drops (sample 4 taps)
    float blurR = blur_amount * saturate(totalWeight);
    float4 col  = image.Sample(textureSampler, warpUV);
    col += image.Sample(textureSampler, saturate(warpUV + float2( blurR,  0.0)));
    col += image.Sample(textureSampler, saturate(warpUV + float2(-blurR,  0.0)));
    col += image.Sample(textureSampler, saturate(warpUV + float2( 0.0,  blurR)));
    col /= 4.0;

    // Slight brightness boost where drops are (glass lensing)
    float dropGlow = saturate(totalWeight * 0.5);
    col.rgb = lerp(col.rgb, col.rgb * 1.15, dropGlow);

    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
