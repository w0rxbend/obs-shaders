// P1 — rain-on-glass
// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Rain droplets on camera lens — UV distortion blobs moving down, refracting image underneath.
// Chain order: Apply early in the chain before colour grades

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float elapsed_time;

uniform float rain_density <
    string label = "Rain Density";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float drop_speed <
    string label = "Drop Speed";
    string widget_type = "slider";
    float minimum = 0.1;
    float maximum = 3.0;
    float step = 0.01;
> = 0.8;

uniform float refraction <
    string label = "Refraction";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.02;

uniform float blur_amount <
    string label = "Blur Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.01;
    float step = 0.001;
> = 0.004;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    // Below 1 stretches the drop taller than wide after aspect correction.
    float verticalSquash = 0.6;
    float activeDrops = 2.0 + rain_density * 6.0;
    // UV y grows downward, so this clock walks drops down the glass.
    float fall = elapsed_time * drop_speed;

    float2 refractDir = float2(0.0, 0.0);
    float totalWeight = 0.0;

    for (int dropIndex = 0; dropIndex < 8; dropIndex++)
    {
        float index = float(dropIndex);
        float seed = hash21(float2(index, 3.0 + index * 2.0));
        float2 centre = float2(
            frac(seed * (7.17 + index)),
            frac(fall * (0.55 + seed * 0.45) + seed));
        float2 delta = uv - centre;
        float2 scaled = float2(delta.x * aspect, delta.y * verticalSquash);
        float radius = 0.012 + seed * 0.018;
        float weight = (1.0 - smoothstep(0.0, radius, length(scaled))) * saturate(activeDrops - index);
        refractDir += delta / max(length(delta), 0.001) * weight;
        totalWeight += weight;
    }

    float2 warpUV = saturate(uv + refractDir * refraction);
    float blurR = blur_amount * saturate(totalWeight);
    float2 blurX = float2(blurR / max(aspect, 0.001), 0.0);
    float2 blurY = float2(0.0, blurR);

    float4 src = image.Sample(textureSampler, warpUV);
    float3 rgb = src.rgb;
    rgb += image.Sample(textureSampler, saturate(warpUV + blurX)).rgb;
    rgb += image.Sample(textureSampler, saturate(warpUV - blurX)).rgb;
    rgb += image.Sample(textureSampler, saturate(warpUV + blurY)).rgb;
    rgb += image.Sample(textureSampler, saturate(warpUV - blurY)).rgb;
    rgb /= 5.0;

    float dropGlow = saturate(totalWeight * 0.5);
    rgb = lerp(rgb, rgb * 1.15, dropGlow);
    return float4(saturate(rgb), src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
