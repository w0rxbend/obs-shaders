// cloud-shadow
// Slow procedural clouds cast soft cool shadows. Daylight dims in patches.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float coverage <
    string label = "Coverage";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.48;

uniform float shadow <
    string label = "Shadow";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.55;
    float step = 0.01;
> = 0.28;

uniform float cool <
    string label = "Cool";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float scale <
    string label = "Scale";
    string widget_type = "slider";
    float minimum = 0.4;
    float maximum = 3.0;
    float step = 0.01;
> = 1.35;

uniform float drift <
    string label = "Drift";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.18;

uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float ValueNoise(float2 p)
{
    float2 cell = floor(p);
    float2 blend = frac(p);
    float2 curve = blend * blend * (3.0 - 2.0 * blend);
    float a = Hash21(cell);
    float b = Hash21(cell + float2(1.0, 0.0));
    float c = Hash21(cell + float2(0.0, 1.0));
    float d = Hash21(cell + float2(1.0, 1.0));
    return lerp(lerp(a, b, curve.x), lerp(c, d, curve.x), curve.y);
}

float Billow(float2 p)
{
    float n = ValueNoise(p);
    return 1.0 - abs(n * 2.0 - 1.0);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float freq = 1.0 / max(scale, 0.001);
    float t = elapsed_time * drift;
    float2 plane = float2(uv.x * aspect, uv.y) * freq;
    float2 wind = float2(t * 0.22, t * 0.06);

    float bank = Billow(plane * 0.85 + wind);
    float puff = Billow(plane * 1.75 + float2(8.2, 3.4) + wind * 1.4);
    float wisp = ValueNoise(plane * 3.4 + float2(t * 0.16, -t * 0.04));
    float mass = saturate(bank * 0.62 + puff * 0.26 + wisp * 0.12);

    float edge = lerp(0.66, 0.36, coverage);
    float cover = saturate((mass - edge) / max(0.2, 0.001));
    cover = cover * cover * (3.0 - 2.0 * cover);

    float dim = 1.0 - cover * shadow;
    float3 shaded = col.rgb * dim;
    float luma = dot(shaded, float3(0.299, 0.587, 0.114));
    float3 grade = float3(luma * 0.82, luma * 0.93, luma * 1.06);
    float3 result = lerp(shaded, grade, cover * cool * 0.55);

    return float4(saturate(result), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
