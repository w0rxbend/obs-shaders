// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: VHS channel-change transition — horizontal noise wipe with chroma aberration
// Chain order: Apply last; stack after vhs-tracking for full VHS stack

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;

uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float progress <
    string label = "Progress";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.25; // 0.0 = clean signal, 1.0 = fully wiped to static

uniform float noise_strength <
    string label = "Noise Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.3; // 0.0–0.5 intensity of static noise bands

uniform float chroma <
    string label = "Chroma";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.03;
    float step = 0.001;
> = 0.012; // 0.0–0.03 chromatic separation amount

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash1(float n)
{
    return frac(sin(n * 127.1) * 43758.5453);
}

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float amount = saturate(progress);
    float noiseAmt = max(noise_strength, 0.0);
    float split = max(chroma, 0.0) * amount * 2.0;

    float4 source = image.Sample(textureSampler, uv);
    float red = image.Sample(textureSampler, clamp(uv + float2(-split, 0.0), 0.0, 1.0)).r;
    float blue = image.Sample(textureSampler, clamp(uv + float2(split, 0.0), 0.0, 1.0)).b;
    float3 signal = float3(red, source.g, blue);

    float bandSeed = hash1(floor(amount * 37.0));
    float bandY = frac(uv.y * 12.0 + bandSeed + elapsed_time * 0.35);
    float grain = hash2(uv * float2(213.7, 97.3) + float2(elapsed_time * 9.0, bandSeed));
    float bandMask = smoothstep(0.55, 0.65, bandY) * noiseAmt * amount * 2.0;
    signal = lerp(signal, float3(grain, grain, grain), saturate(bandMask));

    // Jag only while the wipe is partial, so 0 stays clean and 1 stays full static.
    float partial = saturate(amount * (1.0 - amount) * 4.0);
    float noiseOff = (hash1(floor(uv.y * 80.0)) - 0.5) * noiseAmt * 0.25 * partial;
    float edgeY = lerp(-0.02, 1.02, amount) + noiseOff;
    float wipe = saturate(1.0 - smoothstep(edgeY - 0.02, edgeY + 0.02, uv.y));

    float snow = hash2(float2(floor(uv.x * 180.0), floor(uv.y * 90.0)) + float2(elapsed_time * 11.0, bandSeed));
    signal = lerp(signal, float3(snow, snow, snow), wipe);

    return float4(saturate(signal), source.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
