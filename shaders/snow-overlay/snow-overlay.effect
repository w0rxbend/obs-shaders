// P2 — snow-overlay
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Falling white snow particles overlaid on the source image.
// Chain order: Apply after colour grade, before vignette

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;
uniform float elapsed_time;

uniform float density <
    string label = "Density";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float size <
    string label = "Size";
    string widget_type = "slider";
    float minimum = 0.001;
    float maximum = 0.01;
    float step = 0.001;
> = 0.004;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.1;
    float maximum = 3.0;
    float step = 0.01;
> = 0.5;

uniform float wind <
    string label = "Wind";
    string widget_type = "slider";
    float minimum = -0.5;
    float maximum = 0.5;
    float step = 0.01;
> = 0.1;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.8;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float snowFlake(float2 uv, float2 centre, float r)
{
    float d = length(uv - centre);
    return 1.0 - smoothstep(0.0, r, d);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Sample original image
    float4 col = image.Sample(textureSampler, uv);

    float t = elapsed_time * speed;
    float densityGate = 0.995 - density * 0.18;
    // Cell grid is square in pixels, or flakes stretch on wide frames.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 field = float2(uv.x * aspect, uv.y);

    float2 layer1 = field * 28.0 + float2(wind * t * 0.7, t * 0.60);
    float2 cell1 = floor(layer1);
    float2 frac1 = frac(layer1);
    float rnd1 = hash21(cell1);
    float2 pos1 = float2(hash21(cell1 + 1.7), hash21(cell1 + 7.3));
    float snow1 = snowFlake(frac1, pos1, size * 28.0 * (0.7 + rnd1)) * step(densityGate, rnd1);

    float2 layer2 = field * 18.0 + float2(wind * t * 0.5 + 4.2, t * 0.42);
    float2 cell2 = floor(layer2);
    float2 frac2 = frac(layer2);
    float rnd2 = hash21(cell2 + 12.1);
    float2 pos2 = float2(hash21(cell2 + 3.9), hash21(cell2 + 9.4));
    float snow2 = snowFlake(frac2, pos2, size * 18.0 * (1.0 + rnd2)) * step(densityGate, rnd2);

    float2 layer3 = field * 42.0 + float2(wind * t + 8.3, t * 0.95);
    float2 cell3 = floor(layer3);
    float2 frac3 = frac(layer3);
    float rnd3 = hash21(cell3 + 29.7);
    float2 pos3 = float2(hash21(cell3 + 5.2), hash21(cell3 + 14.8));
    float snow3 = snowFlake(frac3, pos3, size * 42.0 * (0.45 + rnd3 * 0.7)) * step(densityGate, rnd3);

    float snowAcc  = snow1 + snow2 + snow3;

    snowAcc = saturate(snowAcc);

    // Composite white snow over source
    float3 snowCol = float3(1.0, 1.0, 1.0);
    col.rgb = saturate(lerp(col.rgb, snowCol, snowAcc * opacity));

    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
