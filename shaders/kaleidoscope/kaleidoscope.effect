// N1 — kaleidoscope
// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Mirror image into N symmetrical segments radiating from center
// Chain order: Apply before color grading; after geometry corrections

uniform float4x4 ViewProj;
uniform int   segments = 6;       // 2–16
uniform float rotation = 0.0;     // 0.0–6.2832
uniform float zoom     = 1.0;     // 0.1–3.0

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

static const float PI  = 3.14159265358979;
static const float TAU = 6.28318530717959;

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Move origin to center
    float2 p = uv - 0.5;

    // Apply zoom (scale toward center)
    p /= max(zoom, 0.0001);

    // Convert to polar coordinates
    float r     = length(p);
    float angle = atan2(p.y, p.x) + rotation;

    // Slice angle into segments
    int   segs      = clamp(segments, 2, 16);
    float sliceAngle = TAU / float(segs);

    // Wrap angle into [0, sliceAngle)
    angle = fmod(angle, sliceAngle);
    if (angle < 0.0)
        angle += sliceAngle;

    // Mirror within the slice (fold second half back)
    float halfSlice = sliceAngle * 0.5;
    if (angle > halfSlice)
        angle = sliceAngle - angle;

    // Convert back to Cartesian
    float2 q;
    q.x = r * cos(angle);
    q.y = r * sin(angle);

    // Back to UV space
    float2 sampleUV = q + 0.5;

    // Clamp to valid range
    sampleUV = clamp(sampleUV, 0.0, 1.0);

    return image.Sample(textureSampler, sampleUV);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
