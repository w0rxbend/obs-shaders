// N1 — kaleidoscope
// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Mirror image into N symmetrical segments radiating from center
// Chain order: Apply before color grading; after geometry corrections

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform int segments <
    string label = "Segments";
    string widget_type = "slider";
    int minimum = 2;
    int maximum = 16;
    int step = 1;
> = 6;

uniform float rotation <
    string label = "Rotation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 6.2832;
    float step = 0.01;
> = 0.0;

uniform float zoom <
    string label = "Zoom";
    string widget_type = "slider";
    float minimum = 0.1;
    float maximum = 3.0;
    float step = 0.01;
> = 1.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

static const float TAU = 6.28318530717959;

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Pixel aspect, so wedge angles stay equal on widescreen.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = uv - 0.5;
    p.x *= aspect;
    p /= max(zoom, 0.001);

    float r = length(p);
    float angle = atan2(p.y, p.x) + rotation;

    int segs = clamp(segments, 2, 16);
    float slice_angle = TAU / max((float)segs, 0.001);

    // fmod keeps the sign of the angle, so a negative result is still outside the slice.
    angle = fmod(angle, slice_angle);
    if (angle < 0.0)
        angle += slice_angle;

    float half_slice = slice_angle * 0.5;
    if (angle > half_slice)
        angle = slice_angle - angle;

    float2 folded;
    folded.x = r * cos(angle);
    folded.y = r * sin(angle);
    folded.x /= max(aspect, 0.001);

    float2 sample_uv = clamp(folded + 0.5, 0.0, 1.0);
    return image.Sample(textureSampler, sample_uv);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
