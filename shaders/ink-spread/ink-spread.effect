// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Ink blot spreads from center, revealing image in organic blob shape
// Chain order: Apply last; combine with watercolor-wash or pencil-sketch before

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float progress <
    string label = "Progress";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float ink_scale <
    string label = "Ink Scale";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 5.0;
    float step = 0.01;
> = 2.0;

uniform float softness <
    string label = "Softness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.1;
    float step = 0.001;
> = 0.03;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float noise2d(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    float a  = hash2(i + float2(0.0, 0.0));
    float b  = hash2(i + float2(1.0, 0.0));
    float c  = hash2(i + float2(0.0, 1.0));
    float d  = hash2(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float fbm(float2 p)
{
    float v = 0.0;
    v += 0.50 * noise2d(p);
    v += 0.30 * noise2d(p * 2.3 + float2(1.7, 9.2));
    v += 0.15 * noise2d(p * 5.1 + float2(8.3, 2.8));
    v += 0.05 * noise2d(p * 11.0 + float2(4.1, 6.7));
    return v;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);

    // Height units keep the blot round on widescreen.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(0.5, 0.5)) * float2(aspect, 1.0);
    float dist = length(from_center);

    float n = fbm(from_center * ink_scale + float2(2.3, 5.7));
    float cover = 0.5 * length(float2(aspect, 1.0));
    // Extra radius so progress 1 clears noise and the soft edge.
    float blob_radius = progress * (cover + 0.25);
    float edge = max(softness, 0.001);
    float wobble = (n - 0.5) * 0.22 * saturate(progress);
    float reach = blob_radius + wobble;
    float reveal = 1.0 - smoothstep(reach - edge, reach + edge, dist);

    float3 ink = float3(0.02, 0.015, 0.03);
    float3 rgb = saturate(lerp(ink, color.rgb, reveal));
    return float4(rgb, color.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
