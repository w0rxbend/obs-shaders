// C5 — film-grain
// Animated film grain overlay, optionally colored.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.12;

uniform float size <
    string label = "Size";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 4.0;
    float step = 0.01;
> = 1.0;

uniform bool colored = false;

uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

// Square cells in source pixels. size is the clump size in pixels.
float Grain(float2 uv, float seed)
{
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float cellsY = max(uv_size.y, 1.0) / max(size, 0.001);
    float2 scaled = uv * float2(cellsY * aspect, cellsY);
    float2 i = floor(scaled);
    float2 f = frac(scaled);

    float a = Hash21(i + float2(seed, 0.0));
    float b = Hash21(i + float2(1.0 + seed, 0.0));
    float c = Hash21(i + float2(seed, 1.0));
    float d = Hash21(i + float2(1.0 + seed, 1.0));

    float2 u = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Film cadence. Strength 0.12 stays a texture, not a frame flash.
    float seed = floor(elapsed_time * 24.0);

    if (colored)
    {
        float gr = Grain(uv, seed) * 2.0 - 1.0;
        float gg = Grain(uv, seed + 37.1) * 2.0 - 1.0;
        float gb = Grain(uv, seed + 91.3) * 2.0 - 1.0;
        col.rgb = saturate(col.rgb + float3(gr, gg, gb) * strength);
    }
    else
    {
        float g = Grain(uv, seed) * 2.0 - 1.0;
        col.rgb = saturate(col.rgb + float3(g, g, g) * strength);
    }

    return float4(col.rgb, col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
