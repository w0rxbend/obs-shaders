// J3 — interlaced-jitter
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Interlaced video field jitter — odd rows offset horizontally with blending artifacts
// Chain order: apply before scanlines, after color effects

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

// 0.0 – 0.02 horizontal field offset
uniform float field_strength <
    string label = "Field Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.02;
    float step = 0.001;
> = 0.006;

uniform bool blend_rows = true;

// 1.0 – 10.0 animation speed
uniform float jitter_speed <
    string label = "Jitter Speed";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 10.0;
    float step = 0.01;
> = 4.0;

uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float t = elapsed_time * jitter_speed;

    // Odd and even fields alternate by scanline. Clamp the step so a zero interval cannot explode the line id.
    float lineF = uv.y / max(uv_pixel_interval.y, 0.001);
    float lineId = floor(lineF);
    float isOdd = fmod(lineId, 2.0);

    float frameSeed = floor(t * 0.5);
    float fieldSeed = Hash21(float2(lineId * 0.1, frameSeed));

    float shift = 0.0;
    if (isOdd > 0.5)
    {
        float burstRow = Hash21(float2(lineId * 3.7, floor(t * 0.25)));
        float burstAmt = step(0.85, burstRow);
        shift = (fieldSeed - 0.5) * 2.0 * field_strength;
        shift *= (1.0 + burstAmt * 4.0);
    }

    float2 shiftedUv = float2(saturate(uv.x + shift), uv.y);
    float4 col = image.Sample(textureSampler, shiftedUv);

    // Ghost the line above into odd fields so the comb reads as interlace, not a hard tear.
    if (blend_rows && isOdd > 0.5)
    {
        float2 aboveUv = float2(uv.x, saturate(uv.y - uv_pixel_interval.y));
        float4 above = image.Sample(textureSampler, aboveUv);
        float blendAmt = abs(shift) / max(field_strength, 0.001);
        blendAmt = saturate(blendAmt * 0.5);
        col.rgb = lerp(col.rgb, (col.rgb + above.rgb) * 0.5, blendAmt);
    }

    return float4(saturate(col.rgb), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
