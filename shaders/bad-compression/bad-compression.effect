// G9 — bad-compression
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Simulates heavy video compression artifacts: block quantization, color banding, slight blur
// Chain order: Apply last in chain to make the whole image look compressed

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float block_size <
    string label = "Block Size";
    string widget_type = "slider";
    float minimum = 4.0;
    float maximum = 32.0;
    float step = 1.0;
> = 12.0;
uniform float color_levels <
    string label = "Color Levels";
    string widget_type = "slider";
    float minimum = 4.0;
    float maximum = 32.0;
    float step = 1.0;
> = 16.0;
uniform float blur_mix <
    string label = "Blur Mix";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.3;
uniform float2 uv_pixel_interval;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float2 px  = uv_pixel_interval;

    // --- Block quantization: snap UV to the nearest block-grid point ---
    // block_size is in pixels; convert to UV space.
    float2 block_uv_size = max(px * max(block_size, 1.0), float2(0.001, 0.001));
    float2 snapped_uv    = floor(uv / block_uv_size) * block_uv_size + block_uv_size * 0.5;
    float2 clamped_uv    = clamp(snapped_uv, 0.0, 1.0);

    float4 block_col = image.Sample(textureSampler, clamped_uv);

    // --- Posterize (color banding): quantize each channel ---
    float levels = max(color_levels, 2.0);
    float3 posterized = floor(block_col.rgb * levels + 0.5) / max(levels, 0.001);

    // --- Slight blur: 5-tap cross at the output pixel ---
    float4 b0 = image.Sample(textureSampler, uv);
    float4 b1 = image.Sample(textureSampler, clamp(uv + float2( px.x, 0.0), 0.0, 1.0));
    float4 b2 = image.Sample(textureSampler, clamp(uv + float2(-px.x, 0.0), 0.0, 1.0));
    float4 b3 = image.Sample(textureSampler, clamp(uv + float2(0.0,  px.y), 0.0, 1.0));
    float4 b4 = image.Sample(textureSampler, clamp(uv + float2(0.0, -px.y), 0.0, 1.0));
    float3 blurred = (b0.rgb + b1.rgb + b2.rgb + b3.rgb + b4.rgb) * 0.2;

    // --- Composite: posterized block color blended with blur ---
    float3 rgb = lerp(posterized, blurred, blur_mix);

    return float4(saturate(rgb), b0.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
