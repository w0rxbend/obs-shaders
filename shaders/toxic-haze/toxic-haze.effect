// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Sickly green poison/toxic overlay with drifting fog and partial desaturation
// Chain order: early-to-mid — before vignette or bloom

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float elapsed_time;
uniform float haze_strength = 0.55; // 0.0–1.0
uniform float drift_speed   = 0.4;  // 0.0–2.0
uniform float green_bias    = 0.6;  // 0.0–1.0

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

// Simple smooth noise via overlapping sines — no texture needed
float fogNoise(float2 uv, float t)
{
    float a = sin(uv.x * 4.1 + t * 0.7) * sin(uv.y * 3.3 - t * 0.5);
    float b = sin(uv.x * 7.2 - t * 0.4 + 1.0) * sin(uv.y * 6.1 + t * 0.6);
    float c = sin(uv.x * 2.5 + uv.y * 3.8 + t * 0.3);
    return (a + b + c) * 0.333 * 0.5 + 0.5; // 0..1
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float t = elapsed_time * drift_speed;

    // Animated fog density
    float fog = fogNoise(uv, t);
    float fog2 = fogNoise(uv * 1.7 + 0.3, t * 1.3);
    float density = lerp(fog, fog2, 0.4) * haze_strength;

    // Toxic green haze color
    float3 haze_col = float3(0.1, 0.85, 0.1);

    // Partial desaturation of source
    float luma = dot(col.rgb, float3(0.299, 0.587, 0.114));
    float3 desat = lerp(col.rgb, float3(luma, luma, luma), haze_strength * 0.5);

    // Green bias: push green channel up
    desat.g = lerp(desat.g, min(desat.g * (1.0 + green_bias * 0.6), 1.0), haze_strength);
    desat.r = lerp(desat.r, desat.r * (1.0 - green_bias * 0.3), haze_strength);
    desat.b = lerp(desat.b, desat.b * (1.0 - green_bias * 0.4), haze_strength);

    // Overlay animated fog
    float3 result = lerp(desat, haze_col, density * 0.35);

    return float4(result, col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
