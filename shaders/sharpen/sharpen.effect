// A8 — sharpen
// Unsharp mask sharpening using uv_pixel_interval.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

// 0.0 – 3.0
uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.8;

// 0.5 – 4.0 (blur kernel scale)
uniform float size <
    string label = "Size";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 4.0;
    float step = 0.1;
> = 1.0;

uniform float2    uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv   = v_in.uv;
    float2 px   = uv_pixel_interval * size;

    float4 center = image.Sample(textureSampler, uv);

    // 3x3 box blur (8 neighbors + center)
    float4 blur = float4(0.0, 0.0, 0.0, 0.0);
    blur += image.Sample(textureSampler, uv + float2(-px.x, -px.y));
    blur += image.Sample(textureSampler, uv + float2(  0.0, -px.y));
    blur += image.Sample(textureSampler, uv + float2( px.x, -px.y));
    blur += image.Sample(textureSampler, uv + float2(-px.x,   0.0));
    blur += center;
    blur += image.Sample(textureSampler, uv + float2( px.x,   0.0));
    blur += image.Sample(textureSampler, uv + float2(-px.x,  px.y));
    blur += image.Sample(textureSampler, uv + float2(  0.0,  px.y));
    blur += image.Sample(textureSampler, uv + float2( px.x,  px.y));
    blur /= 9.0;

    // Unsharp mask: result = center + strength * (center - blur)
    float4 sharp = center + (center - blur) * strength;
    sharp.a      = center.a;
    return float4(saturate(sharp.rgb), sharp.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
