// O2 — hexagon-webcam-crop
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Crops webcam feed to a regular hexagon using SDF; outside = alpha 0
// Chain order: Apply first in chain before any color grading

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float size <
    string label = "Size";
    string widget_type = "slider";
    float minimum = 0.1;
    float maximum = 0.5;
    float step = 0.01;
> = 0.45;
uniform float softness <
    string label = "Edge Softness";
    string widget_type = "slider";
    float minimum = 0.001;
    float maximum = 0.05;
    float step = 0.001;
> = 0.008;
uniform float rotation <
    string label = "Rotation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.14159;
    float step = 0.01;
> = 0.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// Regular hexagon SDF (returns positive outside, negative inside).
// flat_half is tan(30 deg) times the apothem; 0.5 makes the sides unequal.
float sdfHexagon(float2 p, float radius)
{
    float2 sector = float2(-0.866025404, 0.5);
    float flat_half = 0.577350269 * radius;
    p = abs(p);
    p -= 2.0 * min(dot(sector, p), 0.0) * sector;
    p -= float2(clamp(p.x, -flat_half, flat_half), radius);
    return length(p) * sign(p.y);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Height-fraction space keeps a regular hexagon on a non-square webcam.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = uv - float2(0.5, 0.5);
    p.x *= aspect;
    float cos_rotation = cos(rotation);
    float sin_rotation = sin(rotation);
    p = float2(
        p.x * cos_rotation - p.y * sin_rotation,
        p.x * sin_rotation + p.y * cos_rotation);

    float dist = sdfHexagon(p, size);
    float edge = max(softness, 0.001);
    float mask = 1.0 - smoothstep(-edge, edge, dist);

    col.a *= mask;
    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
