// Slow falling ash flakes and a faint gray veil, thinner over the subject.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float density <
    string label = "Density";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.48;

uniform float flake_size <
    string label = "Flake Size";
    string widget_type = "slider";
    float minimum = 0.001;
    float maximum = 0.016;
    float step = 0.001;
> = 0.007;

uniform float fall_speed <
    string label = "Fall Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.2;
    float step = 0.01;
> = 0.18;

uniform float flake_strength <
    string label = "Flake Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float veil <
    string label = "Veil";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.22;

uniform float subject_clear <
    string label = "Subject Clear";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.8;

uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float AshDisc(float2 cellUv, float2 flakeCenter, float radius, float stretch)
{
    float2 delta = cellUv - flakeCenter;
    delta.x = delta.x * stretch;
    float dist = length(delta);
    float edge = max(radius, 0.001);
    return 1.0 - smoothstep(edge * 0.25, edge, dist);
}

float4 FallingAsh(float2 field, float scale, float sizeMul)
{
    float t = elapsed_time * fall_speed;
    float sway = sin(elapsed_time * 0.28 + scale * 0.13) * 0.18;
    // uv.y grows downward, so a negative offset carries flakes down the frame.
    float2 layerUv = field * scale + float2(sway, -t * (0.32 + sizeMul * 0.4));
    float2 cell = floor(layerUv);
    float2 cellUv = frac(layerUv);
    float spawn = Hash21(cell);
    float gate = 1.0 - density * 0.28;
    float visible = step(gate, spawn) * step(0.001, density);
    float2 flakeCenter = float2(
        lerp(0.28, 0.72, Hash21(cell + float2(1.7, 4.2))),
        lerp(0.28, 0.72, Hash21(cell + float2(8.3, 2.6))));
    float stretch = lerp(0.62, 1.48, Hash21(cell + float2(3.4, 6.8)));
    float radius = flake_size * scale * sizeMul;
    float disc = AshDisc(cellUv, flakeCenter, radius, stretch);
    float shade = lerp(0.40, 0.76, Hash21(cell + float2(2.2, 9.4)));
    float cover = disc * visible * lerp(0.55, 1.0, Hash21(cell + float2(5.5, 1.3)));
    float3 tone = float3(shade, shade * 0.98, shade * 0.94);
    return float4(tone * cover, cover);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 field = float2(uv.x * aspect, uv.y);
    float4 ash = FallingAsh(field, 30.0, 0.55);
    ash += FallingAsh(field, 18.0, 1.0);
    ash += FallingAsh(field, 11.0, 1.35);

    float2 fromSubject = float2((uv.x - 0.5) * aspect, uv.y - 0.38);
    float subject = 1.0 - smoothstep(0.12, 0.70, length(fromSubject));
    float veilAmt = veil * (1.0 - subject * subject_clear);
    float3 haze = float3(0.50, 0.49, 0.48);
    float3 graded = lerp(col.rgb, haze, veilAmt);

    float cover = saturate(ash.a);
    float3 ashTone = ash.rgb / max(ash.a, 0.001);
    graded = lerp(graded, ashTone, cover * flake_strength);

    return float4(saturate(graded), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
