// N4 — spiral-warp
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: UV twisted by angle proportional to distance — hypnotic static or animated spiral
// Chain order: Early in chain before any blur or compositing

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;
uniform float elapsed_time;

uniform float twist_amount <
    string label = "Twist Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 10.0;
    float step = 0.01;
> = 3.0;

uniform float zoom <
    string label = "Zoom";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform bool animated = false;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.5;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

static const float TAU = 6.28318530718;

float4 mainImage(VertData v_in) : TARGET
{
    // Circle in pixels, not in stretched UV.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = v_in.uv - 0.5;
    p.x *= aspect;
    p /= max(zoom, 0.001);

    float radius = length(p);
    float angle = atan2(p.y, p.x);
    // Wrap so a long stream does not feed a huge angle into sin/cos.
    float spin = animated ? fmod(elapsed_time * speed, TAU) : 0.0;
    angle += twist_amount * radius + spin;

    float2 spun;
    spun.x = radius * cos(angle);
    spun.y = radius * sin(angle);
    spun.x /= max(aspect, 0.001);

    float2 sample_uv = clamp(spun + 0.5, 0.0, 1.0);
    return image.Sample(textureSampler, sample_uv);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
