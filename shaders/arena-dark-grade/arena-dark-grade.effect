// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Boss fight dark grade — crushed blacks, desaturated periphery, blue-black corners
// Chain order: last — final look LUT-style grade

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float darkness <
    string label = "Darkness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float vignette <
    string label = "Vignette";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.7;

uniform float blue_shadows <
    string label = "Blue Shadows";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = image.Sample(textureSampler, uv);

    // Crush blacks. Exponent stays above 1 so midtones fall without clipping the face.
    float crush = 1.0 + darkness;
    float3 crushed = pow(max(source.rgb, 0.0), float3(crush, crush, crush));

    // 0 at center, 1 at the frame corner. Circular in pixels, not in raw UV.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - 0.5) * float2(aspect, 1.0);
    float corner_len = 0.5 * length(float2(aspect, 1.0));
    float edge_dist = length(from_center) / max(corner_len, 0.001);

    float desat_mask = smoothstep(0.3, 1.0, edge_dist);
    float luma = dot(crushed, float3(0.299, 0.587, 0.114));
    float3 gray = float3(luma, luma, luma);
    float3 periphery = lerp(crushed, gray, desat_mask * 0.7);

    float shadow_mask = 1.0 - smoothstep(0.0, 0.5, luma);
    float corner_mask = pow(max(edge_dist, 0.0), 1.5);
    float3 blue_black = float3(0.02, 0.04, 0.12);
    float3 graded = lerp(periphery, blue_black, shadow_mask * corner_mask * blue_shadows);

    float vig = 1.0 - smoothstep(0.35, 0.85, edge_dist);
    graded *= lerp(1.0, vig, vignette);

    return float4(saturate(graded), source.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
