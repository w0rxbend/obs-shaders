// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Boss fight dark grade — crushed blacks, desaturated periphery, blue-black corners
// Chain order: last — final look LUT-style grade

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float darkness      = 0.5; // 0.0–1.0
uniform float vignette      = 0.7; // 0.0–1.0
uniform float blue_shadows  = 0.4; // 0.0–1.0

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // --- Crush blacks ---
    // Lift point pulled down, then tone-map to compress shadows
    float3 crushed = pow(max(col.rgb, 0.0), float3(1.0 + darkness, 1.0 + darkness, 1.0 + darkness));

    // --- Desaturation at periphery ---
    float2 centered  = uv - 0.5;
    float  edge_dist = length(centered) * 1.414; // 0 center, ~1 corner
    float  desat_mask = smoothstep(0.3, 1.0, edge_dist);
    float  luma = dot(crushed, float3(0.299, 0.587, 0.114));
    float3 gray = float3(luma, luma, luma);
    float3 periph = lerp(crushed, gray, desat_mask * 0.7);

    // --- Blue-black corners ---
    // Blue shadows: in dark areas, push toward cold blue-black
    float shadow_mask = 1.0 - smoothstep(0.0, 0.5, luma); // stronger in dark areas
    float corner_mask = pow(edge_dist, 1.5);
    float3 blue_black = float3(0.02, 0.04, 0.12);
    float3 result = lerp(periph, blue_black, shadow_mask * corner_mask * blue_shadows);

    // --- Vignette ---
    float vig = 1.0 - smoothstep(0.35, 0.85, edge_dist);
    float vig_strength = vignette;
    result *= lerp(1.0, vig, vig_strength);

    return float4(clamp(result, 0.0, 1.0), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
