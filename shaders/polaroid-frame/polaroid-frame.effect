// O5 — polaroid-frame
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Adds classic Polaroid white border (wider at bottom) with warm tint
// Chain order: Apply after color grading; keep as outermost frame layer

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float border_top <
    string label = "Border top";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.1;
    float step = 0.001;
> = 0.04;

uniform float border_sides <
    string label = "Border sides";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.1;
    float step = 0.001;
> = 0.04;

uniform float border_bottom <
    string label = "Border bottom";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.2;
    float step = 0.001;
> = 0.12;

uniform float warmth <
    string label = "Warmth";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.05;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    // Side margin is a fraction of frame height so top and sides match in pixels.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float side = border_sides / max(aspect, 0.001);

    bool in_border = uv.x < side
        || uv.x > 1.0 - side
        || uv.y < border_top
        || uv.y > 1.0 - border_bottom;

    float inner_width = max(1.0 - side * 2.0, 0.001);
    float inner_height = max(1.0 - border_top - border_bottom, 0.001);
    float2 photo_uv = saturate(float2(
        (uv.x - side) / inner_width,
        (uv.y - border_top) / inner_height));
    float2 sample_uv = in_border ? saturate(uv) : photo_uv;

    float4 col = image.Sample(textureSampler, sample_uv);
    if (in_border)
    {
        col.rgb = saturate(float3(1.0 + warmth * 0.2, 1.0, 1.0 - warmth));
    }
    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
