// Synthwave sunset — magenta-orange grade, a low sun band, and a mild scan.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float grade <
    string label = "Grade";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.48;

uniform float sun_strength <
    string label = "Sun";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

// Default sits below a centered talking head.
uniform float sun_height <
    string label = "Sun Height";
    string widget_type = "slider";
    float minimum = 0.05;
    float maximum = 0.95;
    float step = 0.01;
> = 0.76;

uniform float scan_strength <
    string label = "Scan";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.35;
    float step = 0.01;
> = 0.1;

uniform texture2d image;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float luma = dot(col.rgb, float3(0.299, 0.587, 0.114));
    float sky = saturate(1.0 - uv.y);
    float3 magenta = float3(0.78, 0.16, 0.55);
    float3 orange = float3(1.0, 0.46, 0.12);
    float3 sunset = lerp(orange, magenta, sky);
    float shade = lerp(0.4, 1.0, luma);
    float3 graded = lerp(col.rgb, sunset * shade, grade);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_sun = uv - float2(0.5, sun_height);
    from_sun.x *= aspect;
    float radius = length(from_sun);
    float disk = 1.0 - smoothstep(0.13, 0.175, radius);
    float glow = 1.0 - smoothstep(0.12, 0.46, radius);
    glow = glow * glow;
    float below = step(sun_height, uv.y);
    float bands = step(0.48, frac((sun_height - uv.y) * 34.0));
    float sun_body = disk * lerp(1.0, bands, below);

    float3 sun_rgb = lerp(orange, float3(1.0, 0.72, 0.35), 0.45);
    graded += sun_rgb * (sun_body * 0.7 + glow * 0.2) * sun_strength;

    float row = uv.y * uv_size.y;
    float scan_wave = 0.5 + 0.5 * sin(row * 3.14159265);
    graded *= lerp(1.0, scan_wave, scan_strength);

    return float4(saturate(graded), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
