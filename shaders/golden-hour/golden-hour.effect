// L4 — golden-hour
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Warm golden sunrise/sunset grade — orange-yellow push, lifted shadows, highlight glow
// Chain order: early in chain; pair with soft-vignette after

uniform float4x4 ViewProj;
uniform float warmth       = 0.6;  // 0.0 – 1.0
uniform float shadow_lift  = 0.06; // 0.0 – 0.15
uniform float saturation   = 1.3;  // 0.5 – 2.0
uniform float glow         = 0.15; // 0.0 – 0.5

uniform float2    uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float luma(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

// Simple 5-tap horizontal+vertical box glow
float3 sampleGlow(float2 uv, float radius)
{
    float2 px = uv_pixel_interval * radius;
    float3 acc = float3(0.0, 0.0, 0.0);
    acc += image.Sample(textureSampler, uv).rgb;
    acc += image.Sample(textureSampler, uv + float2( px.x,  0.0)).rgb;
    acc += image.Sample(textureSampler, uv + float2(-px.x,  0.0)).rgb;
    acc += image.Sample(textureSampler, uv + float2(  0.0,  px.y)).rgb;
    acc += image.Sample(textureSampler, uv + float2(  0.0, -px.y)).rgb;
    return acc / 5.0;
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c   = col.rgb;

    // Shadow lift — warm shadow fill
    float lum = luma(c);
    float shadowMask = 1.0 - smoothstep(0.0, 0.4, lum);
    float3 warmShadow = float3(shadow_lift * 1.4, shadow_lift * 0.85, shadow_lift * 0.3);
    c += warmShadow * shadowMask;

    // Warm orange-yellow tint
    float3 warmTint = float3(1.0, 0.82, 0.4);
    // Blend tint additively into midtones/highlights
    float warmMask = smoothstep(0.15, 0.9, luma(c));
    c = lerp(c, c * warmTint, warmth * 0.55 * warmMask);

    // Saturation boost
    float lum2 = luma(c);
    float3 grey2 = float3(lum2, lum2, lum2);
    c = lerp(grey2, c, saturation);

    // Highlight glow tap (adds soft bloom to bright areas)
    if (glow > 0.0) {
        float3 blurred = sampleGlow(v_in.uv, 3.0);
        float highlightMask = smoothstep(0.6, 1.0, luma(blurred));
        c += blurred * highlightMask * glow;
    }

    c = clamp(c, 0.0, 1.0);
    return float4(c, col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
