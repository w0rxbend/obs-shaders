// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Rising heat shimmer with orange color boost for fire/explosion scenes
// Chain order: early — before color grading

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float elapsed_time;
uniform float heat_strength = 0.018; // 0.0–0.04
uniform float rise_speed    = 2.5;   // 0.5–5.0
uniform float orange_boost  = 0.18;  // 0.0–0.5

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData v_out;
    v_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    v_out.uv  = v_in.uv;
    return v_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float  t  = elapsed_time * rise_speed;

    // Heat is strongest at the bottom (uv.y close to 1.0 in OBS — bottom of screen)
    float bottom_mask = uv.y;  // 0 at top, 1 at bottom

    // Rising ripple: horizontal wave that shifts upward over time
    float wave1 = sin(uv.x * 23.0 + t * 1.1) * 0.5;
    float wave2 = sin(uv.x * 11.0 - t * 0.8 + 1.5) * 0.5;
    float shimmer = (wave1 + wave2) * heat_strength * bottom_mask;

    // Also apply a small vertical wave
    float vert_wave = sin(uv.x * 16.0 + t * 1.4) * heat_strength * bottom_mask * 0.4;

    float2 warp_uv = clamp(uv + float2(shimmer, -vert_wave), 0.0, 1.0);
    float4 col = image.Sample(textureSampler, warp_uv);

    // Orange boost: lift red and slightly lift green, suppress blue
    float3 orange = float3(1.0, 0.45, 0.0);
    float  heat_vis = bottom_mask * orange_boost;
    float3 result = col.rgb + orange * heat_vis * col.rgb;
    result = clamp(result, 0.0, 1.0);

    return float4(result, col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
