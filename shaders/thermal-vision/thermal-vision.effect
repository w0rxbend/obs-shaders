// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Thermal camera approximation — maps luminance through a heat palette (black→blue→cyan→red→yellow→white)
// Chain order: Apply as standalone look; mutually exclusive with infrared-camera; combine after with film-grain for authenticity

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float sensitivity <
    string label = "Sensitivity";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform float noise_amount <
    string label = "Noise Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.1;
    float step = 0.001;
> = 0.03;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

// Heat palette: t in [0,1]
// 0.00 → black
// 0.20 → deep blue
// 0.40 → cyan
// 0.60 → red
// 0.80 → yellow
// 1.00 → white
float3 heatPalette(float t)
{
    // 5-stop palette via lerp chain
    float3 c0 = float3(0.000, 0.000, 0.000); // black
    float3 c1 = float3(0.000, 0.000, 0.700); // deep blue
    float3 c2 = float3(0.000, 0.700, 0.900); // cyan
    float3 c3 = float3(0.900, 0.050, 0.050); // red
    float3 c4 = float3(1.000, 0.900, 0.050); // yellow
    float3 c5 = float3(1.000, 1.000, 1.000); // white

    float span = max(0.2, 0.001);
    float3 col;
    if (t < 0.2)
    {
        col = lerp(c0, c1, t / span);
    }
    else if (t < 0.4)
    {
        col = lerp(c1, c2, (t - 0.2) / span);
    }
    else if (t < 0.6)
    {
        col = lerp(c2, c3, (t - 0.4) / span);
    }
    else if (t < 0.8)
    {
        col = lerp(c3, c4, (t - 0.6) / span);
    }
    else
    {
        col = lerp(c4, c5, (t - 0.8) / span);
    }
    return col;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 src = image.Sample(textureSampler, uv);

    // --- Compute luminance ---
    float luma = dot(src.rgb, float3(0.299, 0.587, 0.114));

    // --- Apply sensitivity: remap dynamic range ---
    // sensitivity > 1 stretches brighter, < 1 compresses
    float t = saturate(luma * sensitivity);

    // --- Thermal noise ---
    float n = hash21(float2(uv.x * 800.0 + elapsed_time * 13.7, uv.y * 800.0 + elapsed_time * 7.3));
    t = saturate(t + (n - 0.5) * noise_amount);

    // --- Palette lookup ---
    float3 thermal = heatPalette(t);

    return float4(saturate(thermal), src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
