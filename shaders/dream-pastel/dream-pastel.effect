// F7 — dream-pastel
// Soft dreamy pastel look: colours pushed toward pastels, additive glow, slight blur.

uniform float4x4 ViewProj;
uniform float pastel_amount <
    string label = "Pastel Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.6;

uniform float glow_strength <
    string label = "Glow Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.3;

uniform float blur_size <
    string label = "Blur Size";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 8.0;
    float step = 0.1;
> = 3.0;

uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// 9-tap box blur.
float4 boxBlur(float2 uv, float scale)
{
    float2 px    = uv_pixel_interval * scale;
    float4 accum = float4(0.0, 0.0, 0.0, 0.0);
    accum += image.Sample(textureSampler, uv + float2(-px.x, -px.y));
    accum += image.Sample(textureSampler, uv + float2(  0.0, -px.y));
    accum += image.Sample(textureSampler, uv + float2( px.x, -px.y));
    accum += image.Sample(textureSampler, uv + float2(-px.x,   0.0));
    accum += image.Sample(textureSampler, uv);
    accum += image.Sample(textureSampler, uv + float2( px.x,   0.0));
    accum += image.Sample(textureSampler, uv + float2(-px.x,  px.y));
    accum += image.Sample(textureSampler, uv + float2(  0.0,  px.y));
    accum += image.Sample(textureSampler, uv + float2( px.x,  px.y));
    return accum / max(9.0, 0.001);
}

// Push an RGB colour toward its pastel version.
// Pastels live in the high-lightness, low-saturation region.
// Simple approach: lerp each channel toward a high white level.
float3 toPastel(float3 rgb, float amount)
{
    float lum = dot(rgb, float3(0.299, 0.587, 0.114));
    // Desaturate partially.
    float3 desat = lerp(rgb, float3(lum, lum, lum), amount * 0.4);
    // Lift shadows toward a pastel base (bright + tinted).
    float3 lifted = desat + (1.0 - desat) * amount * 0.45;
    return saturate(lifted);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float4 src = image.Sample(textureSampler, uv);

    // Pastel-ise the source colour.
    float3 pastel = toPastel(src.rgb, pastel_amount);

    // One 9-tap blur. A second kernel would push the inlined sample count over 16.
    float4 blurred = boxBlur(uv, blur_size);
    float3 glow = blurred.rgb;

    // Screen-blend glow on top of pastel layer.
    // screen(a,b) = 1 - (1-a)(1-b)
    float3 screened = 1.0 - (1.0 - pastel) * (1.0 - glow * glow_strength);
    float3 col = saturate(screened);

    return float4(col, src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
