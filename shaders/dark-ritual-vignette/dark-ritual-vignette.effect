// D10 — dark-ritual-vignette
// Heavy dark vignette that pulses slightly. Deep black edges,
// occasional flickering via high-frequency noise on the pulse.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.85;

uniform float softness <
    string label = "Softness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

uniform float pulse_speed <
    string label = "Pulse Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.5;

uniform float pulse_depth <
    string label = "Pulse Depth";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.1;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash1(float t)
{
    return frac(sin(t * 127.1) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float2 centered = (uv - 0.5) * 2.0;
    float dist = length(centered);
    float innerRadius = 1.0 - softness;
    float outerRadius = max(length(float2(1.0, 1.0)), innerRadius + 0.001);
    float rim = smoothstep(innerRadius, outerRadius, dist);

    float pulse = sin(elapsed_time * pulse_speed * 3.14159 * 2.0) * 0.5 + 0.5;
    float pulsedStrength = strength + (pulse - 0.5) * pulse_depth;

    // Short edge lift on about 7% of the 18 Hz steps. Center stays put.
    float flickerTime = floor(elapsed_time * 18.0);
    float flicker = hash1(flickerTime);
    float flickerMask = step(0.93, flicker) * 0.15;
    pulsedStrength = saturate(pulsedStrength - flickerMask);

    float vigAmount = saturate(rim * pulsedStrength);
    float shade = 1.0 - vigAmount;
    float3 rgb = saturate(col.rgb * shade * shade);

    return float4(rgb, col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
