// N6 — pixel-melt
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Pixels drip/melt downward driven by noise — horror/glitch aesthetic
// Chain order: Apply before compositing; pairs well with film-grain or digital-noise

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float elapsed_time;

uniform float melt_strength <
    string label = "Melt Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.12;

uniform float melt_scale <
    string label = "Melt Scale";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 10.0;
    float step = 0.1;
> = 4.0;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.8;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// Simple value noise via hash
float hash1(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

// Smooth value noise — bilinear interpolation of 4 hashes
float vnoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);

    // Smoothstep
    float2 u = f * f * (3.0 - 2.0 * f);

    float a = hash1(i);
    float b = hash1(i + float2(1.0, 0.0));
    float c = hash1(i + float2(0.0, 1.0));
    float d = hash1(i + float2(1.0, 1.0));

    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float  t  = elapsed_time * speed;

    // Noise coordinate: vary per column (x axis), animate by time
    float2 noiseCoord = float2(uv.x * melt_scale, t * 0.5);

    // Drip offset — noise value drives downward shift
    float drip = vnoise(noiseCoord) * melt_strength;

    // Additional fine ripple on the drip edges
    float ripple = sin(uv.x * 6.2832 * melt_scale * 2.0 + t * 3.0) * melt_strength * 0.15;
    drip += ripple;

    // Shift UV downward (positive Y = down in OBS)
    float2 sampleUV = saturate(uv + float2(0.0, drip));

    float4 color = image.Sample(textureSampler, sampleUV);
    return float4(saturate(color.rgb), color.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
