// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Horizontal bars wipe in from center, like a film/iris shutter
// Chain order: Apply last; layer over crt-scanlines for cinematic combo

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;

// 0 = bars closed, 1 = fully revealed. Default stays half open.
uniform float progress <
    string label = "Progress";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform int bar_count = 8; // 2–20 number of horizontal shutter bars

uniform float softness <
    string label = "Softness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.01;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);

    float bar_n = max((float)bar_count, 1.0);
    float bar_pos = frac(uv.y * bar_n);
    float dist = abs(bar_pos - 0.5);
    float half_open = saturate(progress) * 0.5;
    float feather = max(softness, 0.001);
    float visible = smoothstep(dist - feather, dist + feather, half_open);

    color.rgb *= visible;
    return color;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
