// Q1 — anxiety-pulse
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Fast irregular heartbeat-like brightness/contrast pulse with red edge creep
// Chain order: early in chain, before color grading

uniform float pulse_speed <
    string label = "Pulse Speed";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 5.0;
    float step = 0.01;
> = 2.0;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.6;

uniform float red_edge <
    string label = "Red Edge";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

uniform float     elapsed_time;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// Irregular heartbeat: combines two sine waves at different frequencies
// to produce an ECG-like beat pattern.
float heartbeat(float t, float speed)
{
    float f  = t * speed;
    // Primary beat
    float b1 = sin(f * 6.2832);
    // Secondary erratic spike offset by a prime phase
    float b2 = sin(f * 6.2832 * 2.7 + 1.3);
    // Combine: sharp positive spike then quick negative dip
    float raw = b1 * 0.6 + b2 * 0.4;
    // Rectify softly so we only get pulses, not steady oscillation
    return max(raw, 0.0);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float4 col = image.Sample(textureSampler, uv);

    // -- Heartbeat pulse --------------------------------------------------
    float pulse = heartbeat(elapsed_time, pulse_speed);

    // Brightness surge on beat
    float brightBoost = 1.0 + pulse * intensity * 0.8;
    // Contrast crush between beats (inverted pulse)
    float contrastMul = 1.0 + (1.0 - pulse) * intensity * 0.35;

    float3 rgb = col.rgb * brightBoost;
    // Re-center contrast around 0.5
    rgb = (rgb - 0.5) * contrastMul + 0.5;

    // -- Red edge vignette creeping in on beat ----------------------------
    // Distance from edge (0 at edge, 1 at center)
    float2 centered = uv * 2.0 - 1.0;
    float  edgeDist  = 1.0 - max(abs(centered.x), abs(centered.y));
    // Invert: 1 = at edge, 0 = center
    float  edgeFactor = 1.0 - saturate(edgeDist * 2.5);

    // Red creep strength pulsed by heartbeat
    float redStrength = red_edge * pulse * intensity;
    float3 redColor   = float3(0.9, 0.05, 0.05);
    rgb = lerp(rgb, redColor, edgeFactor * redStrength);

    return float4(saturate(rgb), col.a);
}
