// G6 — webcam-glass-reflection
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Overlays a subtle specular glare streak simulating camera glass reflection
// Chain order: Apply near the end, after color grading but before output

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float glare_x <
    string label = "Glare X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.6;

uniform float glare_y <
    string label = "Glare Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.25;

uniform float glare_width <
    string label = "Glare Width";
    string widget_type = "slider";
    float minimum = 0.01;
    float maximum = 0.2;
    float step = 0.001;
> = 0.06;

uniform float glare_length <
    string label = "Glare Length";
    string widget_type = "slider";
    float minimum = 0.1;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

uniform float glare_intensity <
    string label = "Glare Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.18;

uniform float glare_angle <
    string label = "Glare Angle";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.14159;
    float step = 0.01;
> = 0.5;

uniform float2 uv_size;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Height units so the streak angle and width stay true on a widescreen webcam.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = uv - float2(glare_x, glare_y);
    p.x *= aspect;

    float cos_a = cos(glare_angle);
    float sin_a = sin(glare_angle);
    float along = cos_a * p.x + sin_a * p.y;
    float across = -sin_a * p.x + cos_a * p.y;

    float along_norm = along / max(glare_length, 0.001);
    float across_norm = across / max(glare_width, 0.001);
    float ellipse_dist = sqrt(along_norm * along_norm + across_norm * across_norm);
    float glare_mask = 1.0 - smoothstep(0.0, 1.0, ellipse_dist);
    float glare_val = glare_mask * glare_mask * glare_intensity;

    float3 rgb = saturate(col.rgb + float3(glare_val, glare_val, glare_val));
    return float4(rgb, col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
