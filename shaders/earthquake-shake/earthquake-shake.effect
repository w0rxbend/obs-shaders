// Earthquake Shake
// Strong chaotic shake for impact or alarm scenes; subtle by default.

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;
uniform float elapsed_time;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 20.0;
    float step = 0.1;
> = 8.0;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.0;

uniform float zoom_compensation <
    string label = "Zoom Compensation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.25;
    float step = 0.005;
> = 0.08;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform bool strong_preset = false;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float2 rotate2d(float2 p, float a)
{
    float s = sin(a);
    float c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float hash11(float n)
{
    return frac(sin(n * 91.7) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float preset = strong_preset ? 3.8 : 1.0;
    float t = elapsed_time * speed;
    float frame = floor(t * 3.0);
    float2 snap = float2(hash11(frame), hash11(frame + 17.0)) - 0.5;
    float2 wave = float2(sin(t * 2.3), sin(t * 3.1 + 1.1)) * 0.5;
    float2 shake = (snap + wave) * 0.018 * amount * preset;
    float angle = (hash11(frame + 41.0) - 0.5) * 0.025 * amount * preset;

    float2 center = float2(center_x, center_y);
    float zoom = 1.0 + max(0.0, zoom_compensation) + length(shake) * 2.4 + abs(angle) * 1.5;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = (v_in.uv - center) / max(zoom, 0.001);
    p.x *= aspect;
    p = rotate2d(p, angle);
    p.x /= max(aspect, 0.001);
    float2 uv = center + p - shake;
    return image.Sample(textureSampler, clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0)));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
