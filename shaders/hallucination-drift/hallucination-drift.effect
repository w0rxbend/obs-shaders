// Q4 — hallucination-drift
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Slow hue cycling, UV wobble, colour inversion pulses — unstable reality
// Chain order: standalone or last in chain for maximum disorientation

uniform float hue_speed <
    string label = "Hue Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.5; // 0.0 – 3.0

uniform float drift_strength <
    string label = "Drift Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.02;
    float step = 0.001;
> = 0.008; // 0.0 – 0.02

uniform float inversion_pulse_rate <
    string label = "Inversion Pulse Rate";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.1; // 0.0 – 1.0

uniform float     elapsed_time;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// Rotate hue by angle (radians) using the standard rotation in YIQ space
float3 rotateHue(float3 rgb, float angle)
{
    // Convert to YIQ
    float3x3 toYIQ = float3x3(
        0.299,  0.587,  0.114,
        0.596, -0.274, -0.322,
        0.211, -0.523,  0.312
    );
    float3 yiq = mul(toYIQ, rgb);

    // Rotate IQ plane
    float cosA = cos(angle);
    float sinA = sin(angle);
    float i2   = yiq.y * cosA - yiq.z * sinA;
    float q2   = yiq.y * sinA + yiq.z * cosA;
    yiq.y      = i2;
    yiq.z      = q2;

    // Convert back to RGB
    float3x3 toRGB = float3x3(
        1.0,  0.9563,  0.6210,
        1.0, -0.2721, -0.6474,
        1.0, -1.1070,  1.7046
    );
    return saturate(mul(toRGB, yiq));
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // -- UV drift / wobble ------------------------------------------------
    // Multi-frequency Lissajous-style wobble for organic feel
    float waveX = sin(uv.y * 8.0 + elapsed_time * 1.3) * drift_strength;
    float waveY = cos(uv.x * 7.0 + elapsed_time * 0.9) * drift_strength;
    float waveX2 = sin(uv.y * 15.0 + elapsed_time * 2.1 + 1.4) * drift_strength * 0.4;
    float waveY2 = cos(uv.x * 13.0 + elapsed_time * 1.7 + 0.8) * drift_strength * 0.4;

    float2 driftedUV = uv + float2(waveX + waveX2, waveY + waveY2);
    driftedUV        = saturate(driftedUV);

    float4 col = image.Sample(textureSampler, driftedUV);

    // -- Hue rotation -----------------------------------------------------
    float hueAngle = elapsed_time * hue_speed * 6.2832;
    float3 rgb     = rotateHue(col.rgb, hueAngle);

    // -- Colour inversion pulse -------------------------------------------
    // Rate controls how often the flash fires; use a high-frequency sine
    // gated by a slower envelope so it pulses rather than strobes constantly
    float invEnvelope = max(sin(elapsed_time * inversion_pulse_rate * 6.2832 * 0.7), 0.0);
    float invFlash    = max(sin(elapsed_time * inversion_pulse_rate * 6.2832 * 11.0), 0.0);
    invFlash          = pow(invFlash, 6.0) * invEnvelope;

    float3 inverted = 1.0 - rgb;
    rgb = lerp(rgb, inverted, saturate(invFlash));

    return float4(saturate(rgb), col.a);
}
