// L9 — rainy-noir
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Wet city night noir — blue-grey desaturation, crushed shadows, green-grey midtones, heavy vignette
// Chain order: early in chain; pair with chromatic-aberration or vhs-tracking for gritty look

uniform float4x4 ViewProj;
uniform float desat        = 0.7;  // 0.0 – 1.0
uniform float blue_grey    = 0.4;  // 0.0 – 1.0
uniform float shadow_crush = 0.12; // 0.0 – 0.3
uniform float vignette     = 0.5;  // 0.0 – 1.0

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float luma(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c   = col.rgb;

    // Desaturate
    float lum = luma(c);
    float3 grey = float3(lum, lum, lum);
    c = lerp(c, grey, desat);

    // Shadow crush — pulls darks toward pure black
    // Values below crush_black get pulled down aggressively
    float crushFactor = shadow_crush;
    c = max(c - crushFactor, float3(0.0, 0.0, 0.0));
    // Re-normalize above crush floor
    c = c / (1.0 - crushFactor + 0.001);

    // Blue-grey push in midtones and shadows
    float midMask = smoothstep(0.0, 0.7, luma(c)) * (1.0 - smoothstep(0.6, 1.0, luma(c)));
    float shadowMask = 1.0 - smoothstep(0.0, 0.5, luma(c));
    c.b += blue_grey * 0.18 * (midMask + shadowMask * 0.6);
    c.g += blue_grey * 0.06 * midMask; // slight green-grey in midtones
    c.r -= blue_grey * 0.10 * (midMask + shadowMask * 0.4);

    // Heavy vignette — cinematic tunnel effect
    float2 centered = v_in.uv - float2(0.5, 0.5);
    float vd = dot(centered, centered) * 3.0;
    float vig = 1.0 - clamp(vd * vignette * 1.2, 0.0, 0.95);
    c *= vig;

    c = clamp(c, 0.0, 1.0);
    return float4(c, col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
