// A4 — skin-softening
// Bilateral-like blur: box blur weighted by color similarity.
// Smooths uniform-color regions (skin) while preserving edges.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform int blur_radius <
    string label = "Blur Radius";
    string widget_type = "slider";
    int minimum = 1;
    int maximum = 8;
    int step = 1;
> = 3;

uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float threshold <
    string label = "Threshold";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.2;

uniform float2 uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 center = image.Sample(textureSampler, uv);

    float3 accum = float3(0.0, 0.0, 0.0);
    float weight = 0.0;
    // 3x3 keeps the live pass at 10 taps. blur_radius is the pixel step, clamped to its documented range.
    float scale = clamp(float(blur_radius), 1.0, 8.0);
    float sigma = max(threshold, 0.001);
    float color_window = max(2.0 * sigma * sigma, 0.001);

    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            float2 offset = float2(float(x), float(y)) * uv_pixel_interval * scale;
            float4 tap = image.Sample(textureSampler, uv + offset);
            float3 diff = tap.rgb - center.rgb;
            float color_dist = dot(diff, diff);
            float tap_weight = exp(-color_dist / color_window);
            accum += tap.rgb * tap_weight;
            weight += tap_weight;
        }
    }

    float3 blurred = accum / max(weight, 0.001);
    float3 softened = saturate(lerp(center.rgb, blurred, strength));
    return float4(softened, center.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
