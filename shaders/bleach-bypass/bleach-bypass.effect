// L2 — bleach-bypass
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Film lab bleach-bypass — partial desaturation, boosted contrast, lifted shadows
// Chain order: early in chain; stack before grain for authentic look

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.7;

uniform float contrast_boost <
    string label = "Contrast Boost";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

uniform float desat <
    string label = "Desaturation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c   = col.rgb;

    // Partial desaturation
    float lum = luma(c);
    float3 grey = float3(lum, lum, lum);
    float3 desat_c = lerp(c, grey, desat * strength);

    // Contrast boost via S-curve approximation around midpoint
    // Lift shadows, boost midtone contrast
    float pivot = 0.5;
    float boost = 1.0 + contrast_boost * strength * 1.5;
    float3 contrasted = (desat_c - pivot) * boost + pivot;

    // Slight shadow lift (the characteristic bleach-bypass milky black)
    float3 shadow_lift = float3(0.035, 0.035, 0.035);
    float shadowMask = 1.0 - smoothstep(0.0, 0.45, lum);
    contrasted += shadow_lift * shadowMask * strength;

    float3 graded = saturate(contrasted);
    return float4(graded, col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
