// F8 — noir-detective
// Black & white noir: high contrast, deep shadows, moody vignette,
// subtle warm tone, animated film grain.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float contrast <
    string label = "Contrast";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 4.0;
    float step = 0.01;
> = 2.0;

uniform float vignette <
    string label = "Vignette";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.6;

uniform float warmth <
    string label = "Warmth";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.1;

uniform float grain <
    string label = "Grain";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.08;

uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 src = image.Sample(textureSampler, uv);

    float lum = dot(src.rgb, float3(0.299, 0.587, 0.114));

    // Exponent below 1 pushes luma away from mid-gray. contrast 1 stays linear.
    float centered = lum * 2.0 - 1.0;
    float curved = sign(centered) * pow(abs(centered), 1.0 / max(contrast, 0.001));
    lum = saturate(curved * 0.5 + 0.5);

    float3 warm_highlight = float3(1.0, 0.92, 0.75);
    float3 gray = float3(lum, lum, lum);
    float3 col = lerp(gray, gray * warm_highlight, warmth * lum);

    // Circular in pixels. Corner distance matches the old square-UV falloff.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 vig_uv = uv * 2.0 - 1.0;
    vig_uv.x *= aspect;
    float corner = aspect * aspect + 1.0;
    float vig_dist = dot(vig_uv, vig_uv) * (2.0 / max(corner, 0.001));
    float vig_mask = 1.0 - smoothstep(0.4, 1.6, vig_dist * vignette);
    col *= vig_mask;

    // 24 fps grain is film cadence, not a full-frame flash.
    float2 grain_px = uv / max(uv_pixel_interval, float2(0.001, 0.001));
    float grain_frame = floor(elapsed_time * 24.0);
    float noise = hash(grain_px + float2(grain_frame * 0.1234, grain_frame * 0.5678));
    noise = (noise - 0.5) * 2.0;
    col = saturate(col + float3(noise, noise, noise) * grain);

    return float4(col, src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
