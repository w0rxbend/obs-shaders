// Dissociation
// Slight double image, mild desaturation, and a slow drift.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float double_image <
    string label = "Double Image";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.34;

uniform float separation <
    string label = "Separation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.016;

uniform float drift <
    string label = "Drift";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.65;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.2;
    float step = 0.01;
> = 0.45;

uniform float desaturate <
    string label = "Desaturate";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.24;

uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float safe_aspect = max(aspect, 0.001);
    float phase = elapsed_time * speed;

    // Screen offset is in frame heights. x is divided by aspect so the copy is not stretched.
    float2 drift_screen = float2(sin(phase), cos(phase * 0.73)) * (drift * 0.02);
    float2 drift_uv = float2(drift_screen.x / safe_aspect, drift_screen.y);

    float echo_phase = phase * 0.35;
    float2 echo_screen = float2(cos(echo_phase), sin(echo_phase)) * separation;
    float2 echo_uv = float2(echo_screen.x / safe_aspect, echo_screen.y);

    float4 base = image.Sample(textureSampler, uv + drift_uv);
    float4 echo_color = image.Sample(textureSampler, uv + drift_uv + echo_uv);

    float echo_weight = saturate(double_image);
    float3 graded = lerp(base.rgb, echo_color.rgb, echo_weight);
    float luma = dot(graded, float3(0.299, 0.587, 0.114));
    graded = lerp(graded, float3(luma, luma, luma), saturate(desaturate));

    float alpha = lerp(base.a, echo_color.a, echo_weight);
    return float4(saturate(graded), alpha);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
