// A1 — rounded-corners
// Masks corners with a smooth rounded rectangle, outputting transparency.

uniform float radius    = 0.1;  // 0.0 – 0.5
uniform float smoothness = 0.01; // 0.0 – 0.05

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// Signed distance to a rounded rectangle centered at 0.5,0.5
// p  : uv in [0,1]
// r  : corner radius in UV space (square aspect)
float sdRoundedRect(float2 p, float r)
{
    float2 q = abs(p - 0.5) - (0.5 - r);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv   = v_in.uv;
    float4 col  = image.Sample(textureSampler, uv);

    float dist  = sdRoundedRect(uv, radius);
    // dist < 0 = inside, dist > 0 = outside
    float alpha = 1.0 - smoothstep(-smoothness, smoothness, dist);

    col.a *= alpha;
    return col;
}
