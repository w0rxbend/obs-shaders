// A1 — rounded-corners
// Masks corners with a smooth rounded rectangle, outputting transparency.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float radius <
    string label = "Radius";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.1;

uniform float smoothness <
    string label = "Smoothness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.01;

uniform float2 uv_size;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// Height-normalized space keeps the corner radius circular on widescreen.
float sdRoundedRect(float2 p, float2 half_extent, float r)
{
    float2 q = abs(p) - (half_extent - r);
    return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    if (aspect < 0.001)
        aspect = 1.0;

    float2 half_extent = 0.5 * float2(aspect, 1.0);
    float2 p = (uv - 0.5) * float2(aspect, 1.0);
    float corner = min(max(radius, 0.0), min(half_extent.x, half_extent.y));
    float edge = max(smoothness, 0.001);
    float dist = sdRoundedRect(p, half_extent, corner);
    float mask = 1.0 - smoothstep(-edge, edge, dist);

    col.a *= mask;
    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
