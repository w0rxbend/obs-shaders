// E2 — datamosh-block-shift
// Divides the frame into rectangular blocks. Each block hashes its coordinate
// against time to decide whether it shifts horizontally (datamosh look).
// block_size  : pixel block size in UV fractions (4.0–64.0, default 16.0)
// shift_amount: max horizontal shift in UV units (0.0–0.1, default 0.03)
// probability : fraction of blocks that shift (0.0–1.0, default 0.15)
// speed       : time scale for block re-randomisation (0.5–5.0, default 2.0)

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float block_size <
    string label = "Block Size";
    string widget_type = "slider";
    float minimum = 4.0;
    float maximum = 64.0;
    float step = 1.0;
> = 16.0;
uniform float shift_amount <
    string label = "Shift Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.1;
    float step = 0.001;
> = 0.03;
uniform float probability <
    string label = "Probability";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.15;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 5.0;
    float step = 0.1;
> = 2.0;

uniform float elapsed_time;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Snap time to discrete ticks so blocks hold for a frame duration
    float tick = floor(elapsed_time * speed);

    // Identify which block this pixel belongs to (in UV space, unit = 1/block_size)
    // We use uv directly; block_size acts as a divisor across [0,1]
    float invBlock = 1.0 / max(block_size, 0.001);
    float2 blockCoord = floor(uv / max(invBlock, 0.001));

    // Hash block + tick for stable but animated randomness
    float h = hash2(blockCoord + tick * float2(0.1734, 0.9817));

    // Decide if this block is active
    float gate = step(1.0 - probability, h);

    // Derive shift magnitude and direction from secondary hash
    float h2  = hash2(blockCoord * 1.7 + tick * float2(0.5311, 0.2173));
    float shift = (h2 * 2.0 - 1.0) * shift_amount * gate;

    float2 shiftedUV = saturate(float2(uv.x + shift, uv.y));

    float4 color = image.Sample(textureSampler, shiftedUV);
    return float4(saturate(color.rgb), color.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
