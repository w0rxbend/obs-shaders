// B3 — pincushion-distortion
// Classic polynomial pincushion distortion (pinch inward at edges).
// k1 : second-order coefficient  (-1.0–1.0, default -0.3)
// k2 : fourth-order coefficient  (-0.5–0.5, default -0.05)

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float k1 <
    string label = "Second order";
    string widget_type = "slider";
    float minimum = -1.0;
    float maximum = 1.0;
    float step = 0.01;
> = -0.3;
uniform float k2 <
    string label = "Fourth order";
    string widget_type = "slider";
    float minimum = -0.5;
    float maximum = 0.5;
    float step = 0.01;
> = -0.05;

uniform texture2d image;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Circular in pixels. Corner length matches the unit square so defaults do not fold wide frames.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 p = uv * 2.0 - 1.0;
    p.x *= aspect;
    float corner = max(length(float2(aspect, 1.0)), 0.001);
    p *= sqrt(2.0) / corner;

    float r2 = dot(p, p);
    float r4 = r2 * r2;

    // Same polynomial as barrel — pincushion uses negative k values
    float scale = 1.0 + k1 * r2 + k2 * r4;
    float2 pWarp = p * scale;
    pWarp *= corner / sqrt(2.0);
    pWarp.x /= max(aspect, 0.001);

    float2 uvWarp = saturate((pWarp + 1.0) * 0.5);

    return image.Sample(textureSampler, uvWarp);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
