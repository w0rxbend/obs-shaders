// G1 — webcam-rounded-frame
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Rounds the webcam image with a smooth alpha mask and draws a colored border ring
// Chain order: Apply first in chain, before color grading effects

uniform float radius <
    string label = "Radius";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.12;

uniform float border_width <
    string label = "Border width";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.02;

uniform float border_r <
    string label = "Border red";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.2;

uniform float border_g <
    string label = "Border green";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.6;

uniform float border_b <
    string label = "Border blue";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform float border_opacity <
    string label = "Border opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform float2 uv_size;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// p is centered in height-normalized space so the radius stays circular.
float sdRoundedRect(float2 p, float2 half_extent, float r)
{
    float2 q = abs(p) - (half_extent - r);
    return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    if (aspect < 0.001)
    {
        aspect = 1.0;
    }

    float2 half_extent = 0.5 * float2(aspect, 1.0);
    float2 p = (uv - 0.5) * float2(aspect, 1.0);
    float max_corner = max(min(half_extent.x, half_extent.y) - 0.001, 0.0);
    float corner = min(clamp(radius, 0.0, 0.5), max_corner);
    // Straight edges sit on the quad, so the ring is an inset band, not an outer halo.
    float ring_width = min(clamp(border_width, 0.0, 0.05), max_corner);

    float dist = sdRoundedRect(p, half_extent, corner);
    float aa = max(1.5 / max(uv_size.y, 1.0), 0.001);
    float outer_mask = 1.0 - smoothstep(-aa, aa, dist);
    float inner_mask = 1.0 - smoothstep(-aa, aa, dist + ring_width);
    float ring = saturate(outer_mask - inner_mask);

    float3 border_col = saturate(float3(border_r, border_g, border_b));
    float border_mix = saturate(ring * clamp(border_opacity, 0.0, 1.0));
    float3 rgb = lerp(col.rgb, border_col, border_mix);
    float alpha = col.a * outer_mask;

    return float4(rgb, alpha);
}
