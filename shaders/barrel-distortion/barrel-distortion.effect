// B2 — barrel-distortion
// Classic polynomial barrel distortion (bulge outward).
// k1 : second-order coefficient  (-1.0–1.0, default  0.3)
// k2 : fourth-order coefficient  (-0.5–0.5, default  0.05)

uniform float k1 = 0.3;
uniform float k2 = 0.05;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Center in [-1, 1]
    float2 p  = uv * 2.0 - 1.0;
    float  r2 = dot(p, p);          // r^2
    float  r4 = r2 * r2;            // r^4

    // r' = r * (1 + k1*r^2 + k2*r^4)  applied to the direction vector
    float scale = 1.0 + k1 * r2 + k2 * r4;
    float2 pWarp = p * scale;

    float2 uvWarp = saturate((pWarp + 1.0) * 0.5);

    return image.Sample(textureSampler, uvWarp);
}
