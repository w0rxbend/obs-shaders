// F9 — grunge-overlay
// Procedural grunge/dirt multiply-blended over the source.
// Multi-frequency noise creates a weathered, dirty texture.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

// 0.0 – 1.0 overall grunge intensity
uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

// 1.0 – 20.0 spatial scale of the noise pattern
uniform float scale <
    string label = "Scale";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 20.0;
    float step = 0.1;
> = 8.0;

// 0.5 – 4.0 contrast of the noise mask
uniform float contrast <
    string label = "Contrast";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 4.0;
    float step = 0.01;
> = 2.0;

uniform bool mono = true; // true = monochrome grunge; false = slight colour variation

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// Value noise: bilinear interpolation of hashed grid.
float hash(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float vnoise(float2 p)
{
    float2 ip = floor(p);
    float2 f  = frac(p);
    float2 u  = f * f * (3.0 - 2.0 * f);
    float n00 = hash(ip + float2(0.0, 0.0));
    float n10 = hash(ip + float2(1.0, 0.0));
    float n01 = hash(ip + float2(0.0, 1.0));
    float n11 = hash(ip + float2(1.0, 1.0));
    return lerp(lerp(n00, n10, u.x), lerp(n01, n11, u.x), u.y);
}

// Fractal noise: 4 octaves.
float fbm(float2 p)
{
    float v = 0.0;
    float a = 0.5;
    float2 fp = p;
    for (int i = 0; i < 4; i++)
    {
        v  += a * vnoise(fp);
        a  *= 0.5;
        fp *= 2.1;
    }
    return v;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float4 src = image.Sample(textureSampler, uv);

    // Build the grunge mask from two FBM layers at different scales.
    float2 p1 = uv * scale;
    float2 p2 = uv * scale * 3.7 + float2(5.2, 1.3);
    float  n1 = fbm(p1);
    float  n2 = fbm(p2);
    float  n  = n1 * 0.65 + n2 * 0.35;

    // Apply contrast: remap [0,1] through power.
    n = saturate((n - 0.5) * contrast + 0.5);

    // Grunge mask: 0 = clean, 1 = maximum dirt (dark).
    // Invert: bright noise = less grunge.
    float grungeAmount = (1.0 - n) * strength;

    float3 grungeTint;
    if (mono)
    {
        grungeTint = float3(grungeAmount, grungeAmount, grungeAmount);
    }
    else
    {
        // Slight warm-brown colour variation.
        float3 dirtColor = float3(0.38, 0.24, 0.12);
        grungeTint = dirtColor * grungeAmount;
    }

    // Multiply blend: multiplying by a value < 1 darkens.
    float3 multiplied = src.rgb * (1.0 - grungeTint);
    float3 col        = saturate(multiplied);

    return float4(col, src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
