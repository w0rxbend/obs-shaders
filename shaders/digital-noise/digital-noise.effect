// E3 — digital-noise
// Heavy digital static/noise overlay (binary salt-and-pepper style).
// amount  : fraction of pixels replaced by noise (0.0–1.0, default 0.15)
// size    : noise pixel size multiplier (0.5–4.0, default 1.0)
// colored : false = white/black noise, true = random RGB noise

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.15;

uniform float size <
    string label = "Size";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 4.0;
    float step = 0.01;
> = 1.0;

uniform bool colored = false;

uniform float elapsed_time;
uniform float2 uv_size;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

// Square blocks in screen pixels. 512 cells on the short side keeps the grain visible.
float2 quantUV(float2 uv, float blockScale)
{
    float cellsY = 512.0 / max(blockScale, 0.001);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 cells = max(float2(cellsY * aspect, cellsY), float2(0.001, 0.001));
    return floor(uv * cells) / cells;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float tick = floor(elapsed_time * 60.0);
    float2 qUV = quantUV(uv, size);
    float gate = hash2(qUV + tick * float2(0.1234, 0.9876));
    float isNoise = step(1.0 - amount, gate);
    float4 source = image.Sample(textureSampler, uv);

    float3 noiseRgb;
    if (colored)
    {
        noiseRgb = float3(
            hash2(qUV * 1.3 + tick * float2(0.2, 0.1)),
            hash2(qUV * 1.7 + tick * float2(0.5, 0.3)),
            hash2(qUV * 2.1 + tick * float2(0.8, 0.6)));
    }
    else
    {
        float bw = step(0.5, hash2(qUV * 2.0 + tick * float2(0.77, 0.33)));
        noiseRgb = float3(bw, bw, bw);
    }

    float3 rgb = saturate(lerp(source.rgb, noiseRgb, isNoise));
    return float4(rgb, source.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
