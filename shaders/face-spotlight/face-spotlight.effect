// G4 — face-spotlight
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Vignette darkens everything except a spotlight ellipse centered on the face area
// Chain order: Apply before color grading; combine with webcam-rounded-frame for full frame effect

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.45;
uniform float radius_x <
    string label = "Radius X";
    string widget_type = "slider";
    float minimum = 0.05;
    float maximum = 0.5;
    float step = 0.01;
> = 0.22;
uniform float radius_y <
    string label = "Radius Y";
    string widget_type = "slider";
    float minimum = 0.05;
    float maximum = 0.5;
    float step = 0.01;
> = 0.28;
uniform float darkness <
    string label = "Darkness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.7;
uniform float softness <
    string label = "Softness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Normalized distance from center, scaled by per-axis radius.
    float2 center = float2(center_x, center_y);
    float rx = max(radius_x, 0.001);
    float ry = max(radius_y, 0.001);
    float2 delta = (uv - center) / float2(rx, ry);
    float dist = length(delta);

    // Inner edge of the soft falloff at dist=1, outer at dist = 1+softness.
    float soft_outer = 1.0 + max(softness, 0.001);
    float spotlight  = 1.0 - smoothstep(1.0, soft_outer, dist);

    // darken = 0 at spotlight center (no darkening), darkness at far edges.
    float darken = (1.0 - spotlight) * darkness;

    col.rgb = saturate(col.rgb * (1.0 - darken));
    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
