// F1 — halftone
// Comic book halftone dot pattern.
// Luminance of each grid cell drives the dot radius; the grid can be rotated.

uniform float4x4 ViewProj;
uniform float dot_size = 6.0;  // 2.0 – 20.0  grid cell size in pixels
uniform float angle    = 0.0;  // 0.0 – 3.14159  grid rotation in radians
uniform float contrast = 1.2;  // 0.5 – 3.0  luminance contrast before sizing

uniform float2    uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

// Rotate a 2-D point by angle theta.
float2 rotate2D(float2 p, float theta)
{
    float s = sin(theta);
    float c = cos(theta);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Convert UV to pixel-space coordinates.
    float2 pixelPos = uv / uv_pixel_interval;

    // Rotate pixel position around screen centre.
    float2 centre = float2(0.5, 0.5) / uv_pixel_interval;
    float2 rotPos = rotate2D(pixelPos - centre, angle) + centre;

    // Find the halftone grid cell this pixel belongs to.
    float2 cell = floor(rotPos / dot_size);

    // Centre of that cell in rotated pixel space.
    float2 cellCentre = (cell + 0.5) * dot_size;

    // Sample the source at the cell centre (convert back to UV).
    float2 sampleUV = cellCentre * uv_pixel_interval;
    sampleUV = rotate2D(sampleUV - float2(0.5, 0.5), -angle) + float2(0.5, 0.5);
    sampleUV = clamp(sampleUV, float2(0.0, 0.0), float2(1.0, 1.0));

    float4 srcColor = image.Sample(textureSampler, sampleUV);

    // Luminance of the sampled cell colour.
    float lum = dot(srcColor.rgb, float3(0.299, 0.587, 0.114));

    // Apply contrast around the mid-point.
    lum = saturate((lum - 0.5) * contrast + 0.5);

    // Dot radius: bright cells → small dot (white paper shows through);
    // dark cells → large dot fills the cell.
    float maxRadius = dot_size * 0.5;
    float radius    = maxRadius * (1.0 - lum);

    // Distance from this pixel to the cell centre (in rotated space).
    float dist = length(rotPos - cellCentre);

    // Inside the dot → black ink; outside → white paper.
    float ink = step(dist, radius);

    float3 paperColor = float3(1.0, 1.0, 1.0);
    float3 inkColor   = float3(0.0, 0.0, 0.0);
    float3 col        = lerp(paperColor, inkColor, ink);

    return float4(col, srcColor.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
