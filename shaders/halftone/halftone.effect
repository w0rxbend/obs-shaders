// F1 — halftone
// Comic book halftone dot pattern.
// Luminance of each grid cell drives the dot radius; the grid can be rotated.

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float dot_size <
    string label = "Dot Size";
    string widget_type = "slider";
    float minimum = 2.0;
    float maximum = 20.0;
    float step = 0.1;
> = 6.0;

uniform float angle <
    string label = "Angle";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.14159;
    float step = 0.01;
> = 0.0;

uniform float contrast <
    string label = "Contrast";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 3.0;
    float step = 0.01;
> = 1.2;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float2 rotate2D(float2 p, float theta)
{
    float s = sin(theta);
    float c = cos(theta);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float2 pixelSize = max(uv_size, float2(1.0, 1.0));
    float cellSize = max(dot_size, 0.001);

    // Pixel space keeps round dots on widescreen, and the inverse rotation stays in that space.
    float2 pixelPos = uv * pixelSize;
    float2 center = float2(0.5, 0.5) * pixelSize;
    float2 rotPos = rotate2D(pixelPos - center, angle) + center;

    float2 cell = floor(rotPos / cellSize);
    float2 cellCentre = (cell + 0.5) * cellSize;

    float2 samplePx = rotate2D(cellCentre - center, -angle) + center;
    float2 sampleUV = clamp(samplePx / pixelSize, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 srcColor = image.Sample(textureSampler, sampleUV);

    float lum = dot(srcColor.rgb, float3(0.299, 0.587, 0.114));
    lum = saturate((lum - 0.5) * contrast + 0.5);

    // Bright cells leave small dots so the paper shows; dark cells fill the cell.
    float radius = cellSize * 0.5 * (1.0 - lum);
    float ink = step(length(rotPos - cellCentre), radius);
    float3 col = lerp(float3(1.0, 1.0, 1.0), float3(0.0, 0.0, 0.0), ink);

    return float4(saturate(col), srcColor.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
