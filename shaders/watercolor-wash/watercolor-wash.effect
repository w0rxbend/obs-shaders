// F6 — watercolor-wash
// Soft watercolour look: blurred colours, boosted saturation, paper-texture noise.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_pixel_interval;

uniform float blur_amount <
    string label = "Blur Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 10.0;
    float step = 0.1;
> = 4.0;

uniform float saturation <
    string label = "Saturation";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.3;

uniform float paper_strength <
    string label = "Paper Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.1;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float paperNoise(float2 p)
{
    float v = 0.0;
    float a = 0.5;
    float2 fp = p;
    for (int i = 0; i < 4; i++)
    {
        float2 ip  = floor(fp);
        float2 f   = frac(fp);
        float2 u   = f * f * (3.0 - 2.0 * f);
        float  n00 = hash(ip + float2(0.0, 0.0));
        float  n10 = hash(ip + float2(1.0, 0.0));
        float  n01 = hash(ip + float2(0.0, 1.0));
        float  n11 = hash(ip + float2(1.0, 1.0));
        float  n   = lerp(lerp(n00, n10, u.x), lerp(n01, n11, u.x), u.y);
        v  += a * n;
        a  *= 0.5;
        fp *= 2.0;
    }
    return v;
}

// Eight neighbours plus the center sample. A second radius would exceed 16 taps.
float4 boxBlur(float2 uv, float4 center, float2 px)
{
    float4 accum = center;
    accum += image.Sample(textureSampler, uv + float2(-px.x, -px.y));
    accum += image.Sample(textureSampler, uv + float2( 0.0, -px.y));
    accum += image.Sample(textureSampler, uv + float2( px.x, -px.y));
    accum += image.Sample(textureSampler, uv + float2(-px.x,  0.0));
    accum += image.Sample(textureSampler, uv + float2( px.x,  0.0));
    accum += image.Sample(textureSampler, uv + float2(-px.x,  px.y));
    accum += image.Sample(textureSampler, uv + float2( 0.0,  px.y));
    accum += image.Sample(textureSampler, uv + float2( px.x,  px.y));
    return accum / max(9.0, 0.001);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 src = image.Sample(textureSampler, uv);
    float2 px = uv_pixel_interval * blur_amount;
    float4 blurred = boxBlur(uv, src, px);

    float lum = dot(blurred.rgb, float3(0.299, 0.587, 0.114));
    float3 saturated = lerp(float3(lum, lum, lum), blurred.rgb, saturation);
    float3 graded = saturate(saturated);

    float2 safe_interval = max(uv_pixel_interval, float2(0.001, 0.001));
    float2 paper_uv = uv / safe_interval * 0.15;
    float grain = paperNoise(paper_uv) - 0.5;
    float3 col = saturate(graded + float3(grain, grain, grain) * paper_strength);

    return float4(col, src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
