// B6 — perspective-tilt
// Fake perspective / camera tilt-shift via a homographic-style warp.
// tilt_x : horizontal tilt angle  (-0.3–0.3, default 0.0)
// tilt_y : vertical tilt angle    (-0.3–0.3, default 0.1)
// zoom   : overall zoom           (0.5–2.0,  default 1.0)

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float tilt_x <
    string label = "Tilt X";
    string widget_type = "slider";
    float minimum = -0.3;
    float maximum = 0.3;
    float step = 0.01;
> = 0.0;

uniform float tilt_y <
    string label = "Tilt Y";
    string widget_type = "slider";
    float minimum = -0.3;
    float maximum = 0.3;
    float step = 0.01;
> = 0.1;

uniform float zoom <
    string label = "Zoom";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Map to [-1, 1] centered
    float2 p = uv * 2.0 - 1.0;

    // Perspective divide: simulate a tilted plane
    // w = 1 + tilt_x * x + tilt_y * y   (affine approximation of a perspective)
    float w = 1.0 + tilt_x * p.x + tilt_y * p.y;
    w = max(w, 0.01); // avoid division by zero or flip

    float2 pTilted = p / w;

    // Apply zoom
    float2 uvWarp = saturate((pTilted / max(zoom, 0.001) + 1.0) * 0.5);

    return image.Sample(textureSampler, uvWarp);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
