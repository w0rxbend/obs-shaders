// A6 — temperature-shift
// Warm/cool color temperature shift with green/magenta tint control.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float temperature <
    string label = "Temperature (Cool to Warm)";
    string widget_type = "slider";
    float minimum = -1.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.2;

uniform float tint <
    string label = "Tint (Green to Magenta)";
    string widget_type = "slider";
    float minimum = -1.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Temperature: warm adds red/yellow, removes blue; cool is opposite.
    // Approximate Planckian locus shift as RGB channel offsets.
    float t = clamp(temperature, -1.0, 1.0);
    float g = clamp(tint,        -1.0, 1.0);

    // Channel multipliers: warm raises R, lowers B; cool does opposite.
    float3 mult;
    mult.r = 1.0 + t * 0.15;
    mult.g = 1.0 - abs(t) * 0.03 + g * 0.08;
    mult.b = 1.0 - t * 0.20;

    float3 result = col.rgb * mult;

    // Preserve luminance to avoid overall brightness shift
    float lumaSrc = dot(col.rgb, float3(0.2126, 0.7152, 0.0722));
    float lumaDst = dot(result,  float3(0.2126, 0.7152, 0.0722));
    float scale   = lumaSrc / max(lumaDst, 0.001);
    result       *= scale;

    return float4(saturate(result), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
