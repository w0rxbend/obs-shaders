// L8 — sodium-vapor
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Urban sodium-vapor lamp orange glow — deep amber tint, crushed blacks, halation blur
// Chain order: early in chain; combine with lens-dirt or film-grain after

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_pixel_interval;
uniform texture2d image;

uniform float amber_strength <
    string label = "Amber Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.65;

uniform float crush_black <
    string label = "Crush Black";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.1;

uniform float halation <
    string label = "Halation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.2;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

// 3-tap diagonal halation blur (cheap light bleed simulation)
float3 sampleHalation(float2 uv, float radius)
{
    float2 px = uv_pixel_interval * radius;
    float3 acc = float3(0.0, 0.0, 0.0);
    acc += image.Sample(textureSampler, uv).rgb                            * 0.5;
    acc += image.Sample(textureSampler, uv + float2( px.x,  px.y)).rgb    * 0.25;
    acc += image.Sample(textureSampler, uv + float2(-px.x, -px.y)).rgb    * 0.25;
    return acc;
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c   = col.rgb;

    // Black crush — lifts very dark values to murky dark-amber
    c = max(c, float3(crush_black * 0.6, crush_black * 0.3, 0.0));

    // Sodium-vapor amber/orange tint
    // Sodium lamps emit almost monochromatic yellow-orange (~590 nm)
    // Desaturate then tint strongly amber
    float lum = luma(c);
    float3 grey = float3(lum, lum, lum);
    c = lerp(c, grey, amber_strength * 0.65);

    // Apply amber color map: high R, moderate G, very low B
    float3 amberMap = float3(1.0, 0.72, 0.1);
    c = lerp(c, c * amberMap * 1.3, amber_strength * 0.7);

    // Halation — warm light bleed from highlights
    if (halation > 0.0) {
        float3 blurred = sampleHalation(v_in.uv, 4.0);
        float highlightMask = smoothstep(0.55, 1.0, luma(blurred));
        // Halation is warm-red biased
        float3 halationColor = float3(1.0, 0.55, 0.1);
        c += blurred * halationColor * highlightMask * halation * 0.8;
    }

    c = clamp(c, 0.0, 1.0);
    return float4(c, col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
