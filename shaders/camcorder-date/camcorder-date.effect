// J6 — camcorder-date
// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Old camcorder look — blinking REC dot, date-bar corner, scanlines, warm tint
// Chain order: apply last in chain, after all scene effects

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;
uniform texture2d image;
uniform float elapsed_time;

uniform float rec_x <
    string label = "REC X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.05;
uniform float rec_y <
    string label = "REC Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.05;
uniform float rec_size <
    string label = "REC size";
    string widget_type = "slider";
    float minimum = 0.005;
    float maximum = 0.03;
    float step = 0.001;
> = 0.012;
uniform float scanlines <
    string label = "Scanlines";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.25;
uniform float warmth <
    string label = "Warmth";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.4;
    float step = 0.01;
> = 0.15;
uniform float blink_speed <
    string label = "Blink speed";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 4.0;
    float step = 0.01;
> = 1.5;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float aspect = uv_size.x / max(uv_size.y, 1.0);

    float4 col = image.Sample(textureSampler, uv);

    // --- Warm tint ---
    col.r = saturate(col.r + warmth * 0.4);
    col.g = saturate(col.g + warmth * 0.15);
    col.b = saturate(col.b - warmth * 0.25);

    // --- Scanlines ---
    float lineF    = uv.y * uv_size.y;
    float scanPos  = frac(lineF * 0.5);
    float scanMask = smoothstep(0.0, 0.3, scanPos) * (1.0 - smoothstep(0.5, 0.8, scanPos));
    float scanDark = lerp(1.0, scanMask, scanlines);
    col.rgb *= scanDark;

    // --- Slight video noise ---
    float2 pixel = floor(uv * uv_size);
    float noise = Hash21(pixel + float2(floor(elapsed_time * 24.0), 0.0));
    col.rgb = saturate(col.rgb + (noise - 0.5) * 0.04);

    // --- Date bar (lower-right corner) ---
    // A dark semi-transparent horizontal stripe at the bottom 6% of screen
    float barH     = 0.06;
    float inBar    = step(1.0 - barH, uv.y) * step(uv.x, 0.55);
    col.rgb        = lerp(col.rgb, col.rgb * 0.35 + float3(0.0, 0.1, 0.05), inBar * 0.85);

    // Faux date text: bright pixelated dots inside bar region
    // Simulate 7-segment digit columns with coarse block pattern
    if (inBar > 0.5)
    {
        float barUvY = (uv.y - (1.0 - barH)) / max(barH, 0.001);
        float barUvX = uv.x / max(0.55, 0.001);
        float digitCol = floor(barUvX * 14.0);  // 14 character columns
        float digitRow = floor(barUvY * 7.0);   // 7 pixel rows
        float digitRand = Hash21(float2(digitCol, digitRow));
        float pixelOn = step(0.45, digitRand) * step(0.15, barUvY) * step(barUvY, 0.85);
        // Amber-green phosphor text color
        col.rgb = lerp(col.rgb, float3(0.7, 0.9, 0.3), pixelOn * 0.9);
    }

    // --- REC dot + blink ---
    float blink = step(0.5, frac(elapsed_time * blink_speed));

    // Distance from REC dot center (aspect-corrected)
    float2 recCenter = float2(rec_x, rec_y);
    float2 delta     = (uv - recCenter) * float2(aspect, 1.0);
    float  dist      = length(delta);

    float inDot = step(dist, rec_size) * blink;
    // Red filled circle
    col.rgb = lerp(col.rgb, float3(0.95, 0.05, 0.05), inDot);

    // REC text: two small pixel blocks to the right of the dot
    float textX = uv.x - (rec_x + rec_size * 1.8);
    float textY = abs(uv.y - rec_y);
    float inText = step(0.0, textX) * step(textX, rec_size * 3.5) * step(textY, rec_size * 0.6) * blink;
    col.rgb = lerp(col.rgb, float3(0.95, 0.95, 0.95), inText * 0.9);

    return float4(saturate(col.rgb), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
