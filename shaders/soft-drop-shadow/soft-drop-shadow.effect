// G3 — soft-drop-shadow
// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Renders a soft drop shadow offset from the source, requires alpha in source
// Chain order: Apply early; place before color grade, after any shape/mask shaders

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float shadow_offset_x <
    string label = "Shadow Offset X";
    string widget_type = "slider";
    float minimum = -0.05;
    float maximum = 0.05;
    float step = 0.001;
> = 0.015;

uniform float shadow_offset_y <
    string label = "Shadow Offset Y";
    string widget_type = "slider";
    float minimum = -0.05;
    float maximum = 0.05;
    float step = 0.001;
> = 0.02;

uniform float shadow_blur <
    string label = "Shadow Blur";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.02;
    float step = 0.001;
> = 0.008;

uniform float shadow_opacity <
    string label = "Shadow Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.6;

uniform float shadow_r <
    string label = "Shadow Red";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float shadow_g <
    string label = "Shadow Green";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float shadow_b <
    string label = "Shadow Blue";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.0;

uniform float2 uv_pixel_interval;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// Sample the alpha channel at a given UV (clamped).
float sampleAlpha(float2 uv)
{
    float2 suv = clamp(uv, 0.0, 1.0);
    return image.Sample(textureSampler, suv).a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Offset UV to sample the source alpha for the shadow.
    float2 shadow_uv = uv - float2(shadow_offset_x, shadow_offset_y);

    // Box-blur the shadow alpha using a 3x3 kernel scaled by shadow_blur.
    // Kernel step size in UV units.
    float  step_size = max(shadow_blur, 0.0001);
    float2 px        = uv_pixel_interval;
    float2 step_uv   = max(float2(step_size, step_size), px);

    float shadow_alpha = 0.0;
    shadow_alpha += sampleAlpha(shadow_uv + float2(-step_uv.x, -step_uv.y));
    shadow_alpha += sampleAlpha(shadow_uv + float2( 0.0,       -step_uv.y));
    shadow_alpha += sampleAlpha(shadow_uv + float2( step_uv.x, -step_uv.y));
    shadow_alpha += sampleAlpha(shadow_uv + float2(-step_uv.x,  0.0      ));
    shadow_alpha += sampleAlpha(shadow_uv + float2( 0.0,        0.0      ));
    shadow_alpha += sampleAlpha(shadow_uv + float2( step_uv.x,  0.0      ));
    shadow_alpha += sampleAlpha(shadow_uv + float2(-step_uv.x,  step_uv.y));
    shadow_alpha += sampleAlpha(shadow_uv + float2( 0.0,        step_uv.y));
    shadow_alpha += sampleAlpha(shadow_uv + float2( step_uv.x,  step_uv.y));
    shadow_alpha /= max(9.0, 0.001);

    // Shadow color and final alpha.
    float3 shadow_col = float3(shadow_r, shadow_g, shadow_b);
    float  s_alpha    = shadow_alpha * shadow_opacity;

    // Composite: shadow behind source using Porter-Duff "A over B".
    // Shadow is background, source is foreground.
    float  out_alpha = col.a + s_alpha * (1.0 - col.a);
    float3 out_rgb   = (col.rgb * col.a + shadow_col * s_alpha * (1.0 - col.a))
                       / max(out_alpha, 0.001);

    return float4(out_rgb, out_alpha);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
