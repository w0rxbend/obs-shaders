// L6 — desert-western
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Dry sandy western grade — yellow-orange push, lifted blacks, faded highlights, warm vignette
// Chain order: early in chain; pair with dust/grain overlays after

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float sand_tint <
    string label = "Sand Tint";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float black_lift <
    string label = "Black Lift";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.15;
    float step = 0.01;
> = 0.08;

uniform float fade <
    string label = "Fade";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.2;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c = col.rgb;

    c = c * (1.0 - black_lift) + black_lift;

    float highlight_ceiling = 1.0 - fade * 0.6;
    c = c * highlight_ceiling;

    float3 sandColor = float3(1.0, 0.88, 0.55);
    float tintStrength = sand_tint * 0.45;
    c = lerp(c, c * sandColor, tintStrength);

    // Blue falls faster than red so the edge reads warm, not cold.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (v_in.uv - float2(0.5, 0.5)) * float2(aspect, 1.0);
    float corner_len = 0.5 * length(float2(aspect, 1.0));
    float edge = length(from_center) / max(corner_len, 0.001);
    float vig = 1.0 - clamp(edge * 0.45, 0.0, 0.55);
    c *= float3(vig, vig * 0.96, vig * 0.88);

    return float4(saturate(c), col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
