// F5 — oil-paint
// Oil painting approximation using fixed 9-sample painterly averaging.
// The older runtime-sized bucket loops were expensive in live OBS scenes.

uniform float4x4 ViewProj;
uniform int radius = 3;  // 1 – 6   half-width of sampling window
uniform int levels = 8;  // 4 – 16  brightness quantisation buckets

uniform float2    uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float4 src = image.Sample(textureSampler, uv);
    float step_size = float(clamp(radius, 1, 6));
    float2 px = uv_pixel_interval * step_size;

    float4 s0 = image.Sample(textureSampler, uv + float2(-px.x, -px.y));
    float4 s1 = image.Sample(textureSampler, uv + float2( 0.0,  -px.y));
    float4 s2 = image.Sample(textureSampler, uv + float2( px.x, -px.y));
    float4 s3 = image.Sample(textureSampler, uv + float2(-px.x,  0.0));
    float4 s4 = src;
    float4 s5 = image.Sample(textureSampler, uv + float2( px.x,  0.0));
    float4 s6 = image.Sample(textureSampler, uv + float2(-px.x,  px.y));
    float4 s7 = image.Sample(textureSampler, uv + float2( 0.0,   px.y));
    float4 s8 = image.Sample(textureSampler, uv + float2( px.x,  px.y));

    float3 avg = (s0.rgb + s1.rgb + s2.rgb + s3.rgb + s4.rgb + s5.rgb + s6.rgb + s7.rgb + s8.rgb) / 9.0;
    float l = dot(avg, float3(0.299, 0.587, 0.114));
    float edge = length(src.rgb - avg);
    float lvls = float(clamp(levels, 4, 16));

    float3 paint = floor(avg * lvls + 0.5) / lvls;
    paint = lerp(paint, float3(l, l, l), saturate(edge * 0.45));
    paint = lerp(src.rgb, paint, 0.82);

    return float4(saturate(paint), src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
