// G10 — podcast-warm-grade
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Warm, soft "podcast studio" look: warm tint, boosted saturation, lifted shadows, gentle vignette
// Chain order: Apply as a final color grade; place after any corrective shaders

uniform float warmth <
    string label = "Warmth";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.35;

uniform float saturation <
    string label = "Saturation";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.2;

uniform float shadow_lift <
    string label = "Shadow Lift";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.2;
    float step = 0.01;
> = 0.05;

uniform float vignette <
    string label = "Vignette";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.25;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float3 rgb = col.rgb;

    // --- Shadow lift: raise darkest tones so blacks become dark gray ---
    rgb = rgb * (1.0 - shadow_lift) + shadow_lift;

    // --- Saturation boost: blend toward luma value ---
    float lum = dot(rgb, float3(0.299, 0.587, 0.114));
    float3 gray = float3(lum, lum, lum);
    rgb = lerp(gray, rgb, saturation);

    // --- Warm tint: orange-amber shift ---
    // Boost red & green slightly, reduce blue.
    rgb.r = saturate(rgb.r + warmth * 0.18);
    rgb.g = saturate(rgb.g + warmth * 0.07);
    rgb.b = saturate(rgb.b - warmth * 0.15);

    // --- Gentle vignette: darken corners ---
    float2 centered = uv - 0.5;
    float  dist     = length(centered);
    float  vig      = smoothstep(0.35, 0.85, dist) * vignette;
    rgb *= (1.0 - vig);

    return float4(saturate(rgb), col.a);
}
