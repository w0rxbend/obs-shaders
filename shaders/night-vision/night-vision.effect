// D6 — night-vision
// Classic night vision green: desaturate, boost green, scanlines, noise.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float    elapsed_time;

uniform float green_strength = 0.8;
uniform float noise_amount   = 0.08;
uniform bool  scanlines      = true;
uniform float vignette       = 0.5;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    // Desaturate
    float luma = dot(col.rgb, float3(0.299, 0.587, 0.114));

    // Map luma to green channel — output is (low_g, green, low_b)
    float greenOut = luma * (1.0 + green_strength * 0.8);
    float3 nvBase  = float3(luma * 0.1, saturate(greenOut), luma * 0.05);

    // Scanlines
    float scanVal = 1.0;
    if (scanlines) {
        // Every other pixel row dims slightly
        float line    = floor(uv.y * 540.0); // ~540 lines reference
        scanVal       = (frac(line * 0.5) < 0.5) ? 0.75 : 1.0;
    }
    nvBase *= scanVal;

    // Animated noise
    float2 noiseCoord = uv * float2(320.0, 240.0);
    float  noiseSeed  = floor(elapsed_time * 24.0); // 24fps grain change
    float  n          = hash21(floor(noiseCoord) + float2(noiseSeed * 17.3, noiseSeed * 31.1));
    // Bias noise so it mostly brightens
    float noiseOffset = (n - 0.3) * noise_amount;
    nvBase.g          = saturate(nvBase.g + noiseOffset);

    // Vignette
    float2 centered = uv - 0.5;
    float  vigDist  = dot(centered, centered) * 4.0;
    nvBase          = nvBase * (1.0 - saturate(vigDist) * vignette);

    return float4(saturate(nvBase), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
