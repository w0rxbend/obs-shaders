// B5 — rgb-anaglyph
// Fake 3D red-cyan anaglyph — shifts R channel left, GB channels right.
// separation    : horizontal UV offset (0.0–0.05, default 0.008)
// vertical_shift: vertical UV offset   (0.0–0.02,  default 0.0)

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float separation <
    string label = "Separation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.008;
uniform float vertical_shift <
    string label = "Vertical Shift";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.02;
    float step = 0.001;
> = 0.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Left eye (red): shift UV left and slightly up
    float2 uvLeft  = saturate(uv + float2(-separation,  vertical_shift));
    // Right eye (cyan): shift UV right and slightly down
    float2 uvRight = saturate(uv + float2( separation, -vertical_shift));

    float4 colLeft  = image.Sample(textureSampler, uvLeft);
    float4 colRight = image.Sample(textureSampler, uvRight);
    float source_alpha = image.Sample(textureSampler, uv).a;

    float3 rgb = saturate(float3(colLeft.r, colRight.g, colRight.b));
    return float4(rgb, source_alpha);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
