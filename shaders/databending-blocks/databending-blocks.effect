// N7 — databending-blocks
// Performance: low
// Webcam safe: no
// Preserves alpha: yes
// Use case: Data-corruption aesthetic — image split into blocks with random UV offsets
// Chain order: Last or near-last in chain; pair with chromatic-aberration or digital-noise

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float elapsed_time;

uniform float block_size <
    string label = "Block Size";
    string widget_type = "slider";
    float minimum = 4.0;
    float maximum = 32.0;
    float step = 1.0;
> = 10.0;
uniform float corruption <
    string label = "Corruption";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.3;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 5.0;
    float step = 0.01;
> = 2.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash1(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float hash1f(float v)
{
    return frac(sin(v * 74.3321) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // block_size is hundredths of UV so the slider stays in a small numeric range
    float invScale = max(block_size / 100.0, 0.001);
    float2 blockCoord = floor(uv / invScale);

    float timeSlot = floor(elapsed_time * speed);
    float seed = hash1(blockCoord + float2(timeSlot * 1.37, timeSlot * 0.71));

    float2 sampleUV = uv;
    if (seed < corruption)
    {
        float ox = (hash1f(seed * 13.7) * 2.0 - 1.0) * 0.25;
        float oy = (hash1f(seed * 27.3) * 2.0 - 1.0) * 0.1;
        sampleUV = clamp(uv + float2(ox, oy), 0.0, 1.0);
    }

    float4 col = image.Sample(textureSampler, sampleUV);
    if (seed < corruption * 0.3)
        col.rgb = col.brg;

    col.rgb = saturate(col.rgb);
    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
