// L3 — day-for-night
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Convert daytime footage to moonlit night — darken, desaturate, blue-cyan push, vignette
// Chain order: early in chain; combine with noise/grain after

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float darkness <
    string label = "Darkness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.55;

uniform float blue_push <
    string label = "Blue Push";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

uniform float desat <
    string label = "Desaturate";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float vignette <
    string label = "Vignette";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.4;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c   = col.rgb;

    // Darken
    float darken_factor = 1.0 - darkness * 0.75;
    c *= darken_factor;

    // Desaturate
    float lum = luma(c);
    float3 grey = float3(lum, lum, lum);
    c = lerp(c, grey, desat);

    // Blue-cyan push: lift blue channel, slight cyan in midtones
    c.b += blue_push * 0.35;
    c.g += blue_push * 0.08;
    c.r -= blue_push * 0.10;

    // Vignette
    float2 uv = v_in.uv;
    float2 centered = uv - float2(0.5, 0.5);
    float vd = dot(centered, centered) * 2.0;
    float vig = 1.0 - clamp(vd * vignette * 1.2, 0.0, 1.0);
    c *= vig;

    c = saturate(c);
    return float4(c, col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
