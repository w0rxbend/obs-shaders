// J7 — cctv-surveillance
// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: CCTV/security camera look — desaturated, slight fisheye, scanlines, timestamp bar, noise
// Chain order: apply last in chain as a complete look transform

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;
uniform float2 uv_pixel_interval;

uniform float fisheye <
    string label = "Fisheye";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.1;

uniform float scanlines <
    string label = "Scanlines";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.35;

uniform float noise_amount <
    string label = "Noise Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.2;
    float step = 0.01;
> = 0.07;

uniform float desat <
    string label = "Desaturation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.7;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

// Radial bulge in pixel space so the lens stays round when the frame is not square.
float2 FisheyeWarp(float2 uv, float amount)
{
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - 0.5;
    from_center.x *= aspect;
    float dist2 = dot(from_center, from_center);
    float2 offset = from_center * dist2 * amount * 3.5;
    offset.x /= max(aspect, 0.001);
    return uv + offset;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float2 warped_uv = FisheyeWarp(uv, fisheye);
    float4 col = image.Sample(textureSampler, saturate(warped_uv));

    // Lens cutoff stays black, but the source alpha is the sampled edge, not a forced 1.
    if (warped_uv.x < 0.0 || warped_uv.x > 1.0 || warped_uv.y < 0.0 || warped_uv.y > 1.0)
        return float4(0.0, 0.0, 0.0, col.a);

    float luma = dot(col.rgb, float3(0.299, 0.587, 0.114));
    col.rgb = lerp(col.rgb, float3(luma, luma, luma), desat);

    // Security-camera phosphor, scaled by how far the grade is pushed.
    col.rgb += float3(-0.02, 0.04, -0.02) * desat;

    float2 pixel = max(uv_pixel_interval, float2(0.001, 0.001));
    float line_f = uv.y / pixel.y;
    float scan_pos = frac(line_f * 0.5);
    float scan_mask = smoothstep(0.0, 0.3, scan_pos) * (1.0 - smoothstep(0.5, 0.8, scan_pos));
    col.rgb *= lerp(1.0, scan_mask, scanlines);

    float2 noise_px = floor(uv / pixel);
    float noise = Hash21(noise_px + float2(floor(elapsed_time * 30.0), 0.0));
    col.rgb = saturate(col.rgb + (noise - 0.5) * noise_amount * 2.0);

    float2 vig = uv - 0.5;
    float vig_dist = dot(vig, vig);
    float vignette = 1.0 - smoothstep(0.15, 0.55, vig_dist * 3.0);
    col.rgb *= lerp(1.0, vignette, 0.5);

    float bar_h = 0.055;
    float in_bar = step(1.0 - bar_h, uv.y);
    col.rgb = lerp(col.rgb, col.rgb * 0.25 + float3(0.0, 0.08, 0.04), in_bar * 0.9);

    if (in_bar > 0.5)
    {
        float bar_uv_y = (uv.y - (1.0 - bar_h)) / max(bar_h, 0.001);
        float char_col = floor(uv.x * 20.0);
        float char_row = floor(bar_uv_y * 6.0);
        float char_rand = Hash21(float2(char_col * 1.3, char_row * 2.7));
        float pix_on = step(0.4, char_rand) * step(0.1, bar_uv_y) * step(bar_uv_y, 0.9)
            * step(uv.x, 0.65);
        col.rgb = lerp(col.rgb, float3(0.2, 0.95, 0.35), pix_on * 0.85);
    }

    return float4(saturate(col.rgb), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
