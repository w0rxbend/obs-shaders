// L1 — teal-and-orange
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Hollywood blockbuster look — shadows teal, highlights/midtones orange
// Chain order: early in chain, before grain or bloom

uniform float4x4 ViewProj;
uniform float strength   = 0.6; // 0.0 – 1.0
uniform float teal_depth = 0.5; // 0.0 – 1.0
uniform float orange_lift = 0.5; // 0.0 – 1.0

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float luma(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c   = col.rgb;

    float lum = luma(c);

    // Shadow region weight (dark pixels → teal)
    float shadowW = 1.0 - smoothstep(0.0, 0.5, lum);
    // Highlight/midtone region weight (bright pixels → orange)
    float highlightW = smoothstep(0.25, 1.0, lum);

    // Teal target: push R down, G and B up
    float3 tealColor   = float3(0.0, 0.85, 0.85);
    // Orange target: push R and G up, B down
    float3 orangeColor = float3(1.0, 0.6, 0.15);

    float3 result = c;

    // Push shadows toward teal
    result = lerp(result, result * tealColor * 1.6, shadowW * teal_depth * strength);
    // Push highlights toward orange
    result = lerp(result, lerp(result, result * orangeColor * 1.4, highlightW), highlightW * orange_lift * strength);

    // Clamp and preserve alpha
    result = clamp(result, 0.0, 1.0);
    return float4(result, col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
