// C7 — projector-flicker
// Organic brightness flicker simulating an unstable projector lamp.

uniform float intensity = 0.15; // 0.0 – 0.5
uniform float speed     = 8.0;  // 1.0 – 20.0

uniform texture2d image;
uniform float elapsed_time;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

// Multi-frequency flicker for organic feel
float FlickerBrightness(float t, float spd, float amount)
{
    float f = t * spd;
    // Several harmonics with incommensurable ratios avoid periodicity
    float flicker = sin(f * 1.000)       * 0.40
                  + sin(f * 2.300 + 0.7) * 0.25
                  + sin(f * 5.700 + 1.3) * 0.15
                  + sin(f * 11.30 + 2.1) * 0.10
                  + sin(f * 17.70 + 0.4) * 0.10;
    // Normalise to [-1,1] then scale
    flicker = flicker / (0.40 + 0.25 + 0.15 + 0.10 + 0.10);
    return 1.0 + flicker * amount;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float brightness = FlickerBrightness(elapsed_time, speed, intensity);
    col.rgb = saturate(col.rgb * brightness);

    return float4(col.rgb, col.a);
}
