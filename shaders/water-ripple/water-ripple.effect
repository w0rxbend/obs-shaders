// B10 — water-ripple
// Concentric water ripple expanding from a configurable center point (animated).
// speed     : ripple expansion speed   (0.0–5.0,  default 2.0)
// frequency : number of ripple rings   (5.0–50.0, default 20.0)
// strength  : displacement magnitude   (0.0–0.05, default 0.02)
// center_x  : ripple origin X          (0.0–1.0,  default 0.5)
// center_y  : ripple origin Y          (0.0–1.0,  default 0.5)

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 5.0;
    float step = 0.01;
> = 2.0;

uniform float frequency <
    string label = "Frequency";
    string widget_type = "slider";
    float minimum = 5.0;
    float maximum = 50.0;
    float step = 0.1;
> = 20.0;

uniform float strength <
    string label = "Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.02;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float elapsed_time;
uniform float2 uv_size;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float2 center = float2(center_x, center_y);

    // Height-normalized so rings stay circular on a widescreen source.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 delta = uv - center;
    float2 delta_screen = float2(delta.x * aspect, delta.y);
    float radius = length(delta_screen);
    float2 dir_screen = delta_screen / max(radius, 0.001);
    float2 dir = float2(dir_screen.x / max(aspect, 0.001), dir_screen.y);

    // Period 1 matches the tau below. Wrap so a long stream does not feed sin a huge argument.
    float travel = fmod(elapsed_time * speed, 1.0);
    float phase = radius * frequency - travel;
    float ripple = sin(phase * 6.28318530718);

    // radius * exp peaks away from the center, so the origin does not pinch.
    float atten = radius * exp(-radius * 4.0);
    float2 uv_warp = clamp(uv + dir * ripple * atten * strength, 0.0, 1.0);
    return image.Sample(textureSampler, uv_warp);
}
