// E4 — horizontal-tearing
// Horizontal tearing bands: the image shifts left/right per band, randomly.
// band_count  : number of horizontal bands (1.0–20.0, default 8.0)
// tear_amount : max horizontal shift in UV units (0.0–0.1, default 0.02)
// speed       : band update rate in ticks/sec (0.5–10.0, default 3.0)
// probability : fraction of bands that tear at once (0.0–1.0, default 0.2)

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float band_count <
    string label = "Band Count";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 20.0;
    float step = 1.0;
> = 8.0;
uniform float tear_amount <
    string label = "Tear Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.1;
    float step = 0.001;
> = 0.02;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 10.0;
    float step = 0.1;
> = 3.0;
uniform float probability <
    string label = "Probability";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.2;

uniform float elapsed_time;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    float tick = floor(elapsed_time * speed);

    // Which band are we in?
    float bandIndex = floor(uv.y * band_count);

    // Hash band + tick to get stable-per-tick randomness
    float h = hash2(float2(bandIndex, tick));

    // Gate: only tear if hash exceeds (1 - probability)
    float gate = step(1.0 - probability, h);

    // Direction and magnitude
    float h2    = hash2(float2(bandIndex * 1.7, tick + 0.5));
    float shift = (h2 * 2.0 - 1.0) * tear_amount * gate;

    float2 tornUV = float2(saturate(uv.x + shift), saturate(uv.y));

    float4 color = image.Sample(textureSampler, tornUV);
    return float4(saturate(color.rgb), color.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
