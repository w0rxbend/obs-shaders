// Floating Webcam Drift
// Soft looping drift for webcam sources.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;

uniform float speed = 0.35;
uniform float amount = 1.0;
uniform float zoom_compensation = 0.04;
uniform float center_x = 0.5;
uniform float center_y = 0.5;
uniform bool strong_preset = false;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv;
    return vert_out;
}

float4 mainImage(VertData v_in) : TARGET
{
    float t = elapsed_time * speed;
    float preset = strong_preset ? 3.2 : 1.0;
    float2 center = float2(center_x, center_y);
    float2 drift = float2(sin(t), cos(t * 0.73 + 0.8)) * 0.012 * amount * preset;
    drift += float2(sin(t * 0.31 + 2.1), cos(t * 0.41)) * 0.005 * amount * preset;
    float zoom = 1.0 + max(0.0, zoom_compensation) + length(drift) * 2.5;

    float2 uv = center + (v_in.uv - center) / zoom - drift;
    return image.Sample(textureSampler, clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0)));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
