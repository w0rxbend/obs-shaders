// E10 — signal-loss-pulse
// Periodic complete signal loss: the image cuts to static/noise for a short
// window then recovers, like a broadcast dropout.
// loss_frequency : how many loss events per second (0.1–2.0, default 0.5)
// loss_duration  : fraction of each cycle that is "lost" (0.0–1.0, default 0.2)
// noise_color    : false = white noise, true = phosphor-green noise

uniform float loss_frequency <
    string label = "Loss Frequency";
    string widget_type = "slider";
    float minimum = 0.1;
    float maximum = 2.0;
    float step = 0.01;
> = 0.5;

uniform float loss_duration <
    string label = "Loss Duration";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.2;

uniform bool noise_color = false;

uniform float elapsed_time;
uniform float2 uv_size;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float hash1(float t)
{
    return frac(sin(t * 127.1) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float aspect = uv_size.x / max(uv_size.y, 1.0);

    // Cycle position within one loss period [0, 1)
    float cycleT = frac(elapsed_time * loss_frequency);

    // Are we in the loss window?
    float inLoss = step(cycleT, loss_duration);

    // Animated noise tick — fast, feels like real static
    float tick = floor(elapsed_time * 60.0);

    // Generate static noise at this pixel
    float column = floor(uv.x * 180.0 * aspect);
    float row = floor(uv.y * 180.0);
    float n1 = hash2(float2(column, row) + tick);
    float n2 = hash2(float2(column + 1.0, row) + tick * 0.7);
    // Mix two noise octaves for richer static texture
    float noise = lerp(n1, n2, 0.5);

    float3 staticColor;
    if (noise_color)
    {
        // Phosphor-green static
        staticColor = float3(noise * 0.1, noise, noise * 0.15);
    }
    else
    {
        // White/grey static with some variation
        float grey = lerp(0.1, 0.95, noise);
        staticColor = float3(grey, grey, grey);
    }

    // Add horizontal roll artifact during loss: shift rows
    float rollShift = hash1(floor(uv.y * 64.0) + tick * 0.3) * 0.04 - 0.02;
    float2 rollUV = float2(saturate(uv.x + rollShift * inLoss), uv.y);

    float4 orig = image.Sample(textureSampler, rollUV);

    // Soft edges. smoothstep divides by the span, so a zero duration must not collapse it.
    float fadeWidth = min(loss_duration * 0.15, 0.03);
    float edge = max(fadeWidth, 0.001);
    float rise = smoothstep(0.0, edge, cycleT);
    float fallStart = max(loss_duration - edge, 0.0);
    float fallEnd = max(loss_duration, edge);
    float fall = 1.0 - smoothstep(fallStart, fallEnd, cycleT);
    float lossBlend = saturate(inLoss * rise * fall);

    float3 col = lerp(orig.rgb, saturate(staticColor), lossBlend);

    return float4(saturate(col), orig.a);
}
