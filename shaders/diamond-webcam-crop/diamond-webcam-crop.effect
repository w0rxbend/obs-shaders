// O3 — diamond-webcam-crop
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Crops webcam feed to a diamond (rotated square) shape; outside = alpha 0
// Chain order: Apply first in chain before any color grading

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float size <
    string label = "Size";
    string widget_type = "slider";
    float minimum = 0.1;
    float maximum = 0.8;
    float step = 0.01;
> = 0.45;
uniform float softness <
    string label = "Edge Softness";
    string widget_type = "slider";
    float minimum = 0.001;
    float maximum = 0.05;
    float step = 0.001;
> = 0.008;
uniform float aspect <
    string label = "Horizontal Stretch";
    string widget_type = "slider";
    float minimum = 0.5;
    float maximum = 2.0;
    float step = 0.01;
> = 1.0;

uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// Diamond SDF: L1 norm distance from origin
// Returns signed distance; negative = inside, positive = outside
float sdfDiamond(float2 p, float r)
{
    // Height-fraction space keeps a rotated square on a non-square webcam.
    // aspect > 1 stretches that square horizontally.
    float frame_aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 scaled = float2(p.x * frame_aspect / max(aspect, 0.001), p.y);
    return dot(abs(scaled), float2(1.0, 1.0)) - r;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 col = image.Sample(textureSampler, uv);

    float2 from_center = uv - float2(0.5, 0.5);
    float dist = sdfDiamond(from_center, size);
    float edge = max(softness, 0.001);
    float mask = 1.0 - smoothstep(-edge, edge, dist);

    col.a *= mask;
    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
