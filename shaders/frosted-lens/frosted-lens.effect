// Frosted lens
// Small-kernel diffusion through a milky lens, stronger away from center.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float diffusion <
    string label = "Diffusion";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.70;

uniform float radius <
    string label = "Radius";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 8.0;
    float step = 0.1;
> = 3.5;

uniform float veil <
    string label = "Veil";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.40;

uniform texture2d image;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float3 DiffuseKernel(float2 uv, float2 texel_step)
{
    float3 sum_rgb = float3(0.0, 0.0, 0.0);
    // Fixed 3x3. The divisor below stays 9.
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            float2 offset = float2(float(x), float(y)) * texel_step;
            sum_rgb += image.Sample(textureSampler, uv + offset).rgb;
        }
    }
    return sum_rgb / max(9.0, 0.001);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(0.5, 0.5);
    from_center.x *= aspect;
    float edge = saturate(length(from_center));

    float2 texel = float2(1.0 / max(uv_size.x, 0.001), 1.0 / max(uv_size.y, 0.001));
    float3 diffused = DiffuseKernel(uv, texel * radius);

    // Center weight stays low so a talking head remains readable.
    float frost_mix = saturate(diffusion * lerp(0.28, 1.0, edge));
    float3 milky = lerp(source.rgb, diffused, frost_mix);

    float luma = dot(source.rgb, float3(0.299, 0.587, 0.114));
    float highlight = saturate((luma - 0.62) / max(0.38, 0.001));
    float3 cool_milk = float3(0.84, 0.91, 0.98);
    float veil_mix = saturate(veil * highlight * lerp(0.45, 1.0, edge));
    float3 frosted = saturate(lerp(milky, cool_milk, veil_mix));

    return float4(frosted, source.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
