// C6 — film-gate-jitter
// Horizontal and vertical frame jitter, frame-locked (discontinuous).

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float h_jitter <
    string label = "Horizontal Jitter";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.02;
    float step = 0.001;
> = 0.005;

uniform float v_jitter <
    string label = "Vertical Jitter";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.02;
    float step = 0.001;
> = 0.003;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 10.0;
    float step = 0.1;
> = 4.0;

uniform texture2d image;
uniform float elapsed_time;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash11(float x)
{
    return frac(sin(x * 127.1) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Wrap the frame index so the hash does not go flat on a long stream.
    float frame = floor(elapsed_time * speed);
    float tick = fmod(frame, 1024.0);

    float hRand = Hash11(tick) - 0.5;
    float vRand = Hash11(tick + 73.1) - 0.5;

    // Occasional larger lurch (~10% of frames)
    float lurchH = step(0.90, Hash11(tick + 200.0)) * (Hash11(tick + 201.0) - 0.5) * 3.0;
    float lurchV = step(0.93, Hash11(tick + 300.0)) * (Hash11(tick + 301.0) - 0.5) * 3.0;

    hRand += lurchH;
    vRand += lurchV;

    uv.x += hRand * h_jitter * 2.0;
    uv.y += vRand * v_jitter * 2.0;

    float4 col = image.Sample(textureSampler, saturate(uv));
    return col;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
