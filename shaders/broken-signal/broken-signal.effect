// E8 — broken-signal
// Simulates a broken broadcast signal: colour corruption, occasional
// full-frame white flashes, and animated noise overlay.
// corruption   : base level of colour corruption (0.0–1.0, default 0.3)
// flash_speed  : how often white flashes occur (0.0–5.0, default 2.0)
// noise_amount : static noise overlay intensity (0.0–0.5, default 0.2)

uniform float corruption    = 0.3;
uniform float flash_speed   = 2.0;
uniform float noise_amount  = 0.2;

uniform float elapsed_time;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

float hash1(float t)
{
    return frac(sin(t * 127.1) * 43758.5453);
}

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // --- Animated tick ---
    float tick     = floor(elapsed_time * 60.0);
    float slowTick = floor(elapsed_time * flash_speed);

    // --- Full-frame white flash ---
    float flashH   = hash1(slowTick * 0.4173);
    // Flash fires when hash > 0.92 (rare)
    float flash    = step(0.92, flashH);
    // Flash decays within its tick — use fractional time within tick period
    float flashDecay = 1.0 - frac(elapsed_time * flash_speed);
    float flashAmt   = flash * flashDecay * flashDecay;

    // --- Colour corruption: random horizontal offset per scanline band ---
    float band      = floor(uv.y * 24.0);
    float bandTick  = floor(elapsed_time * 8.0);
    float bandH     = hash2(float2(band, bandTick));
    float bandActive = step(1.0 - corruption, bandH);
    float bandShift  = (hash2(float2(band * 1.3, bandTick + 1.0)) * 2.0 - 1.0)
                       * 0.06 * bandActive;

    float2 shiftedUV = float2(saturate(uv.x + bandShift), uv.y);
    float4 orig      = image.Sample(textureSampler, shiftedUV);
    float3 col       = orig.rgb;

    // RGB desync on corrupted bands
    float rOff = bandShift * 1.5;
    float bOff = -bandShift * 1.2;
    float r    = image.Sample(textureSampler, float2(saturate(uv.x + rOff), uv.y)).r;
    float b    = image.Sample(textureSampler, float2(saturate(uv.x + bOff), uv.y)).b;
    col.r = lerp(col.r, r, bandActive * corruption);
    col.b = lerp(col.b, b, bandActive * corruption);

    // --- Static noise overlay ---
    float noise = hash2(float2(floor(uv.x * 320.0), floor(uv.y * 180.0)) + tick);
    col = saturate(col + (noise * 2.0 - 1.0) * noise_amount);

    // --- Apply flash ---
    col = lerp(col, float3(1.0, 1.0, 1.0), flashAmt);

    return float4(col, orig.a);
}
