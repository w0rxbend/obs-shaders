// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Image burns away with fiery orange-yellow edge as it dissolves
// Chain order: Apply last; pair with fire-heat-distortion for full burn look

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float progress   = 0.5;  // 0.0 = fully visible, 1.0 = fully burned away
uniform float edge_width = 0.04; // 0.0–0.1 width of glowing fire edge
uniform float fire_r     = 1.0;  // fire color R
uniform float fire_g     = 0.4;  // fire color G
uniform float fire_b     = 0.0;  // fire color B

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv;
    return vert_out;
}

float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float noise2d(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    float a  = hash2(i + float2(0.0, 0.0));
    float b  = hash2(i + float2(1.0, 0.0));
    float c  = hash2(i + float2(0.0, 1.0));
    float d  = hash2(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float fbm(float2 p)
{
    float v = 0.0;
    v += 0.60 * noise2d(p);
    v += 0.30 * noise2d(p * 2.1 + float2(3.7, 1.3));
    v += 0.10 * noise2d(p * 4.3 + float2(7.1, 5.9));
    return v;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv      = v_in.uv;
    float4 color   = image.Sample(textureSampler, uv);

    float n        = fbm(uv * 4.0);

    // Burned region: n < progress (fully transparent)
    // Fire edge:     n is within edge_width above progress
    // Visible:       n > progress + edge_width

    float ew       = max(edge_width, 0.001);
    float softness = 0.01;

    // Alpha: 0 where burned, 1 where visible
    float alpha    = smoothstep(progress - softness, progress + softness, n);
    // Fire intensity: 1 at the burn edge, fading inward and outward
    float fireMask = smoothstep(progress - softness,  progress + softness, n)
                   * (1.0 - smoothstep(progress + ew - softness, progress + ew + softness, n));

    // Blend: fire replaces image color at the edge
    float3 fireColor = float3(fire_r, fire_g, fire_b);
    // Brighten fire toward tip
    float  tip        = 1.0 - smoothstep(progress, progress + ew, n);
    fireColor        += float3(1.0, 0.8, 0.0) * tip * 0.6;

    color.rgb = lerp(color.rgb, fireColor, fireMask);
    color.a  *= alpha;

    return color;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
