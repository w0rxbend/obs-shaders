// Filename: shader_144_blackout_pulse.effect
// Category: Extreme / transition expansion
// Effect: Blackout pulse
// Visual principle: a radial blackout blooms from the chosen center on a beat under 3 Hz, then recedes.
// What makes it cool: the source cuts to black on a short pulse and stays readable between hits.
// Suggested source type: screen capture, browser source, IDEs, dashboards, documents
// Suggested shader-chain combinations: soft vignette -> this shader -> subtle noise or scanline overlay
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.5;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 delta = (uv - center) * float2(aspect, 1.0);
    float radius = length(delta);
    float2 corner = float2(max(center.x, 1.0 - center.x) * aspect, max(center.y, 1.0 - center.y));
    float span = max(length(corner), 0.001);

    // speed is hertz. 2.5 keeps a full-frame black under 3 flashes per second.
    float pulse_hz = min(max(speed, 0.0), 2.5);
    float phase = frac(fmod(max(elapsed_time, 0.0), 1024.0) * pulse_hz);
    float from_peak = min(phase, 1.0 - phase);
    float cover = saturate(amount * 0.5);
    float half_width = max(lerp(0.06, 0.18, cover), 0.001);
    float open_amount = saturate(1.0 - from_peak / half_width);
    float lobe = smoothstep(0.0, 0.35, open_amount) * step(0.001, pulse_hz);

    // 1.85 * default amount/2 reaches just past the far corner at the pulse peak.
    float reach = span * cover * 1.85 * lobe;
    float shade = saturate((reach - radius) / max(0.05, 0.001));
    float darkness = shade * saturate(intensity);
    float3 pulsed = lerp(color.rgb, color.rgb * (1.0 - darkness), saturate(opacity));
    return float4(saturate(pulsed), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
