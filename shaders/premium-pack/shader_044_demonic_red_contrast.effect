// Filename: shader_044_demonic_red_contrast.effect
// Category: Horror / supernatural pack
// Effect: Demonic red contrast
// Visual principle: crushed shadows, color-biased darkness, pulse timing, and unstable edges.
// What makes it cool: it adds dread by making the frame feel reactive and contaminated.
// Suggested source type: webcam, horror games, video source, dramatic scenes
// Suggested shader-chain combinations: this shader -> ghost double image -> dark vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);

    // Scale x by aspect so the unstable rim stays circular on widescreen.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float reach = max(length(float2(aspect * 0.5, 0.5)), 0.001);
    float edge = smoothstep(0.42, 1.12, length(from_center) / reach);

    // Wrap the clock so a long stream does not freeze the pulse phase.
    float clock = elapsed_time - floor(elapsed_time * (1.0 / 120.0)) * 120.0;
    float pulse = 0.5 + 0.5 * sin(clock * speed * 1.5);

    float step_id = floor(clock * speed * 2.0);
    float2 cell = floor(uv * max(uv_size, float2(1.0, 1.0)) / 12.0);
    float n0 = hash12(cell + float2(step_id, 1.0));
    float n1 = hash12(cell + float2(4.0, step_id));
    float edge_amp = edge * 5.0 * intensity * (0.45 + 0.55 * pulse);
    float2 edge_uv = clamp(uv + (float2(n0, n1) - 0.5) * uv_pixel_interval * edge_amp, 0.0, 1.0);
    float3 sampled = lerp(color.rgb, image.Sample(textureSampler, edge_uv).rgb, edge);

    float gray = luma3(sampled);
    float shadow = 1.0 - smoothstep(0.04, 0.40, gray);
    float contrast = 1.0 + (0.34 + 0.12 * pulse) * intensity * 0.55;
    float3 crushed = (sampled - 0.5) * contrast + 0.5;
    crushed -= shadow * 0.05 * intensity * (0.65 + 0.35 * pulse);

    float red_w = saturate((0.16 + shadow * 0.50) * amount * 0.62 * (0.70 + 0.30 * pulse));
    float3 red_cast = float3(crushed.r + 0.10, crushed.g * 0.62, crushed.b * 0.42);
    float3 graded = lerp(crushed, red_cast, red_w);
    graded.r += shadow * 0.05 * amount * (0.55 + 0.45 * pulse);
    graded *= lerp(1.0, 0.78, edge * 0.40 * intensity);

    graded = saturate(graded);
    float3 out_rgb = lerp(color.rgb, graded, saturate(opacity));
    return float4(out_rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
