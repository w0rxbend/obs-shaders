// Filename: shader_008_corporate_presentation_blur.effect
// Category: Confidential / privacy pack
// Effect: Corporate presentation blur
// Visual principle: wide slide defocus, mild glyph quantization, cool projector grade, and slow grain.
// What makes it cool: it hides readable details but leaves the audience aware that real content exists underneath.
// Suggested source type: screen capture, browser source, IDEs, dashboards, documents
// Suggested shader-chain combinations: soft vignette -> this shader -> subtle noise or scanline overlay
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);
    float2 pixels = max(uv_size, float2(1.0, 1.0));
    float aspect = pixels.x / max(pixels.y, 1.0);
    float kernel = saturate(amount * 0.5);
    float crush = clamp(intensity, 0.0, 2.0);

    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float falloff = saturate(length(from_center) / 0.72);
    float radius = lerp(16.0, 42.0, kernel) * lerp(0.45, 1.15, falloff);
    float block = lerp(8.0, 20.0, kernel);
    float2 cells = max(float2(1.0, 1.0), pixels / max(block, 0.001));
    float2 phase = float2(center_x, center_y);
    float2 quant_uv = (floor(uv * cells + phase) + 0.5 - phase) / max(cells, float2(0.001, 0.001));
    quant_uv = clamp(quant_uv, 0.0, 1.0);

    float2 step = max(uv_pixel_interval, float2(0.001, 0.001)) * radius;
    float2 cardinal_x = float2(step.x, 0.0);
    float2 cardinal_y = float2(0.0, step.y);

    // Diagonal taps are folded into the center so the shader stays at 6 samples.
    float4 blur = image.Sample(textureSampler, quant_uv) * 0.52;
    blur += image.Sample(textureSampler, clamp(quant_uv + cardinal_x, 0.0, 1.0)) * 0.12;
    blur += image.Sample(textureSampler, clamp(quant_uv - cardinal_x, 0.0, 1.0)) * 0.12;
    blur += image.Sample(textureSampler, clamp(quant_uv + cardinal_y, 0.0, 1.0)) * 0.12;
    blur += image.Sample(textureSampler, clamp(quant_uv - cardinal_y, 0.0, 1.0)) * 0.12;

    float gray = luma3(blur.rgb);
    float3 slate = float3(0.78, 0.84, 0.90);
    float3 deck = lerp(blur.rgb, slate * (0.55 + gray * 0.55), saturate(0.18 * crush));
    deck = lerp(deck, float3(gray, gray, gray), saturate(0.28 * crush));
    float tick = floor(elapsed_time * max(speed, 0.0) * 2.0);
    float grain = hash12(floor(uv * pixels / max(block, 0.001)) + tick);
    deck += (grain - 0.5) * 0.06 * min(crush, 1.5);

    float cover = saturate(lerp(0.92, 1.0, falloff) * saturate(opacity));
    float3 out_rgb = lerp(color.rgb, deck, cover);
    return float4(saturate(out_rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
