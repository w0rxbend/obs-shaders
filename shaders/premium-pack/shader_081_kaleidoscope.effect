// Filename: shader_081_kaleidoscope.effect
// Category: Experimental art pack
// Effect: Kaleidoscope
// Visual principle: fold the frame into mirrored wedges around a center and spin that pattern slowly.
// What makes it cool: the border becomes a live kaleidoscope while the talking head stays readable.
// Suggested source type: webcam, image source, video source, VJ visuals
// Suggested shader-chain combinations: this shader -> posterize or halftone -> light vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 origin = float2(center_x, center_y);
    float2 from_center = uv - origin;
    from_center.x *= aspect;

    float radius = length(from_center);
    float period = 6.28318530718;
    float slices = 4.0 + floor(saturate(amount * 0.5) * 6.0);
    float slice = period / max(slices, 0.001);
    float ang = atan2(from_center.y, from_center.x) + fmod(elapsed_time * speed, period);
    float sector = fmod(ang, slice);
    if (sector < 0.0)
    {
        sector += slice;
    }
    float half_slice = slice * 0.5;
    float folded_angle = half_slice - abs(sector - half_slice);

    float2 folded;
    folded.x = cos(folded_angle) * radius / max(aspect, 0.001);
    folded.y = sin(folded_angle) * radius;
    float2 sample_uv = clamp(folded + origin, 0.0, 1.0);
    float3 mirrored = saturate(image.Sample(textureSampler, sample_uv).rgb);

    // Center stays nearer the source so a talking head still reads at the default.
    float edge = smoothstep(0.08, 0.50, radius);
    float fold_strength = lerp(0.22, 1.0, edge) * saturate(intensity);
    float3 shown = lerp(source.rgb, mirrored, fold_strength * saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
