// Filename: shader_129_news_anchor_clarity.effect
// Category: Portrait / beauty expansion
// Effect: News anchor clarity
// Visual principle: midtone local contrast and a light broadcast curve, stronger on the face than the frame edge.
// What makes it cool: eyes, hair, and suit edges read on a compressed stream while the talking head stays natural.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 source = image.Sample(textureSampler, uv);
    float drive = max(intensity, 0.0);
    float radius = 4.0 + max(amount, 0.0) * 3.5;
    float2 px = uv_pixel_interval * radius;

    float3 blur_sum = float3(0.0, 0.0, 0.0);
    float weight_sum = 0.0;
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            float ax = abs(float(i));
            float ay = abs(float(j));
            float w = lerp(2.0, 1.0, ax) * lerp(2.0, 1.0, ay);
            float2 tap_uv = clamp(uv + float2(float(i), float(j)) * px, float2(0.0, 0.0), float2(1.0, 1.0));
            blur_sum += image.Sample(textureSampler, tap_uv).rgb * w;
            weight_sum += w;
        }
    }

    float3 blur_rgb = blur_sum / max(weight_sum, 0.001);
    float luma = luma3(source.rgb);
    // Midtones take the local contrast. Highlights and shadows stay quieter so skin does not crunch.
    float mid = saturate(1.0 - abs(luma - 0.5) * 2.0);
    float detail_mix = lerp(0.40, 1.0, mid);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    // Face center gets full clarity. The frame edge stays softer so lower thirds are not haloed.
    float face_w = lerp(0.62, 1.0, 1.0 - smoothstep(0.15, 0.95, length(from_center)));
    // 0.066 Hz at speed 1.19. Speed 4.0 stays near 0.22 Hz, under a 3 Hz full-frame flash.
    float breathe = 0.92 + 0.08 * sin(elapsed_time * speed * 0.35);
    float gain = drive * (0.35 + 0.18 * max(amount, 0.0)) * breathe * detail_mix * face_w;

    float3 graded = source.rgb + (source.rgb - blur_rgb) * gain;
    float contrast = 1.0 + 0.07 * saturate(drive) * saturate(amount * 0.5 + 0.5);
    graded = (graded - 0.5) * contrast + 0.5;
    float key_amt = saturate(drive) * 0.12 * face_w;
    graded = lerp(graded, graded * float3(1.04, 1.01, 0.97), key_amt);

    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
