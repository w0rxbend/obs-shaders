// Filename: shader_110_rave_posterize.effect
// Category: VJ / music video expansion
// Effect: Rave posterize
// Visual principle: posterized color bands with a slow magenta-cyan club cycle, stronger near the center.
// What makes it cool: live footage turns into a readable rave poster without strobing the frame.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float center_reach = saturate(1.0 - length(from_center));

    float levels = max(10.0 - amount * 6.0, 2.0);
    float3 poster = floor(source.rgb * levels + 0.5) / max(levels, 0.001);
    float luma = dot(poster, float3(0.299, 0.587, 0.114));
    float3 neutral = float3(luma, luma, luma);
    float3 chroma = poster - neutral;

    // 0.22 keeps default speed 1.55 on an ~18 s hue cycle, under a 3 Hz flash.
    float phase = elapsed_time * speed * 0.22;
    float sine_phase = sin(phase);
    float cosine_phase = cos(phase);
    float3 spun = float3(
        chroma.x * cosine_phase - chroma.z * sine_phase,
        chroma.y,
        chroma.x * sine_phase + chroma.z * cosine_phase
    );
    float3 club = float3(
        0.55 + 0.45 * sine_phase,
        0.25 + 0.20 * cosine_phase,
        0.65 - 0.35 * sine_phase
    );
    float3 tinted = neutral + spun * 1.15 + (club - 0.5) * luma * 0.55 * center_reach;
    float3 rave = lerp(poster, tinted, saturate(0.35 + 0.65 * center_reach));
    float3 graded = lerp(source.rgb, rave, saturate(intensity * 0.62));
    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
