// Filename: shader_019_earthquake_shake.effect
// Category: Webcam motion pack
// Effect: Earthquake shake
// Visual principle: animated UV camera transforms around a stable center point.
// What makes it cool: it makes a static source feel physically alive without moving the OBS source transform.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float smoothSignedHash(float shock_id, float salt, float smooth_u)
{
    float current = hash12(float2(shock_id, salt));
    float next = hash12(float2(shock_id + 1.0, salt));
    return (current + (next - current) * smooth_u) * 2.0 - 1.0;
}

float2 rotate2d(float2 p, float a)
{
    float s = sin(a);
    float c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    // Wrap the clock so the sines stay stable on a long stream.
    float wave = fmod(elapsed_time * speed, 1024.0);
    float shock_phase = wave * 2.6;
    float shock_id = floor(shock_phase);
    float shock_u = shock_phase - shock_id;
    float smooth_u = shock_u * shock_u * (3.0 - 2.0 * shock_u);
    float dir_x = smoothSignedHash(shock_id, 2.0, smooth_u);
    float dir_y = smoothSignedHash(shock_id, 5.0, smooth_u);
    float dir_r = smoothSignedHash(shock_id, 9.0, smooth_u);
    // Extra shove peaks mid-window and is zero on the boundary, so direction changes do not pop.
    float bump = 1.0 - abs(shock_u * 2.0 - 1.0);
    float rumble = 0.6 + 0.4 * bump * bump;
    float gain = amount * intensity;
    float shake_x = dir_x * 0.72 * sin(wave * 14.0) + 0.28 * sin(wave * 37.0 + 1.3);
    float shake_y = dir_y * 0.72 * sin(wave * 11.0 + 0.7) + 0.28 * sin(wave * 29.0 + 2.1);
    float shake_r = dir_r * 0.72 * sin(wave * 9.0 + 1.1) + 0.28 * sin(wave * 19.0 + 0.4);
    float2 drift = float2(shake_x * 0.024, shake_y * 0.009) * rumble * gain;
    float angle = shake_r * 0.016 * rumble * gain;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float safe_aspect = max(aspect, 0.001);
    float zoom = 1.05 + 0.025 * gain;
    float2 center = float2(center_x, center_y);
    float2 from_center = (uv - center) / max(zoom, 0.001);
    from_center.x *= safe_aspect;
    from_center = rotate2d(from_center, angle);
    from_center.x /= safe_aspect;
    float2 warped_uv = center + from_center - drift;
    warped_uv = clamp(warped_uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 warped = image.Sample(textureSampler, warped_uv);
    return float4(warped.rgb, alphaOut(warped.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
