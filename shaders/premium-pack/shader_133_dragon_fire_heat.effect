// Filename: shader_133_dragon_fire_heat.effect
// Category: Sci-fi / fantasy expansion
// Effect: Dragon fire heat
// Visual principle: rising heat warp plus a bottom-weighted orange grade, stronger in a column under the subject.
// What makes it cool: the lower frame shimmers like dragon breath while a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float valueNoise(float2 p)
{
    float2 cell = floor(p);
    float2 blend = frac(p);
    float2 smooth_blend = blend * blend * (3.0 - 2.0 * blend);
    float corner00 = hash12(cell);
    float corner10 = hash12(cell + float2(1.0, 0.0));
    float corner01 = hash12(cell + float2(0.0, 1.0));
    float corner11 = hash12(cell + float2(1.0, 1.0));
    float row0 = lerp(corner00, corner10, smooth_blend.x);
    float row1 = lerp(corner01, corner11, smooth_blend.x);
    return lerp(row0, row1, smooth_blend.y);
}

float alphaOut(float sampled_alpha)
{
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    // frac keeps a long stream inside one cycle. Default speed 0.65 is about 0.65 Hz.
    float phase = frac(elapsed_time * speed);
    float band_start = saturate(0.58 + (center_y - 0.5) * 0.5 - (amount - 1.0) * 0.08);
    float vertical = saturate((uv.y - band_start) / max(1.0 - band_start, 0.001));
    vertical = vertical * vertical * (3.0 - 2.0 * vertical);

    float column_x = abs((uv.x - center_x) * aspect);
    float half_width = 0.12 + amount * 0.08;
    float column = 1.0 - saturate((column_x - half_width) / 0.28);
    float heat_mask = saturate(vertical * lerp(0.55, 1.0, column));

    float2 field = float2(uv.x * (6.0 + amount * 4.0), uv.y * (3.0 + amount * 2.0));
    // UV y grows downward, so subtracting phase sends the heat field upward.
    field.y -= phase * 2.0;
    float coarse = valueNoise(field);
    float fine = valueNoise(field * 2.13 + float2(4.2, 1.7));
    float shimmer_x = coarse * 2.0 - 1.0;
    float shimmer_y = (fine * 2.0 - 1.0) * 0.35;
    float scale = 0.012 * intensity * heat_mask;
    float2 sample_uv = clamp(uv + float2(shimmer_x, shimmer_y) * scale, 0.0, 1.0);
    float4 warped = image.Sample(textureSampler, sample_uv);

    float streak = smoothstep(0.78, 0.96, fine);
    float ember = 0.85 + 0.15 * sin(phase * 6.2831853);
    float3 breath = lerp(float3(1.0, 0.36, 0.05), float3(1.0, 0.78, 0.28), streak);
    float grade = heat_mask * 0.34 * intensity * ember;
    float3 graded = lerp(warped.rgb, saturate(warped.rgb * breath), saturate(grade));
    float3 tongue = float3(1.0, 0.55, 0.12) * streak * heat_mask * 0.07 * intensity;
    graded = saturate(graded + tongue);

    float3 rgb = lerp(source.rgb, graded, saturate(opacity));
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
