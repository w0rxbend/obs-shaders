// Filename: shader_065_fake_3d_anaglyph.effect
// Category: Lens / distortion pack
// Effect: Fake 3D anaglyph
// Visual principle: red from a left-eye sample and cyan from a right-eye sample, with disparity from a cheap depth cue.
// What makes it cool: one camera reads as red-cyan 3D glasses while the face stays in place.
// Suggested source type: webcam, game capture, image source, video source
// Suggested shader-chain combinations: this shader -> chromatic aberration -> bloom
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // 0.6 rad/s stays near 0.1 Hz at the default speed, under a 3 Hz flash.
    float clock = fmod(elapsed_time * speed, 1024.0);
    float pulse = 1.0 + 0.1 * sin(clock * 0.6);
    // 0.009 keeps the default shift near one percent of the frame.
    float disparity_scale = max(amount, 0.0) * 0.009 * max(intensity, 0.0) * pulse;

    [branch]
    if (disparity_scale < 0.0001)
    {
        return float4(source.rgb, alphaOut(source.a));
    }

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float radial = saturate(length(from_center));
    float luma = dot(source.rgb, float3(0.299, 0.587, 0.114));
    float depth = saturate(0.28 + radial * 0.72 + (1.0 - luma) * 0.22);
    float shift = disparity_scale * depth;
    float2 left_uv = clamp(uv + float2(-shift, 0.0), 0.0, 1.0);
    float2 right_uv = clamp(uv + float2(shift, 0.0), 0.0, 1.0);
    float3 left_rgb = image.Sample(textureSampler, left_uv).rgb;
    float3 right_rgb = image.Sample(textureSampler, right_uv).rgb;
    float3 anaglyph = saturate(float3(left_rgb.r, right_rgb.g, right_rgb.b));
    float3 shown = lerp(source.rgb, anaglyph, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
