// Filename: shader_116_presentation_spotlight.effect
// Category: Screen capture utility expansion
// Effect: Presentation spotlight
// Visual principle: a warm stage beam holds the presenter while the surround falls to a readable dim.
// What makes it cool: the pool reads as a follow-spot, not a crop, so a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // Width/height keeps the beam round. Do not assume 16:9.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float dist = length(from_center);

    // 0.12 cycles/sec before speed. Slider max is 0.36 Hz, under the 3 Hz flash cap.
    float cycle = frac(elapsed_time * speed * 0.12);
    float pulse = sin(cycle * 6.283185) * 0.025;
    float radius = max(lerp(0.10, 0.42, saturate(amount)) + pulse, 0.05);
    float beam = 1.0 - smoothstep(radius, radius + 0.18, dist);

    float strength = saturate(intensity * 0.65);
    float edge_gain = lerp(1.0, 0.36, strength);
    float gain = lerp(edge_gain, 1.0, beam);
    float3 edge_tint = lerp(float3(1.0, 1.0, 1.0), float3(0.72, 0.80, 0.95), strength);
    float3 core_tint = lerp(float3(1.0, 1.0, 1.0), float3(1.05, 1.01, 0.95), strength);
    float3 tint = lerp(edge_tint, core_tint, beam);
    float3 graded = saturate(source.rgb * tint * gain);
    float3 out_rgb = lerp(source.rgb, graded, saturate(opacity));
    return float4(out_rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
