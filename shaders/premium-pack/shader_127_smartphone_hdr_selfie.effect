// Filename: shader_127_smartphone_hdr_selfie.effect
// Category: Portrait / beauty expansion
// Effect: Smartphone HDR selfie
// Visual principle: phone-HDR tone curve with shadow lift, highlight roll-off, local clarity, and a mild selfie vignette.
// What makes it cool: a talking-head stays recognizable while the frame picks up a computational smartphone HDR selfie grade.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 sampleClamped(float2 uv)
{
    float2 safe_uv = clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0));
    return image.Sample(textureSampler, safe_uv);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 source = sampleClamped(uv);

    float reach = 2.0 + min(max(amount, 0.0), 2.0);
    float2 px = uv_pixel_interval * reach;
    float3 east = sampleClamped(uv + float2(px.x, 0.0)).rgb;
    float3 west = sampleClamped(uv - float2(px.x, 0.0)).rgb;
    float3 north = sampleClamped(uv + float2(0.0, px.y)).rgb;
    float3 south = sampleClamped(uv - float2(0.0, px.y)).rgb;
    float3 neighborhood = (source.rgb + east + west + north + south) * 0.2;

    float luma = luma3(source.rgb);
    float grade = saturate(min(max(intensity, 0.0), 2.0) * 0.72);
    float clarity = min(max(amount, 0.0), 2.0) * 0.34;
    // Default speed 0.83 * 0.40 rad/s is about 0.05 Hz. Shadow and highlight move opposite so the frame does not flash.
    float balance = sin(elapsed_time * speed * 0.40);
    float shadow_pulse = 1.0 + balance * 0.08;
    float highlight_pulse = 1.0 - balance * 0.08;

    float3 hdr = source.rgb + (source.rgb - neighborhood) * clarity;
    hdr = (hdr - 0.5) * (1.0 + 0.12 * grade) + 0.5;

    float shadow = 1.0 - smoothstep(0.0, 0.45, luma);
    hdr += float3(0.11, 0.08, 0.055) * shadow * grade * shadow_pulse;

    float shoulder = smoothstep(0.58, 1.0, luma);
    float recover = saturate(shoulder * 0.40 * highlight_pulse);
    float3 rolled = lerp(hdr, neighborhood, recover);
    rolled *= 1.0 - shoulder * 0.12 * grade * highlight_pulse;
    hdr = lerp(hdr, rolled, shoulder);

    float hdr_luma = luma3(hdr);
    float3 gray = float3(hdr_luma, hdr_luma, hdr_luma);
    hdr = lerp(gray, hdr, 1.0 + 0.16 * grade);
    hdr += float3(0.028, 0.010, 0.0) * shadow * grade;
    hdr = lerp(hdr, hdr * float3(0.97, 0.99, 1.04), shoulder * grade * 0.45);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float edge = smoothstep(0.45, 1.25, length(from_center));
    hdr *= 1.0 - edge * 0.12 * grade;

    float3 graded = lerp(source.rgb, hdr, grade);
    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
