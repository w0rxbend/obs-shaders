// Filename: shader_055_cyberpunk_neon_boost.effect
// Category: Cyberpunk / glitch pack
// Effect: Cyberpunk neon boost
// Visual principle: saturation lift, cyan-magenta split tone, and a slow neon edge bloom.
// What makes it cool: colored light pops like neon while a talking head stays recognizable.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;
uniform float2 uv_pixel_interval;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);
    float3 rgb = color.rgb;
    float luma = luma3(rgb);
    float3 gray = float3(luma, luma, luma);
    float sat = 1.0 + 0.38 * intensity;
    float3 saturated = lerp(gray, rgb, sat);

    // x is wider than y, so the milder zone around the subject stays round.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float radius = length(from_center);
    float fringe = smoothstep(0.20, 1.10, radius);
    float grade_mix = saturate(amount * lerp(0.28, 0.55, fringe));

    float tone = smoothstep(0.20, 0.85, luma);
    float3 split = lerp(float3(0.45, 0.85, 1.25), float3(1.25, 0.55, 1.05), tone);
    float3 graded = lerp(saturated, saturated * split, grade_mix);

    float chroma = length(saturated - gray);
    float pop = smoothstep(0.22, 0.62, chroma) * smoothstep(0.05, 0.25, luma);
    float red_dom = saturate(saturated.r - saturated.b);
    float3 neon = lerp(float3(0.0, 0.90, 1.0), float3(1.0, 0.05, 0.80), red_dom);
    graded = lerp(graded, neon * luma, pop * saturate(amount * 0.65));

    float2 texel = uv_pixel_interval * (2.0 + amount);
    float3 north = image.Sample(textureSampler, clamp(uv + float2(0.0, -texel.y), 0.0, 1.0)).rgb;
    float3 south = image.Sample(textureSampler, clamp(uv + float2(0.0, texel.y), 0.0, 1.0)).rgb;
    float3 east = image.Sample(textureSampler, clamp(uv + float2(texel.x, 0.0), 0.0, 1.0)).rgb;
    float3 west = image.Sample(textureSampler, clamp(uv - float2(texel.x, 0.0), 0.0, 1.0)).rgb;
    float edge = luma3(abs(east - west)) + luma3(abs(north - south));

    float wrapped = fmod(elapsed_time * speed, 1024.0);
    float pulse = 0.75 + 0.25 * sin(wrapped);
    graded += neon * edge * pulse * intensity * (0.80 + 0.40 * fringe);

    return float4(saturate(graded), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
