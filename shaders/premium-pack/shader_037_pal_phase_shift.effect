// Filename: shader_037_pal_phase_shift.effect
// Category: Retro analog pack
// Effect: PAL phase shift
// Visual principle: alternate-line chroma phase (Hanover bars) and a slow phase swing, with luma held on the source.
// What makes it cool: it sells nostalgic hardware instability with cheap procedural math.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float2 rotate2d(float2 p, float a)
{
    float s = sin(a);
    float c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 color = image.Sample(textureSampler, uv);

    // 0.55 rad/s * speed. Default speed 1.01 swings hue at 0.09 Hz, under a 3 Hz flash.
    float cycle = elapsed_time * speed * 0.55 * 0.15915494;
    float wrapped = (cycle - floor(cycle)) * 6.2831853;
    float swing = sin(wrapped);

    float rows = max(uv_size.y, 1.0);
    float line = floor(uv.y * rows + (center_y - 0.5) * 4.0);
    float odd = step(0.5, frac(line * 0.5));
    float phase_sign = odd * 2.0 - 1.0;

    float phase_amt = max(amount, 0.0);
    float gain = max(intensity, 0.0);
    float theta = phase_sign * (0.32 + 0.16 * swing) * phase_amt * gain;
    float chroma_px = phase_sign * (1.2 + (center_x - 0.5) * 3.0) * phase_amt * gain;
    float2 chroma_uv = clamp(uv + float2(chroma_px * uv_pixel_interval.x, 0.0), float2(0.0, 0.0), float2(1.0, 1.0));
    float3 chroma_rgb = image.Sample(textureSampler, chroma_uv).rgb;

    float y = luma3(chroma_rgb);
    float u = chroma_rgb.b - y;
    float v = chroma_rgb.r - y;
    float2 turned = rotate2d(float2(u, v), theta);
    float r = y + turned.y;
    float b = y + turned.x;
    float g = (y - 0.299 * r - 0.114 * b) / max(0.587, 0.001);
    float3 shifted = float3(r, g, b);
    shifted += luma3(color.rgb) - y;

    float hit = saturate(intensity) * saturate(opacity);
    float3 out_rgb = lerp(color.rgb, saturate(shifted), hit);
    return float4(out_rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
