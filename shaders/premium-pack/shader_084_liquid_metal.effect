// Filename: shader_084_liquid_metal.effect
// Category: Experimental art pack
// Effect: Liquid metal
// Visual principle: a slow mercury UV warp, a cool chrome grade, and thin moving specular streaks.
// What makes it cool: live footage reads as liquid metal while a talking head stays recognizable.
// Suggested source type: webcam, image source, video source, VJ visuals
// Suggested shader-chain combinations: this shader -> posterize or halftone -> light vignette
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float t = elapsed_time * speed;
    float along = from_center.x * 0.8 + from_center.y * 1.2;
    float wave_x = sin(from_center.y * 8.0 + t * 1.15);
    float wave_y = cos(from_center.x * 6.5 - t * 0.95);
    float wave_d = sin(along * 11.0 + t * 1.4);
    // amount 1.17 stays near a 1% UV shift so a talking head stays readable.
    float amp = amount * 0.009;
    float2 offset = float2(wave_x + wave_d * 0.45, wave_y - wave_d * 0.35) * amp;
    float2 flowed_uv = clamp(uv + offset, 0.0, 1.0);
    float4 flowed = image.Sample(textureSampler, flowed_uv);

    float luma = luma3(flowed.rgb);
    float grade = saturate(intensity);
    float3 silver = lerp(flowed.rgb, float3(luma, luma, luma), 0.62 * grade);
    float lift = smoothstep(0.28, 0.90, luma);
    float3 shadow = silver * lerp(float3(1.0, 1.0, 1.0), float3(0.74, 0.82, 0.94), grade);
    float3 lit = silver * lerp(float3(1.0, 1.0, 1.0), float3(1.05, 1.02, 0.98), grade);
    lit += float3(0.03, 0.03, 0.04) * grade;
    float3 chrome = lerp(shadow, lit, lift);
    // Narrow moving band. Default speed cannot flash the whole frame.
    float ridge = pow(saturate(wave_d * 0.5 + 0.5), 7.0);
    chrome = lerp(chrome, float3(0.95, 0.97, 1.0), ridge * 0.16 * grade);

    float3 metal = lerp(flowed.rgb, chrome, saturate(grade * 0.65));
    float3 shown = lerp(source.rgb, saturate(metal), saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
