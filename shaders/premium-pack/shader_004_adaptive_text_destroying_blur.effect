// Filename: shader_004_adaptive_text_destroying_blur.effect
// Category: Confidential / privacy pack
// Effect: Adaptive text destroying blur
// Visual principle: large-kernel signal destruction with pixel quantization and procedural privacy noise.
// What makes it cool: it hides readable details but leaves the audience aware that real content exists underneath.
// Suggested source type: screen capture, browser source, IDEs, dashboards, documents
// Suggested shader-chain combinations: soft vignette -> this shader -> subtle noise or scanline overlay
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float channelDelta(float3 sample_rgb, float3 center_rgb)
{
    float3 delta = abs(sample_rgb - center_rgb);
    return max(delta.r, max(delta.g, delta.b));
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);
    float2 px = max(uv_pixel_interval, float2(0.001, 0.001));
    float2 near_step = px * 7.0;

    float4 near_l = image.Sample(textureSampler, clamp(uv - float2(near_step.x, 0.0), 0.0, 1.0));
    float4 near_r = image.Sample(textureSampler, clamp(uv + float2(near_step.x, 0.0), 0.0, 1.0));
    float4 near_d = image.Sample(textureSampler, clamp(uv - float2(0.0, near_step.y), 0.0, 1.0));
    float4 near_u = image.Sample(textureSampler, clamp(uv + float2(0.0, near_step.y), 0.0, 1.0));

    float contrast = channelDelta(near_l.rgb, color.rgb);
    contrast = max(contrast, channelDelta(near_r.rgb, color.rgb));
    contrast = max(contrast, channelDelta(near_d.rgb, color.rgb));
    contrast = max(contrast, channelDelta(near_u.rgb, color.rgb));

    float kernel = saturate(clamp(amount, 0.0, 2.0) / 1.25);
    float edge_lo = lerp(0.18, 0.06, kernel);
    float text = smoothstep(edge_lo, edge_lo + 0.12, contrast);

    float block_px = lerp(3.0, lerp(8.0, 28.0, kernel), text);
    float2 pixels = max(uv_size, float2(1.0, 1.0));
    float2 cells = max(float2(1.0, 1.0), pixels / max(block_px, 0.001));
    float2 phase = float2(center_x, center_y);
    float2 quant_uv = (floor(uv * cells + phase) + 0.5 - phase) / max(cells, float2(0.001, 0.001));
    quant_uv = clamp(quant_uv, 0.0, 1.0);

    float reach = lerp(1.0, lerp(4.0, 20.0, kernel), text);
    float2 blur_step = px * reach;
    // Vertical taps are folded into the center so the shader stays at 8 samples.
    float4 blur = image.Sample(textureSampler, quant_uv) * 0.68;
    blur += image.Sample(textureSampler, clamp(quant_uv + float2(blur_step.x, 0.0), 0.0, 1.0)) * 0.16;
    blur += image.Sample(textureSampler, clamp(quant_uv - float2(blur_step.x, 0.0), 0.0, 1.0)) * 0.16;

    float tick = floor(elapsed_time * max(speed, 0.0) * 2.0);
    float noise_cell = max(block_px * 0.35, 2.0);
    float grain = hash12(floor(uv * pixels / noise_cell) + tick + phase);
    float gray = luma3(blur.rgb);
    float crush = clamp(intensity, 0.0, 2.0);
    float3 destroyed = lerp(blur.rgb, float3(gray, gray, gray), saturate(0.75 * crush));
    float3 tint = float3(0.080, 0.100, 0.120);
    destroyed = lerp(destroyed, tint * (0.45 + gray * 0.55), saturate(0.22 * crush));
    destroyed += (grain - 0.5) * 0.12 * min(crush, 1.5);
    destroyed *= lerp(1.0, 0.88, saturate(crush));

    float cover = saturate(text * min(crush, 1.5)) * saturate(opacity);
    float3 out_rgb = lerp(color.rgb, destroyed, cover);
    float out_a = color.a;
    if (!preserve_alpha)
    {
        out_a = saturate(color.a);
    }
    return float4(saturate(out_rgb), out_a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
