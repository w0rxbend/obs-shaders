// Filename: shader_117_code_rain_overlay.effect
// Category: Screen capture utility expansion
// Effect: Code rain overlay
// Visual principle: falling code columns overlay the source and stay thinner over the subject.
// What makes it cool: matrix glyphs read clearly while a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float2 codeRain(float2 uv, float columns, float fall_rate)
{
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float clock = fmod(max(elapsed_time, 0.0), 4096.0) * speed;
    float x_grid = uv.x * aspect * columns + (center_x - 0.5) * 6.0;
    float y_grid = uv.y * columns;
    float col = floor(x_grid);
    float col_h = hash12(float2(col, fall_rate * 11.0));
    float head = frac(col_h * 5.0 + clock * fall_rate * (0.40 + col_h * 0.80) + (center_y - 0.5));
    float behind = frac(head - uv.y);
    float trail = saturate(1.0 - behind * (2.6 + col_h * 2.0));
    float2 cell_uv = frac(float2(x_grid, y_grid));
    float glyph_h = hash12(float2(col, floor(y_grid)) + float2(floor(clock * 0.80), col_h * 13.0));
    float inside = step(0.14, cell_uv.x) * step(cell_uv.x, 0.86);
    inside *= step(0.08, cell_uv.y) * step(cell_uv.y, 0.92);
    float bits = step(0.46, frac(cell_uv.x * 3.0 + glyph_h * 2.0));
    bits *= step(0.40, frac(cell_uv.y * 5.0 + glyph_h));
    float keep = step(saturate(0.78 - 0.22 * amount), glyph_h);
    float glyph = inside * bits * keep;
    float body = glyph * trail;
    float tip = glyph * (1.0 - smoothstep(0.0, 0.09, behind));
    return float2(body, tip);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    // Thin the rain on the subject so a talking head stays readable.
    float edge_w = smoothstep(0.10, 0.70, length(from_center));
    float2 near_rain = codeRain(uv, 22.0, 0.90);
    float2 far_rain = codeRain(uv, 38.0, 1.40);
    float body = saturate(near_rain.x + far_rain.x * 0.60);
    float tip = saturate(near_rain.y + far_rain.y * 0.60);
    float gain = intensity * opacity * lerp(0.42, 1.0, edge_w);
    float3 rain_rgb = float3(0.05, 0.78, 0.24);
    float3 out_rgb = lerp(color.rgb, rain_rgb, saturate(body * 0.70 * gain));
    out_rgb = lerp(out_rgb, float3(0.80, 1.0, 0.88), saturate(tip * gain));
    return float4(saturate(out_rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
