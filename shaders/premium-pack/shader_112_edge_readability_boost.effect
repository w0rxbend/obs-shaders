// Filename: shader_112_edge_readability_boost.effect
// Category: Screen capture utility expansion
// Effect: Edge readability boost
// Visual principle: a one-pixel unsharp mask lifts text and subject edges without moving the frame.
// What makes it cool: captions, UI, and facial edges stay readable on a live camera while the person stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    // Center stays at 72% so a talking head is not crunchy; the frame edge gets the full boost.
    float edge_bias = lerp(0.72, 1.0, saturate(length(from_center) * 1.35));
    // 0.036 Hz at speed 0.65, far under a 3 Hz full-frame flash.
    float breathe = 0.88 + 0.12 * sin(elapsed_time * speed * 0.35);
    float radius_px = max(amount, 0.0);
    // 0.7 keeps default intensity 1.15 near a 0.6 unsharp on a centered face.
    float gain = intensity * 0.7 * breathe * edge_bias;

    float3 blur_sum = float3(0.0, 0.0, 0.0);
    float weight_sum = 0.0;
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            float ax = abs(float(i));
            float ay = abs(float(j));
            float w = lerp(2.0, 1.0, ax) * lerp(2.0, 1.0, ay);
            float2 tap_uv = clamp(uv + float2(float(i), float(j)) * uv_pixel_interval * radius_px, 0.0, 1.0);
            blur_sum += image.Sample(textureSampler, tap_uv).rgb * w;
            weight_sum += w;
        }
    }

    float3 blur_rgb = blur_sum / max(weight_sum, 0.001);
    float3 sharpened = source.rgb + (source.rgb - blur_rgb) * gain;
    return float4(saturate(sharpened), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
