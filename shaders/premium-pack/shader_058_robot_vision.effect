// Filename: shader_058_robot_vision.effect
// Category: Cyberpunk / glitch pack
// Effect: Robot vision
// Visual principle: sensor posterization, channel separation, scanlines, focus brackets, block displacement, and slow horizontal tears.
// What makes it cool: a machine sensor reads the shot while a talking head stays recognizable.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float bracketMask(float2 uv, float aspect)
{
    float2 local = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float2 corner = abs(local);
    float edge = 0.0035;
    float bracket_r = 0.28;
    float arm = 0.055;
    float along_x = step(bracket_r - arm, corner.x) * step(corner.x, bracket_r + edge);
    float on_y = step(abs(corner.y - bracket_r), edge);
    float along_y = step(bracket_r - arm, corner.y) * step(corner.y, bracket_r + edge);
    float on_x = step(abs(corner.x - bracket_r), edge);
    return saturate(along_x * on_y + along_y * on_x);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_focus = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float reach = lerp(0.5, 1.0, saturate(length(from_focus) * 1.6));

    // Retarget stays under 2 Hz at the default speed so tears do not strobe.
    float clock = fmod(elapsed_time * speed, 1024.0);
    float tick = floor(clock * 1.2);

    float row_id = floor(uv.y * (20.0 + amount * 16.0));
    float tear_on = step(0.82, hash12(float2(row_id, tick)));
    float tear = (hash12(float2(row_id, tick + 4.0)) - 0.5) * 0.018 * amount * tear_on * reach;

    float2 grid = float2(12.0 + amount * 6.0, 8.0 + amount * 4.0);
    float2 block_id = floor(float2(uv.x * aspect, uv.y) * grid);
    float block_on = step(0.78, hash12(block_id + float2(tick, 6.0)));
    float slide = (hash12(block_id + float2(tick, 2.0)) - 0.5) * 0.016 * amount * block_on * reach;
    float lift = (hash12(float2(block_id.y, block_id.x) + float2(tick, 9.0)) - 0.5) * 0.008 * amount * block_on * reach;

    float spread = 0.004 * intensity;
    float2 moved = clamp(uv + float2(slide + tear, lift), 0.0, 1.0);
    float red = image.Sample(textureSampler, clamp(moved + float2(spread, 0.0), 0.0, 1.0)).r;
    float green = image.Sample(textureSampler, moved).g;
    float blue = image.Sample(textureSampler, clamp(moved - float2(spread, 0.0), 0.0, 1.0)).b;
    float3 split = float3(red, green, blue);

    float steps = max(8.0, 14.0 - intensity * 3.0);
    float3 stepped = floor(split * steps + 0.5) / max(steps, 0.001);
    float3 quantized = lerp(split, stepped, saturate(intensity) * 0.55);

    float luma = dot(quantized, float3(0.299, 0.587, 0.114));
    float3 sensor = lerp(quantized, luma * float3(0.62, 0.98, 0.74), saturate(intensity) * 0.30);

    float scan = 0.5 + 0.5 * sin(uv.y * max(uv_size.y, 1.0) * 3.14159);
    sensor *= lerp(1.0 - saturate(intensity) * 0.10, 1.0, scan);

    float bracket = bracketMask(uv, aspect) * saturate(intensity) * 0.70;
    sensor = lerp(sensor, float3(0.55, 1.0, 0.82), bracket);

    float3 shown = lerp(source.rgb, saturate(sensor), saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
