// Filename: shader_063_pincushion.effect
// Category: Lens / distortion pack
// Effect: Pincushion
// Visual principle: radial or directional UV warping with small compensating zoom.
// What makes it cool: it bends the camera feed like a lens or energy field while preserving the source.
// Suggested source type: webcam, game capture, image source, video source
// Suggested shader-chain combinations: this shader -> chromatic aberration -> bloom
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 p = uv - center;
    p.x *= aspect;

    // Far-corner normalize keeps the pinch circular and stops wide frames from folding.
    float2 corner_a = float2((0.0 - center.x) * aspect, 0.0 - center.y);
    float2 corner_b = float2((1.0 - center.x) * aspect, 0.0 - center.y);
    float2 corner_c = float2((0.0 - center.x) * aspect, 1.0 - center.y);
    float2 corner_d = float2((1.0 - center.x) * aspect, 1.0 - center.y);
    float reach = max(length(corner_a), max(length(corner_b), max(length(corner_c), length(corner_d))));
    reach = max(reach, 0.001);
    float2 pn = p / reach;

    // Bound the phase so a long stream does not collapse the sine.
    float phase = fmod(elapsed_time * speed, 6.283185307);
    float breathe = 1.0 + sin(phase) * 0.06;
    float pinch = amount * intensity * breathe;
    float r2 = dot(pn, pn);
    float r4 = r2 * r2;
    // Negative polynomial pinches edges inward (opposite of barrel).
    float radial = max(1.0 - pinch * (0.28 * r2 + 0.08 * r4), 0.2);
    float compensate = 1.0 + pinch * 0.05;
    float2 warped_p = pn * radial * compensate * reach;
    warped_p.x /= max(aspect, 0.001);
    float2 warped_uv = center + warped_p;
    float4 warped = image.Sample(textureSampler, clamp(warped_uv, float2(0.0, 0.0), float2(1.0, 1.0)));
    return float4(warped.rgb, alphaOut(warped.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
