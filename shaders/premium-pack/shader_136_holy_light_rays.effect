// Filename: shader_136_holy_light_rays.effect
// Category: Sci-fi / fantasy expansion
// Effect: Holy light rays
// Visual principle: warm shafts from a movable origin, a soft downward column, and slow drift that leaves a talking head readable.
// What makes it cool: cathedral light falls across the shot without hiding the person.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float angle_from(float y, float x)
{
    // Pack rule rejects atan2. One-argument atan stays inside the effect compiler.
    float ax = max(abs(x), 0.0001);
    float a = atan(y / ax);
    if (x < 0.0)
        a = (y < 0.0 ? -3.14159265 : 3.14159265) - a;
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // Width/height keeps shafts round. Do not assume 16:9.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 origin = float2(center_x, center_y);
    float2 p = uv - origin;
    p.x *= aspect;
    float dist = length(p);
    float ang = angle_from(p.y, p.x);

    // 0.11*speed is about one turn per 48 s at the default. Five shafts cross a pixel slower than 0.2 Hz.
    float spin = fmod(elapsed_time * speed * 0.11, 6.28318530718);
    float breathe = 0.90 + 0.10 * sin(fmod(elapsed_time * speed * 0.35, 6.28318530718));

    float primary = pow(abs(sin(ang * 5.0 + spin)), 10.0);
    float secondary = pow(abs(sin(ang * 11.0 - spin * 0.7)), 22.0);
    // uv.y grows downward, so positive p.y is light falling across the subject.
    float falling = saturate(0.35 + p.y * 1.6);
    float shafts = (primary * 0.34 + secondary * 0.16) * lerp(0.40, 1.0, falling);

    float column = exp(-(p.x * p.x) / max(0.0035, 0.001));
    column *= smoothstep(-0.04, 0.20, p.y);

    float reach = exp(-dist * lerp(2.2, 1.15, saturate(amount * 0.5)));
    float aura = exp(-(dist * dist) / max(0.05, 0.001));
    float core = exp(-(dist * dist) / max(0.006, 0.001));

    float scatter = 0.0;
    float2 to_light = origin - uv;
    for (int tap = 1; tap <= 4; tap++)
    {
        float along = float(tap) / 5.0;
        float2 suv = clamp(uv + to_light * along, 0.0, 1.0);
        float bright = saturate((luma3(image.Sample(textureSampler, suv).rgb) - 0.72) * 4.0);
        scatter += bright * (1.0 - along);
    }
    scatter /= max(4.0, 0.001);

    float energy = min(max(intensity, 0.0), 2.0) * breathe;
    float cover = min(max(amount, 0.0), 1.5);

    float3 holy = float3(1.0, 0.88, 0.52) * shafts;
    holy += float3(1.0, 0.93, 0.70) * column * 0.22;
    holy += float3(1.0, 0.80, 0.42) * aura * 0.10;
    holy += float3(1.0, 0.97, 0.86) * core * 0.12;
    holy += float3(1.0, 0.84, 0.48) * scatter * 0.30;
    holy *= energy * reach;

    float3 lit = saturate(source.rgb + holy * cover);
    float3 rgb = lerp(source.rgb, lit, saturate(opacity));
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
