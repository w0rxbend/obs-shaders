// Filename: shader_121_soft_skin_bloom.effect
// Category: Portrait / beauty expansion
// Effect: Soft skin bloom
// Visual principle: small skin-weighted blur plus a slow highlight bloom around a chosen center.
// What makes it cool: skin looks softer and slightly lit while the talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float skinCoverage(float3 rgb)
{
    float sum = max(rgb.r + rgb.g + rgb.b, 0.001);
    float red_share = rgb.r / sum;
    float green_share = rgb.g / sum;
    float warm = saturate((red_share - 0.33) * 8.0) * saturate((0.55 - red_share) * 8.0);
    float green_ok = saturate((green_share - 0.22) * 8.0) * saturate((0.42 - green_share) * 8.0);
    float red_leads = saturate((rgb.r - rgb.g) * 6.0 + 0.35);
    red_leads *= saturate((rgb.r - rgb.b) * 4.0 + 0.2);
    float chroma = max(rgb.r, max(rgb.g, rgb.b)) - min(rgb.r, min(rgb.g, rgb.b));
    float colored = saturate(chroma * 5.0);
    float luma = dot(rgb, float3(0.299, 0.587, 0.114));
    float in_range = saturate(luma * 8.0) * saturate((0.97 - luma) * 10.0);
    return saturate(max(warm * green_ok, red_leads * 0.65) * colored * in_range);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float center_reach = saturate(1.0 - length(from_center) * 0.85);
    float focus = saturate(0.4 + 0.6 * center_reach);
    float skin = skinCoverage(source.rgb);

    // 0.056 Hz at speed 1.01, under a 3 Hz full-frame flash.
    float breath = 0.88 + 0.12 * sin(elapsed_time * speed * 0.35);
    float radius_px = 1.8 + amount * 1.2 + intensity * 0.9;

    float3 blur_sum = float3(0.0, 0.0, 0.0);
    float weight_sum = 0.0;
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            float ax = abs(float(i));
            float ay = abs(float(j));
            float w = lerp(2.0, 1.0, ax) * lerp(2.0, 1.0, ay);
            float2 tap_uv = clamp(uv + float2(float(i), float(j)) * uv_pixel_interval * radius_px, 0.0, 1.0);
            blur_sum += image.Sample(textureSampler, tap_uv).rgb * w;
            weight_sum += w;
        }
    }

    float3 blur_rgb = blur_sum / max(weight_sum, 0.001);
    float blur_luma = dot(blur_rgb, float3(0.299, 0.587, 0.114));
    float highlight = smoothstep(0.42, 0.88, blur_luma);
    float smooth_mix = saturate(amount * focus * lerp(0.28, 0.85, skin));
    float bloom_gain = intensity * saturate(amount) * 0.24 * breath * lerp(0.3, 1.0, skin) * focus;

    float3 softened = lerp(source.rgb, blur_rgb, smooth_mix);
    float3 glowed = softened + blur_rgb * highlight * bloom_gain;
    return float4(saturate(glowed), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
