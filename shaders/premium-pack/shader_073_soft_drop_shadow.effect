// Filename: shader_073_soft_drop_shadow.effect
// Category: Streamer branding pack
// Effect: Soft drop shadow
// Visual principle: a blurred silhouette offset down-right darkens only the trailing edge of the source.
// What makes it cool: the subject stays put and recognizable while a soft shadow lifts that edge.
// Suggested source type: webcam camera source, streamer layouts, browser source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> animated border
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = saturate(opacity);
    }
    return a;
}

float coveredAlpha(float2 p)
{
    float2 safe = clamp(p, 0.0, 1.0);
    float2 inside = step(float2(0.0, 0.0), p) * step(p, float2(1.0, 1.0));
    return image.Sample(textureSampler, safe).a * inside.x * inside.y;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 base = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float safe_aspect = max(aspect, 0.001);
    // About 0.07 Hz at the default speed, under a 3 Hz flash.
    float clock = fmod(elapsed_time * max(speed, 0.0), 1024.0);
    float breathe = 0.88 + 0.12 * sin(clock * 0.35);

    float reach = (0.016 + 0.020 * max(amount, 0.0)) * breathe;
    float blur = max(reach * 0.45, 0.001);
    float2 aim = float2(
        0.55 + (center_x - 0.5) * 2.0,
        0.75 + (center_y - 0.5) * 2.0);
    aim /= max(length(aim), 0.001);
    float2 drop = float2(aim.x * reach / safe_aspect, aim.y * reach);
    float2 kernel = max(float2(blur / safe_aspect, blur), uv_pixel_interval);

    float ahead = 0.0;
    float weight_sum = 0.0;
    for (int j = -1; j <= 1; j++)
    {
        for (int i = -1; i <= 1; i++)
        {
            float ax = abs(float(i));
            float ay = abs(float(j));
            float w = lerp(2.0, 1.0, ax) * lerp(2.0, 1.0, ay);
            float2 tap = uv + drop + float2(float(i), float(j)) * kernel;
            ahead += coveredAlpha(tap) * w;
            weight_sum += w;
        }
    }
    ahead /= max(weight_sum, 0.001);

    // Trailing edge only: pixels whose down-light neighbor has left the silhouette.
    float shade = saturate(intensity * 0.65) * (1.0 - ahead) * saturate(base.a);
    float3 shadowed = base.rgb * lerp(1.0, 0.12, shade);
    float3 shown = lerp(base.rgb, shadowed, saturate(opacity));
    return float4(shown, alphaOut(base.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
