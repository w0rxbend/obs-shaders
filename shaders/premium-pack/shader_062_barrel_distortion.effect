// Filename: shader_062_barrel_distortion.effect
// Category: Lens / distortion pack
// Effect: Barrel distortion
// Visual principle: aspect-correct polynomial barrel; edges bow outward, center stays put.
// What makes it cool: the feed bends like a wide lens while a talking head stays recognizable.
// Suggested source type: webcam, game capture, image source, video source
// Suggested shader-chain combinations: this shader -> chromatic aberration -> bloom
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = image.Sample(textureSampler, clamp(uv, 0.0, 1.0));

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 from_center = uv - center;
    from_center.x *= aspect;

    float radius_sq = dot(from_center, from_center);
    float radius_4th = radius_sq * radius_sq;
    // Defaults sit near 1. Scale them into a mild positive barrel so the face stays framed.
    // One sine turn. Wrapping the phase keeps a long stream from stepping the pulse.
    float phase = fmod(elapsed_time * speed, 6.28318530718);
    float pulse = 1.0 + 0.12 * sin(phase);
    float k1 = 0.22 * intensity * pulse;
    float k2 = 0.04 * amount;
    float scale = 1.0 + k1 * radius_sq + k2 * radius_4th;

    float2 warped_offset = from_center * scale;
    warped_offset.x /= max(aspect, 0.001);
    float2 sample_uv = clamp(center + warped_offset, 0.0, 1.0);
    float4 warped = image.Sample(textureSampler, sample_uv);

    float mix_weight = saturate(opacity);
    float3 rgb = lerp(source.rgb, warped.rgb, mix_weight);
    float sampled_alpha = lerp(source.a, warped.a, mix_weight);
    return float4(rgb, alphaOut(sampled_alpha));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
