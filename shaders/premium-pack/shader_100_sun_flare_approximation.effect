// Filename: shader_100_sun_flare_approximation.effect
// Category: Weather / atmosphere pack
// Effect: Sun flare approximation
// Visual principle: aspect-correct sun disk, warm halo, anamorphic streak, and a few lens ghosts.
// What makes it cool: a live sun flare sits on the picture without a second pass or a dirt texture.
// Suggested source type: webcam, game capture, video source, image source
// Suggested shader-chain combinations: this shader -> cinematic grade -> lens dirt
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 sun = float2(center_x, center_y);
    float2 p = uv - sun;
    p.x *= aspect;
    float dist = length(p);

    // One breathe cycle is many seconds at the default speed, so the frame never strobes.
    float breathe = fmod(elapsed_time * speed * 0.25, 6.28318530718);
    float pulse = 0.84 + 0.16 * sin(breathe);
    float boost = intensity * pulse;
    float spread = saturate(amount * 0.5);

    float halo_span = lerp(0.012, 0.028, spread);
    float core = exp(-(dist * dist) / max(0.0018, 0.001));
    float halo = exp(-(dist * dist) / max(halo_span, 0.001));
    float air = exp(-(dist * dist) / max(0.07, 0.001));

    float streak_reach = lerp(2.4, 0.85, spread);
    float streak = exp(-(p.y * p.y) / max(0.0016, 0.001)) * exp(-abs(p.x) * streak_reach);

    float spin = fmod(elapsed_time * speed * 0.15, 6.28318530718);
    float2 dir = float2(cos(spin), sin(spin));
    float across = p.x * dir.y - p.y * dir.x;
    float along = abs(dot(p, dir));
    float ray = exp(-(across * across) / max(0.0014, 0.001)) * exp(-along * lerp(1.8, 0.7, spread));

    float ang = atan2(p.y, p.x);
    float spikes = pow(abs(sin(ang * 3.0)), 16.0) * exp(-dist * 4.2);

    // Ghosts sit on the line that reflects the sun through the frame center.
    float2 axis = sun - float2(0.5, 0.5);
    axis.x *= aspect;
    float2 q = uv - float2(0.5, 0.5);
    q.x *= aspect;
    float ghost1 = exp(-dot(q + axis * 0.48, q + axis * 0.48) / max(0.0032, 0.001));
    float ghost2 = exp(-dot(q + axis * 1.05, q + axis * 1.05) / max(0.009, 0.001));
    float ghost3 = exp(-dot(q - axis * 0.62, q - axis * 0.62) / max(0.0024, 0.001));
    float ring_band = length(q + axis * 0.82) - 0.055;
    float ring = exp(-(ring_band * ring_band) / max(0.0012, 0.001));

    float3 flare = float3(1.0, 0.97, 0.86) * core * 0.72;
    flare += float3(1.0, 0.66, 0.24) * halo * 0.20;
    flare += float3(1.0, 0.78, 0.42) * air * 0.08;
    flare += float3(1.0, 0.90, 0.58) * streak * 0.18;
    flare += float3(1.0, 0.84, 0.50) * ray * 0.10;
    flare += float3(1.0, 0.95, 0.80) * spikes * 0.16;
    flare += float3(0.45, 0.78, 1.0) * ghost1 * 0.16 * amount;
    flare += float3(1.0, 0.48, 0.28) * ghost2 * 0.11 * amount;
    flare += float3(0.62, 1.0, 0.70) * ghost3 * 0.09 * amount;
    flare += float3(0.88, 0.94, 1.0) * ring * 0.08 * amount;
    flare *= boost;

    float3 lit = saturate(source.rgb + flare);
    float3 rgb = lerp(source.rgb, lit, saturate(opacity));
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
