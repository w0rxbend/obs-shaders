// Filename: shader_027_desert_dust_grade.effect
// Category: Cinematic camera pack
// Effect: Desert dust grade
// Visual principle: luminance-aware color remapping, contrast shaping, vignette, and animated grain.
// What makes it cool: it gives ordinary footage a clear emotional direction in one pass.
// Suggested source type: webcam, game capture, video source, cinematic scenes
// Suggested shader-chain combinations: exposure controls -> this shader -> film grain
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = saturate(sampled_alpha);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);
    float luma = luma3(color.rgb);
    float strength = max(intensity, 0.0) * max(amount, 0.0);

    float lift = min(0.07 * strength, 0.16);
    float3 sand_shadow = float3(0.55, 0.38, 0.18);
    float3 graded = color.rgb * (1.0 - lift) + sand_shadow * lift;

    float highlight = smoothstep(0.55, 1.0, luma);
    graded = lerp(graded, graded * float3(1.08, 0.88, 0.55), saturate(highlight * 0.32 * strength));

    float3 sand = float3(1.06, 0.90, 0.62);
    graded = lerp(graded, graded * sand, saturate(0.50 * strength));

    float3 dusty = float3(luma * 1.02, luma * 0.90, luma * 0.62);
    graded = lerp(graded, dusty, saturate(0.16 * strength));
    graded = (graded - 0.48) * (1.0 + min(0.10 * strength, 0.22)) + 0.48;

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float corner = 0.5 * length(float2(aspect, 1.0));
    float edge = length(from_center) / max(corner, 0.001);
    float shade = clamp(edge * 0.42, 0.0, 0.40) * saturate(strength);
    float vig = 1.0 - shade;
    graded *= float3(vig, vig * lerp(1.0, 0.97, saturate(strength)), vig * lerp(1.0, 0.86, saturate(strength)));

    float veil = min((0.04 + 0.05 * uv.y) * strength, 0.16);
    graded = lerp(graded, float3(0.84, 0.66, 0.40), veil);

    float2 pixels = max(uv_size, float2(1.0, 1.0));
    float grain_tick = floor(elapsed_time * speed * 1.5);
    float grain = hash12(floor(uv * pixels * 0.45) + float2(grain_tick, grain_tick * 0.37)) - 0.5;
    graded += grain * min(0.03 * strength, 0.05) * float3(1.0, 0.86, 0.55);

    float2 wind = float2(-0.55, 0.22) * elapsed_time * speed;
    float2 field = uv * float2(aspect, 1.0) * 22.0 + wind;
    float2 cell = floor(field);
    float2 local = field - cell;
    float spawn = hash12(cell);
    float2 spot = float2(hash12(cell + float2(3.1, 1.7)), hash12(cell + float2(8.2, 4.4)));
    float speck = smoothstep(0.07, 0.0, length(local - spot)) * step(0.93, spawn);
    graded = lerp(graded, float3(0.97, 0.84, 0.52), speck * saturate(0.50 * strength));

    float3 out_rgb = lerp(color.rgb, saturate(graded), saturate(opacity));
    return float4(out_rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
