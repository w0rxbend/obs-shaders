// Filename: shader_138_space_monitor_tint.effect
// Category: Sci-fi / fantasy expansion
// Effect: Space monitor tint
// Visual principle: cyan spacecraft-monitor grade, soft scanlines, edge falloff, and a slow refresh beam.
// What makes it cool: a talking head stays readable while the frame reads as a space-station display.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 color)
{
    return dot(color, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float alpha = sampled_alpha;
    if (!preserve_alpha)
    {
        alpha = 1.0;
    }
    return alpha * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float radius = length(from_center);

    // Wrap so a long stream does not lose the refresh phase.
    float clock = fmod(elapsed_time * speed, 1024.0);
    // Default speed 1.55 moves one faint beam down the frame about every 8 seconds.
    float beam = 1.0 - smoothstep(0.0, 0.03, abs(uv.y - frac(clock * 0.08)));

    float4 color = image.Sample(textureSampler, uv);
    float luma = luma3(color.rgb);
    float3 monitor = float3(0.55, 0.82, 1.0);
    float tint_mix = saturate(intensity * 0.62);
    float3 graded = color.rgb * lerp(float3(1.0, 1.0, 1.0), monitor, tint_mix);

    float shade = 1.0 - smoothstep(0.08, 0.55, luma);
    graded = lerp(graded, float3(0.03, 0.10, 0.22), shade * saturate(amount * 0.18));

    float lines = 0.5 + 0.5 * sin(uv.y * 160.0 * 6.2831853);
    float scan = lerp(1.0, 0.82 + 0.18 * lines, saturate(amount * 0.35));
    graded *= scan;

    float falloff = smoothstep(0.45, 1.25, radius);
    graded *= 1.0 - falloff * saturate(intensity * 0.28);
    graded += beam * float3(0.35, 0.75, 1.0) * (0.06 * saturate(intensity));

    return float4(saturate(graded), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
