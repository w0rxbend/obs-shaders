// Filename: shader_014_paranormal_twitch.effect
// Category: Webcam motion pack
// Effect: Paranormal twitch
// Visual principle: animated UV camera transforms around a stable center point.
// What makes it cool: it makes a static source feel physically alive without moving the OBS source transform.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float2 rotate2d(float2 p, float a)
{
    float s = sin(a);
    float c = cos(a);
    return float2(p.x * c - p.y * s, p.x * s + p.y * c);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    // Wrap the clock so sine and the hash stay stable on a long stream.
    float wrapped_time = fmod(elapsed_time * speed, 1024.0);
    // High power keeps the frame still, then fires one short twitch burst.
    float burst = pow(saturate(sin(wrapped_time * 2.1) * 0.5 + 0.5), 18.0);
    float twitch_frame = fmod(floor(wrapped_time * 12.0), 1024.0);
    float strength = burst * amount * intensity;
    float2 jump = (float2(hash12(float2(twitch_frame, 2.0)), hash12(float2(twitch_frame, 5.0))) - 0.5) * 0.03 * strength;
    float roll = (hash12(float2(twitch_frame, 11.0)) - 0.5) * 0.05 * strength;
    float2 center = float2(center_x, center_y);
    float zoom = 1.04 + length(jump) * 2.5 + abs(roll) * 1.5;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - center) / max(zoom, 0.001);
    from_center.x *= aspect;
    from_center = rotate2d(from_center, roll);
    from_center.x /= max(aspect, 0.001);
    float2 warped_uv = center + from_center - jump;
    float4 warped = image.Sample(textureSampler, clamp(warped_uv, float2(0.0, 0.0), float2(1.0, 1.0)));
    return float4(warped.rgb, alphaOut(warped.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
