// Filename: shader_031_old_black_and_white_film.effect
// Category: Retro analog pack
// Effect: Old black and white film
// Visual principle: silver-gelatin grayscale, soft gate weave, grain, sparse scratches, and dust.
// What makes it cool: a talking head stays readable inside an old black-and-white print.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    // Wrap the clock so a long stream does not lose grain and scratch phase.
    float clock = elapsed_time - floor(elapsed_time * (1.0 / 120.0)) * 120.0;
    float t = clock * speed;
    float wear = saturate(amount);
    float grade = saturate(intensity);

    // Gate weave stays a fraction of the frame so the subject stays on screen.
    float weave_x = sin(t * 1.7) * 0.0035 * wear;
    float weave_y = sin(t * 0.9 + 1.2) * 0.0020 * wear;
    float2 film_uv = clamp(uv + float2(weave_x, weave_y), float2(0.0, 0.0), float2(1.0, 1.0));

    float4 source = image.Sample(textureSampler, uv);
    float4 film = image.Sample(textureSampler, film_uv);

    float luma = luma3(film.rgb);
    float contrast = 1.0 + 0.16 * grade;
    float tone = saturate((luma - 0.5) * contrast + 0.5);
    float3 silver = lerp(film.rgb, float3(tone, tone, tone), saturate(intensity * amount));

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float half_frame = length(float2(aspect * 0.5, 0.5));
    float vig = length(from_center) / max(half_frame, 0.001);
    float vignette = 1.0 - smoothstep(0.42, 1.05, vig);
    silver *= lerp(1.0 - 0.16 * grade, 1.0, vignette);

    float2 grain_cell = floor(uv * max(uv_size, float2(1.0, 1.0)) * 0.5);
    float grain_tick = floor(clock * speed * 12.0);
    float grain = hash12(grain_cell + float2(grain_tick, grain_tick * 0.37)) - 0.5;
    silver += grain * 0.055 * grade * wear;

    float column = floor(uv.x * 160.0);
    float along = frac(uv.x * 160.0);
    float scratch_frame = floor(t * 1.4);
    float scratch_id = hash12(float2(column, scratch_frame));
    float scratch_on = step(0.993, scratch_id);
    float scratch_line = 1.0 - smoothstep(0.0, 0.08, abs(along - 0.5));
    float scratch_gap = step(0.28, hash12(float2(floor(uv.y * 22.0), column + scratch_id)));
    silver += scratch_on * scratch_line * scratch_gap * 0.28 * wear;

    float2 dust_cell = floor(uv * float2(120.0, 68.0));
    float dust_n = hash12(dust_cell + float2(floor(t * 1.6), 3.1));
    float dust = step(0.996, dust_n);
    silver *= 1.0 - dust * 0.50 * wear;

    // Exposure breathe stays under 3 Hz at the default speed.
    silver *= 1.0 + sin(t * 1.3) * 0.025 * grade;

    float3 graded = saturate(silver);
    float3 out_rgb = lerp(source.rgb, graded, saturate(opacity));
    return float4(out_rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
