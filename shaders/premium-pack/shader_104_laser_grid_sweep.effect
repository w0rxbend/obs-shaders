// Filename: shader_104_laser_grid_sweep.effect
// Category: VJ / music video expansion
// Effect: Laser grid sweep
// Visual principle: a square cyan laser grid stays over the source while a thin band sweeps and flares the lines.
// What makes it cool: the scan reads as a stage laser, and the face between the lines stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    float2 plane = float2(from_center.x * aspect, from_center.y);
    float cells = max(5.0 + amount * 3.0, 0.001);
    float2 cell_frac = frac(plane * cells);
    float2 line_dist = min(cell_frac, 1.0 - cell_frac);

    float core_radius = 0.018;
    float glow_radius = 0.08;
    float line_x = 1.0 - smoothstep(core_radius, core_radius + glow_radius, line_dist.x);
    float line_y = 1.0 - smoothstep(core_radius, core_radius + glow_radius, line_dist.y);
    float grid = saturate(max(line_x, line_y) + line_x * line_y * 0.45);

    // Default speed 1.73 carries the band across the frame about once a second.
    float clock = fmod(elapsed_time * speed, 1024.0);
    float phase = frac(clock * 0.32);
    float sweep_pos = abs(phase * 2.0 - 1.0);
    float sweep = 1.0 - smoothstep(0.0, 0.055, abs(uv.y - sweep_pos));

    float3 cyan = float3(0.10, 0.82, 1.0);
    float3 hot = float3(1.0, 0.38, 0.70);
    float line_gain = 0.26 + sweep * 1.05;
    float3 laser = cyan * grid * line_gain;
    laser += hot * grid * sweep * 0.85;
    laser += cyan * sweep * 0.05;
    laser *= intensity * max(amount, 0.0);

    float3 rgb = saturate(color.rgb + laser * saturate(opacity));
    return float4(rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
