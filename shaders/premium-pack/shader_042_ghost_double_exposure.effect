// Filename: shader_042_ghost_double_exposure.effect
// Category: Horror / supernatural pack
// Effect: Ghost double exposure
// Visual principle: a pale second exposure, offset and slightly enlarged around center, screened onto the plate.
// What makes it cool: one live plate reads as two photographs, like a ghost still sitting in the frame.
// Suggested source type: webcam, horror games, video source, dramatic scenes
// Suggested shader-chain combinations: this shader -> ghost double image -> dark vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 source = image.Sample(textureSampler, uv);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float sway = sin(elapsed_time * speed * 0.9);
    float separation = (0.028 + 0.006 * sway) * amount;
    float ghost_scale = 1.0 + 0.045 * amount;

    float2 from_center = (uv - center) * float2(aspect, 1.0);
    float2 ghost_xy = from_center * ghost_scale + float2(separation * aspect, separation * 0.35);
    ghost_xy.x /= max(aspect, 0.001);
    float2 ghost_uv = clamp(center + ghost_xy, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 ghost = image.Sample(textureSampler, ghost_uv);

    float ghost_luma = dot(ghost.rgb, float3(0.299, 0.587, 0.114));
    float3 ghost_rgb = lerp(ghost.rgb, float3(ghost_luma, ghost_luma, ghost_luma), 0.45);
    ghost_rgb = saturate(ghost_rgb * float3(0.78, 0.92, 1.08) + float3(0.04, 0.06, 0.08));

    float expose = saturate(0.42 * intensity);
    float3 white = float3(1.0, 1.0, 1.0);
    float3 doubled = white - (white - source.rgb) * (white - ghost_rgb * expose);
    float3 out_rgb = saturate(lerp(source.rgb, doubled, saturate(opacity)));
    return float4(out_rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
