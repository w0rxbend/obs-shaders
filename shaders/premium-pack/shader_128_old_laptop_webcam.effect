// Filename: shader_128_old_laptop_webcam.effect
// Category: Portrait / beauty expansion
// Effect: Old laptop webcam
// Visual principle: cheap-lens barrel, coarse sensor softness, green-yellow cast, grain, and vignette.
// What makes it cool: a talking head reads as an early built-in laptop camera and the face stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float2 laptopLensUv(float2 uv, float look)
{
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 delta = uv - center;
    float2 scaled = delta * float2(aspect, 1.0);
    float radius_sq = dot(scaled, scaled);
    float barrel = 1.0 + radius_sq * (0.16 * look);
    return clamp(center + delta * barrel, float2(0.0, 0.0), float2(1.0, 1.0));
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float look = saturate(intensity * amount * 0.45);
    float2 lens = laptopLensUv(uv, look);
    float4 source = image.Sample(textureSampler, lens);

    float2 pixel = max(uv_pixel_interval, float2(0.001, 0.001));
    float2 cell = pixel * (3.0 + look * 7.0);
    float4 blur = source;
    blur += image.Sample(textureSampler, clamp(lens + float2(cell.x, 0.0), float2(0.0, 0.0), float2(1.0, 1.0)));
    blur += image.Sample(textureSampler, clamp(lens - float2(cell.x, 0.0), float2(0.0, 0.0), float2(1.0, 1.0)));
    blur += image.Sample(textureSampler, clamp(lens + float2(0.0, cell.y), float2(0.0, 0.0), float2(1.0, 1.0)));
    blur += image.Sample(textureSampler, clamp(lens - float2(0.0, cell.y), float2(0.0, 0.0), float2(1.0, 1.0)));
    blur *= 0.2;

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float edge = saturate(length(from_center));
    float2 fringe = float2(pixel.x * (1.2 + edge * 3.0) * look, 0.0);
    float red = image.Sample(textureSampler, clamp(lens + fringe, float2(0.0, 0.0), float2(1.0, 1.0))).r;
    float blue = image.Sample(textureSampler, clamp(lens - fringe, float2(0.0, 0.0), float2(1.0, 1.0))).b;
    float3 lowres = float3(lerp(blur.r, red, 0.7), blur.g, lerp(blur.b, blue, 0.7));
    float3 rgb = lerp(source.rgb, lowres, look);

    float luma = luma3(rgb);
    float3 dull = lerp(rgb, float3(luma, luma, luma), 0.42 * look);
    float3 shaped = (dull - 0.5) * lerp(1.0, 0.78, look) + 0.5;
    float3 tint = shaped * float3(1.05, 1.09, 0.84) + float3(0.02, 0.03, 0.0);
    shaped = lerp(shaped, tint, look);

    float2 grain_cell = floor(lens / max(cell, float2(0.001, 0.001)));
    float tick = floor(elapsed_time * speed * 2.0);
    float grain = hash12(grain_cell + float2(tick, tick * 0.37)) - 0.5;
    shaped += grain * (0.045 * look) * float3(1.05, 0.85, 1.15);

    // Exposure hunt stays near 0.06 Hz at the default speed, under a 3 Hz full-frame flash.
    float breath = sin(elapsed_time * speed * 0.40);
    shaped *= 1.0 + breath * 0.035 * look;

    float vignette = smoothstep(1.15, 0.28, length(from_center));
    shaped *= lerp(1.0 - 0.42 * look, 1.0, vignette);

    return float4(saturate(shaped), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
