// Filename: shader_060_corrupted_codec.effect
// Category: Cyberpunk / glitch pack
// Effect: Corrupted codec
// Visual principle: channel separation, block displacement, horizontal tears, and quantized corruption.
// What makes it cool: it creates readable digital failure while keeping the source recognizable.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);
    float t = fmod(elapsed_time * speed, 1024.0);
    // Default speed 1.37 times 2 stays under 3 pattern changes per second.
    float tick = floor(t * 2.0);
    float2 origin = float2(center_x - 0.5, center_y - 0.5);
    float2 local = uv - origin;
    float row = floor(local.y * (24.0 + amount * 28.0));
    float gate = step(0.68, hash12(float2(row, tick)));
    float shift = (hash12(float2(row * 3.1, tick + 1.0)) - 0.5) * 0.075 * amount * gate;
    float block = floor(local.x * 18.0) + floor(local.y * 10.0) * 31.0;
    float block_gate = step(0.78, hash12(float2(block, tick + 2.0)));
    float2 duv = float2(shift + block_gate * 0.025 * sin(t + block), 0.0);
    float spread = 0.006 * intensity + abs(shift) * 0.25;
    float rch = image.Sample(textureSampler, clamp(uv + duv + float2(spread, 0.0), 0.0, 1.0)).r;
    float gch = image.Sample(textureSampler, clamp(uv + duv, 0.0, 1.0)).g;
    float bch = image.Sample(textureSampler, clamp(uv + duv - float2(spread, 0.0), 0.0, 1.0)).b;
    float3 accent = float3(0.000, 0.900, 1.000);
    float3 out_rgb = lerp(float3(rch, gch, bch), accent, gate * 0.12 * intensity);
    float2 quant = floor(local * uv_size / 2.0);
    out_rgb += (hash12(quant + tick) - 0.5) * 0.07 * intensity;
    float3 shown = lerp(color.rgb, saturate(out_rgb), saturate(opacity));
    return float4(shown, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
