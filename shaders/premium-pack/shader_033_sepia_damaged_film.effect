// Filename: shader_033_sepia_damaged_film.effect
// Category: Retro analog pack
// Effect: Sepia damaged film
// Visual principle: sepia tone with gate weave, scratches, dust, grain, and slow flicker.
// What makes it cool: it sells nostalgic hardware instability with cheap procedural math.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: medium
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);
    float t = elapsed_time * speed;
    float damage = max(amount, 0.0);
    float grade = saturate(intensity);

    float weave_x = sin(t * 1.7) * 0.0035 * damage;
    float weave_y = sin(t * 1.15 + 0.6) * 0.0022 * damage;
    float2 film_uv = clamp(uv + float2(weave_x, weave_y), 0.0, 1.0);
    float3 filmed = image.Sample(textureSampler, film_uv).rgb;

    float luma = luma3(filmed);
    float3 sepia = float3(luma * 1.05 + 0.04, luma * 0.88 + 0.02, luma * 0.60);
    float3 graded = lerp(filmed, sepia, grade * 0.88);
    float contrast = 1.0 + min(grade * 0.12, 0.16);
    graded = (graded - 0.5) * contrast + 0.5;
    graded *= 1.0 + sin(t * 1.6) * 0.03 * damage;

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float corner = 0.5 * length(float2(aspect, 1.0));
    float edge = length(from_center) / max(corner, 0.001);
    graded *= 1.0 - smoothstep(0.50, 1.25, edge) * 0.38 * grade;

    float bucket = floor(t * 0.65);
    float break_y = hash12(float2(floor(uv.y * 70.0), bucket));
    float scratch = smoothstep(0.0025, 0.0, abs(uv.x - hash12(float2(bucket, 2.2))));
    scratch *= step(0.42, hash12(float2(bucket, 9.1))) * step(0.28, break_y);
    float scratch2 = smoothstep(0.0012, 0.0, abs(uv.x - hash12(float2(bucket, 5.4))));
    scratch2 *= step(0.68, hash12(float2(bucket, 12.7))) * step(0.22, break_y);
    float scratch_w = saturate((scratch + scratch2) * 0.85 * damage);
    graded = lerp(graded, float3(0.94, 0.84, 0.64), scratch_w);

    float hair_on = step(0.78, hash12(float2(bucket, 19.0)));
    float hair_y = hash12(float2(bucket, 23.0));
    float hair = smoothstep(0.0035, 0.0, abs(uv.y - hair_y - (uv.x - 0.5) * 0.06));
    graded = lerp(graded, graded * 0.32, hair * hair_on * saturate(0.55 * damage));

    float2 field = uv * float2(aspect, 1.0) * 26.0 + float2(bucket, 0.0);
    float2 cell = floor(field);
    float2 local = field - cell;
    float spawn = hash12(cell);
    float2 spot = float2(hash12(cell + float2(3.1, 1.7)), hash12(cell + float2(8.2, 4.4)));
    float speck_dist = length(local - spot);
    float dust_dark = smoothstep(0.09, 0.0, speck_dist) * step(0.975, spawn);
    float dust_light = smoothstep(0.06, 0.0, speck_dist) * step(0.992, spawn);
    graded = lerp(graded, graded * 0.22, dust_dark * saturate(0.8 * damage));
    graded = lerp(graded, float3(0.93, 0.86, 0.70), dust_light * saturate(0.7 * damage));

    float2 pixels = max(uv_size, float2(1.0, 1.0));
    float grain_tick = floor(t * 8.0);
    float grain = hash12(floor(uv * pixels * 0.33) + float2(grain_tick, grain_tick * 0.37)) - 0.5;
    graded += grain * 0.05 * grade * float3(1.0, 0.92, 0.74);

    float3 out_rgb = lerp(color.rgb, saturate(graded), saturate(opacity));
    return float4(out_rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
