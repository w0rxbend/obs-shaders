// Filename: shader_067_water_ripple.effect
// Category: Lens / distortion pack
// Effect: Water ripple
// Visual principle: radial or directional UV warping with small compensating zoom.
// What makes it cool: it bends the camera feed like a lens or energy field while preserving the source.
// Suggested source type: webcam, game capture, image source, video source
// Suggested shader-chain combinations: this shader -> chromatic aberration -> bloom
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float zoom = 1.0 + 0.03 * intensity;
    float2 zoomed = (uv - center) / max(zoom, 0.001);
    float2 stretched = zoomed * float2(max(aspect, 0.001), 1.0);
    float radius = length(stretched);
    float2 radial = stretched / max(radius, 0.001);

    // 2*pi period keeps both sines continuous after a long stream.
    float travel = fmod(elapsed_time * speed, 6.283185);
    float rings = 12.0 * amount;
    float primary = sin(radius * rings * 6.283185 - travel * 2.0);
    float harmonic = sin(radius * rings * 6.283185 * 2.0 - travel * 3.0);
    float wave = primary * 0.72 + harmonic * 0.28;
    float falloff = exp(-radius * 1.15) * saturate(radius / max(0.03, 0.001));
    float push = wave * falloff * 0.02 * intensity * (0.65 + 0.35 * amount);
    float2 ripple = float2(radial.x / max(aspect, 0.001), radial.y) * push;
    float2 sample_uv = clamp(center + zoomed + ripple, 0.0, 1.0);
    float4 warped = image.Sample(textureSampler, sample_uv);
    float3 shown = lerp(source.rgb, warped.rgb, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
