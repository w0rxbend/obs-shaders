// Filename: shader_150_corrupted_codec_blocks.effect
// Category: Extreme / transition expansion
// Effect: Corrupted codec blocks
// Visual principle: square macroblocks stay mostly sharp, while a few copy the wrong motion vector, collapse to one color, and pick up a chroma error.
// What makes it cool: a talking-head stays recognizable while scattered codec blocks fail around the frame.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return 1.0;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 pixel = float2(1.0 / max(uv_size.x, 1.0), 1.0 / max(uv_size.y, 1.0));
    float block_pixels = max(10.0 + max(amount, 0.0) * 18.0, 0.001);
    float2 cell = max(pixel * block_pixels, float2(0.001, 0.001));
    float2 block_id = floor(uv / cell);
    float2 block_center = (block_id + 0.5) * cell;
    float2 focus = float2(center_x, center_y);
    float2 from_focus = (block_center - focus) * float2(aspect, 1.0);
    float edge = saturate(length(from_focus) * 1.6);

    // Default speed 1.19 retargets macroblocks at about 1 Hz, not a full-frame flash.
    float wrapped = fmod(max(elapsed_time, 0.0), 1024.0);
    float tick = floor(wrapped * max(speed, 0.0) * 0.85);
    float chance = saturate(amount) * (0.22 + edge * 0.18);
    float corrupt = step(1.0 - chance, hash12(block_id + float2(tick, 3.0)));

    float2 jitter = float2(
        hash12(block_id.yx + float2(tick, 9.0)) - 0.5,
        hash12(block_id + float2(17.0, tick)) - 0.5
    );
    float hop = 1.0 + step(0.55, hash12(float2(block_id.x + block_id.y, tick + 2.0)));
    float drive = min(max(intensity, 0.0), 2.0);
    float2 motion = jitter * 2.0 * hop * cell * corrupt * min(drive, 1.5);
    float dc_gate = step(0.62, hash12(block_id + float2(tick, 21.0)));
    float2 shifted = uv + motion;
    float2 flat_uv = block_center + motion;
    float2 coded_uv = clamp(lerp(shifted, flat_uv, dc_gate * corrupt), 0.0, 1.0);

    float3 moved = image.Sample(textureSampler, coded_uv).rgb;
    float levels = max(14.0 - drive * 3.0, 4.0);
    float3 quantized = floor(moved * levels + 0.5) / max(levels, 0.001);
    float tint = hash12(block_id + float2(8.0, tick));
    float3 chroma = float3(0.72 + tint * 0.45, 0.92, 1.18 - tint * 0.35);
    float3 broken = lerp(quantized, quantized * chroma, 0.55);

    float3 dc = image.Sample(textureSampler, clamp(block_center, 0.0, 1.0)).rgb;
    float block_mix = min(0.34 * saturate(amount) * drive, 0.55);
    float3 blocked = lerp(source.rgb, dc, block_mix);
    float3 effected = saturate(lerp(blocked, broken, corrupt * saturate(drive)));
    float3 shown = lerp(source.rgb, effected, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
