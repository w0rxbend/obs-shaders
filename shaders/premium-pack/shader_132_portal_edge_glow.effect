// Filename: shader_132_portal_edge_glow.effect
// Category: Sci-fi / fantasy expansion
// Effect: Portal edge glow
// Visual principle: circular portal rim with a slow cyan-violet edge glow around a stable center.
// What makes it cool: it makes a static source feel physically alive without moving the OBS source transform.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float alpha = sampled_alpha;
    if (!preserve_alpha)
    {
        alpha = 1.0;
    }
    return alpha;
}

float angle_from(float y, float x)
{
    // Pack rule rejects atan2. One-argument atan stays inside the effect compiler.
    float ax = max(abs(x), 0.0001);
    float a = atan(y / ax);
    if (x < 0.0)
        a = (y < 0.0 ? -3.14159265 : 3.14159265) - a;
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // Scale x by source aspect so the portal stays circular.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 scaled = float2((uv.x - center.x) * aspect, uv.y - center.y);
    float dist = length(scaled);

    // amount 1.01 lands near 0.39 of frame height, so the rim frames a talking head.
    float radius = lerp(0.30, 0.48, saturate(amount * 0.5));
    float width = max(lerp(0.010, 0.030, saturate(intensity)), 0.001);
    float ring = abs(dist - radius);
    float core_span = max(width * 0.40, 0.001);
    float halo_span = max(width * 3.0, 0.001);
    float core = 1.0 - smoothstep(0.0, core_span, ring);
    float halo = 1.0 - smoothstep(0.0, halo_span, ring);

    // Wrap so a multi-hour stream does not lose the spark phase.
    float clock = elapsed_time - floor(elapsed_time * (1.0 / 120.0)) * 120.0;
    float spin = clock * max(speed, 0.0);
    float angle = angle_from(scaled.y, scaled.x);
    float lead = pow(saturate(0.5 + 0.5 * cos(angle * 3.0 - spin * 0.90)), 12.0);
    float trail = pow(saturate(0.5 + 0.5 * cos(angle * 2.0 + spin * 0.55 + 2.1)), 10.0);
    float spark = lerp(0.62, 1.0, saturate(lead * 0.70 + trail * 0.45));
    // 0.40*speed rad/s. Default 1.73 is about 0.11 Hz, under the 3 Hz full-frame cap.
    float breath = 0.84 + 0.16 * sin(spin * 0.40);

    float drive = max(intensity, 0.0);
    float hue = 0.5 + 0.5 * sin(angle + spin * 0.30);
    float3 energy = lerp(float3(0.20, 0.92, 1.0), float3(0.78, 0.22, 1.0), hue);

    float inside_end = max(radius, 0.001);
    float inside = 1.0 - smoothstep(inside_end - width, inside_end, dist);
    float outside = smoothstep(radius, radius + halo_span, dist);

    float3 portal = source.rgb;
    portal = lerp(portal, portal * float3(0.94, 0.98, 1.06), inside * 0.16 * saturate(drive));
    portal = lerp(portal, portal * 0.70, outside * 0.28 * saturate(drive));
    portal = lerp(portal, energy, saturate(core * breath * drive));
    portal += energy * halo * spark * breath * 0.42 * drive;
    portal = saturate(portal);

    float3 shown = lerp(source.rgb, portal, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
