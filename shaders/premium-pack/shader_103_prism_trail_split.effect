// Filename: shader_103_prism_trail_split.effect
// Category: VJ / music video expansion
// Effect: Prism trail split
// Visual principle: RGB samples peel apart along a slow prism axis, with short ghosts trailing behind the split.
// What makes it cool: a talking-head stays readable while color fringes and short trails make the frame feel like light through glass.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float2 shiftedUv(float2 uv, float2 axis, float along, float2 steer)
{
    return clamp(uv + axis * along + steer, 0.0, 1.0);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float phase = fmod(elapsed_time * max(speed, 0.0), 1024.0);
    float angle = phase * 0.22;
    float pulse = 0.82 + 0.18 * sin(phase * 0.55);
    // UV x covers a wider pixel span than y on non-square frames.
    float2 axis = float2(cos(angle) / max(aspect, 0.001), sin(angle));
    float2 pivot = float2(center_x, center_y);
    float2 from_pivot = (uv - pivot) * float2(aspect, 1.0);
    float radial = saturate(length(from_pivot));
    float spread = 0.0045 * max(intensity, 0.0) * max(amount, 0.0) * pulse * (0.70 + 0.45 * radial);
    float2 steer = (pivot - float2(0.5, 0.5)) * 0.012 * max(amount, 0.0);

    float3 prism = float3(
        image.Sample(textureSampler, shiftedUv(uv, axis, spread * 2.0, steer)).r,
        image.Sample(textureSampler, shiftedUv(uv, axis, spread * 0.15, steer)).g,
        image.Sample(textureSampler, shiftedUv(uv, axis, spread * -1.5, steer)).b);
    float3 ghost = float3(
        image.Sample(textureSampler, shiftedUv(uv, axis, spread * -3.0, steer)).r,
        image.Sample(textureSampler, shiftedUv(uv, axis, spread * -5.0, steer)).g,
        image.Sample(textureSampler, shiftedUv(uv, axis, spread * -7.2, steer)).b);

    float trail = 0.28 * saturate(intensity);
    float3 styled = saturate(lerp(prism, ghost, trail));
    float3 shown = lerp(source.rgb, styled, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
