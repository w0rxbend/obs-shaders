// Filename: shader_009_password_manager_destroyer.effect
// Category: Confidential / privacy pack
// Effect: Password manager destroyer
// Visual principle: large-kernel signal destruction with pixel quantization and procedural privacy noise.
// What makes it cool: it hides readable details but leaves the audience aware that real content exists underneath.
// Suggested source type: screen capture, browser source, IDEs, dashboards, documents
// Suggested shader-chain combinations: soft vignette -> this shader -> subtle noise or scanline overlay
// Performance cost: medium
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);

    float crush = clamp(intensity, 0.0, 2.0);
    float kernel = saturate(amount * 0.5);
    float2 pixels = max(uv_size, float2(1.0, 1.0));
    float2 pixel = max(abs(uv_pixel_interval), float2(0.001, 0.001));

    // Wide cells kill glyphs. Short cells keep each credential row as its own bar.
    float cell_w = lerp(18.0, 72.0, kernel);
    float cell_h = lerp(8.0, 22.0, kernel);
    float2 cell_px = max(float2(cell_w, cell_h), float2(0.001, 0.001));
    float2 cells = max(pixels / cell_px, float2(1.0, 1.0));
    float2 phase = float2(center_x, center_y);
    float2 quant = (floor(uv * cells + phase) + 0.5 - phase) / max(cells, float2(0.001, 0.001));
    quant = clamp(quant, 0.0, 1.0);

    float reach = lerp(12.0, 56.0, kernel);
    float2 smear_x = float2(pixel.x * reach, 0.0);
    float2 smear_y = float2(0.0, pixel.y * max(cell_h * 0.5, 0.001));

    float4 smear = image.Sample(textureSampler, quant) * 0.28;
    smear += image.Sample(textureSampler, clamp(quant + smear_x, 0.0, 1.0)) * 0.16;
    smear += image.Sample(textureSampler, clamp(quant - smear_x, 0.0, 1.0)) * 0.16;
    smear += image.Sample(textureSampler, clamp(quant + smear_x * 2.0, 0.0, 1.0)) * 0.10;
    smear += image.Sample(textureSampler, clamp(quant - smear_x * 2.0, 0.0, 1.0)) * 0.10;
    smear += image.Sample(textureSampler, clamp(quant + smear_x * 3.0, 0.0, 1.0)) * 0.06;
    smear += image.Sample(textureSampler, clamp(quant - smear_x * 3.0, 0.0, 1.0)) * 0.06;
    smear += image.Sample(textureSampler, clamp(quant + smear_y, 0.0, 1.0)) * 0.04;
    smear += image.Sample(textureSampler, clamp(quant - smear_y, 0.0, 1.0)) * 0.04;

    float gray = luma3(smear.rgb);
    float3 destroyed = lerp(smear.rgb, float3(gray, gray, gray), saturate(0.45 * crush));
    float3 vault = float3(0.16, 0.22, 0.28) * (0.55 + gray * 0.90);
    destroyed = lerp(destroyed, vault, saturate(0.22 * crush));
    destroyed *= lerp(1.0, 0.86, saturate(crush));

    // Noise steps stay under 3 Hz so a vault pane does not strobe on stream.
    float noise_hz = min(max(speed, 0.0), 2.5);
    float tick = floor(elapsed_time * noise_hz);
    float grain = hash12(floor(uv * cells) + float2(tick, 3.0));
    destroyed += (grain - 0.5) * 0.12 * min(crush, 1.5);
    destroyed = saturate(destroyed);

    float cover = saturate(0.82 + amount * 0.16) * saturate(crush) * saturate(opacity);
    float3 out_rgb = lerp(color.rgb, destroyed, cover);
    return float4(saturate(out_rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
