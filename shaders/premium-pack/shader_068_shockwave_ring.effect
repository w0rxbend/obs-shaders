// Filename: shader_068_shockwave_ring.effect
// Category: Lens / distortion pack
// Effect: Shockwave ring
// Visual principle: one aspect-correct ring expands from the center and refracts UVs on the crest; elsewhere the source stays put.
// What makes it cool: it bends the camera feed like a lens or energy field while preserving the source.
// Suggested source type: webcam, game capture, image source, video source
// Suggested shader-chain combinations: this shader -> chromatic aberration -> bloom
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 from_center = uv - center;
    from_center.x *= aspect;

    float radius = length(from_center);
    // Wrap travel so a long stream keeps one slow ring instead of a stuck phase.
    float travel = fmod(elapsed_time * speed, 3.0);
    float ring_radius = travel * 0.48;
    float half_width = 0.02 + 0.03 * amount;
    float ring = saturate(1.0 - abs(radius - ring_radius) / max(half_width, 0.001));
    ring *= ring;

    float2 radial = from_center / max(radius, 0.001);
    float push = ring * 0.025 * intensity;
    float2 displaced = from_center + radial * push;
    displaced.x /= max(aspect, 0.001);

    float2 sample_uv = clamp(center + displaced, 0.0, 1.0);
    float4 warped = image.Sample(textureSampler, sample_uv);

    float weight = saturate(opacity);
    float3 rgb = lerp(color.rgb, warped.rgb, weight);
    float sampled_alpha = lerp(color.a, warped.a, weight);
    return float4(rgb, alphaOut(sampled_alpha));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
