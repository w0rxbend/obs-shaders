// Filename: shader_015_vhs_frame_instability.effect
// Category: Webcam motion pack
// Effect: VHS frame instability
// Visual principle: vertical-hold slips, horizontal servo hunt, and one slow mid-frame tear.
// What makes it cool: a worn VCR loses lock while a talking head stays readable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float t = elapsed_time * speed;
    float gain = intensity * amount;
    float2 center = float2(center_x, center_y);

    float tick = floor(t * 1.4);
    float hunt_x = (hash12(float2(tick, 1.7)) - 0.5) * 0.036 * gain;
    float hunt_y = (hash12(float2(tick, 4.2)) - 0.5) * 0.050 * gain;
    float sway_x = sin(t * 0.85) * 0.010 * gain;
    float sway_y = sin(t * 0.37 + 2.0) * 0.008 * gain;
    float skew = (uv.y - center_y) * sin(t * 0.7) * 0.040 * gain;

    float tear_y = 0.18 + 0.64 * frac(t * 0.13);
    float slip_gate = step(tear_y, uv.y) * sin(t * 1.15);
    float slip_x = slip_gate * 0.022 * gain;
    float slip_y = slip_gate * 0.008 * gain;

    float2 shift = float2(hunt_x + sway_x + skew + slip_x, hunt_y + sway_y + slip_y);
    // Overscan keeps the servo slip inside the raster instead of pinning the border.
    float cover = 1.0 + 0.045 * gain;
    float2 held = center + (uv - center) / max(cover, 0.001) - shift;
    float4 frame = image.Sample(textureSampler, clamp(held, float2(0.0, 0.0), float2(1.0, 1.0)));
    return float4(saturate(frame.rgb), alphaOut(frame.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
