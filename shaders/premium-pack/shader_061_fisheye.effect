// Filename: shader_061_fisheye.effect
// Category: Lens / distortion pack
// Effect: Fisheye
// Visual principle: aspect-correct polynomial fisheye; the rim bows more than the face.
// What makes it cool: a round lens bulge bends the room while a talking head stays centered.
// Suggested source type: webcam, game capture, image source, video source
// Suggested shader-chain combinations: this shader -> chromatic aberration -> bloom
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    // Width is not height, so the bulge stays round instead of oval.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 from_center = uv - center;
    from_center.x *= aspect;

    // Wrap a long stream so the lens breathe does not lose precision.
    float clock = fmod(elapsed_time * speed, 1024.0);
    float breathe = 1.0 + 0.05 * sin(clock);
    // Gain keeps the written slider defaults a visible bulge that still holds a face.
    float curve = 0.55 * intensity * amount * breathe;
    float radius2 = dot(from_center, from_center);
    float lens = 1.0 / max(1.0 + curve * radius2, 0.001);

    from_center *= lens;
    from_center.x /= max(aspect, 0.001);
    float2 sample_uv = clamp(center + from_center, 0.0, 1.0);
    float4 warped = image.Sample(textureSampler, sample_uv);
    return float4(warped.rgb, alphaOut(warped.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
