// Filename: shader_085_posterize.effect
// Category: Experimental art pack
// Effect: Posterize
// Visual principle: per-channel color quantization into a small set of poster levels.
// What makes it cool: it makes live footage look intentionally illustrated instead of merely filtered.
// Suggested source type: webcam, image source, video source, VJ visuals
// Suggested shader-chain combinations: this shader -> posterize or halftone -> light vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float focus = 1.0 - smoothstep(0.2, 1.25, length(from_center));
    float mix_weight = saturate(intensity) * lerp(0.65, 1.0, focus);

    float steps = max(2.0 + amount * 10.0, 0.001);
    float2 pixel = floor(uv * max(uv_size, float2(1.0, 1.0)));
    float hash = frac(sin(dot(pixel, float2(12.9898, 78.233))) * 43758.5453);
    // 0.35 rad scale: default speed 0.83 breathes the dither about once every 20 seconds.
    float crawl = sin(elapsed_time * speed * 0.35);
    float dither = (hash - 0.5) * (0.35 + 0.25 * crawl);
    float3 quant = floor(source.rgb * steps + dither + 0.5) / steps;
    float3 poster = lerp(source.rgb, quant, mix_weight);

    return float4(saturate(poster), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
