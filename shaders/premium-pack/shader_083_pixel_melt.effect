// Filename: shader_083_pixel_melt.effect
// Category: Experimental art pack
// Effect: Pixel melt
// Visual principle: coarse pixel blocks drip downward in slow columns, weaker on the subject.
// What makes it cool: live footage melts like hot pixels while a talking head stays recognizable.
// Suggested source type: webcam, image source, video source, VJ visuals
// Suggested shader-chain combinations: this shader -> posterize or halftone -> light vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = image.Sample(textureSampler, clamp(uv, 0.0, 1.0));

    // Defaults sit near 1. A few blocks of drip keeps the face readable.
    float2 block_uv = max(uv_pixel_interval * (4.0 + amount * 4.0), float2(0.001, 0.001));
    float2 snapped = (floor(uv / block_uv) + 0.5) * block_uv;
    float column = floor(uv.x / max(block_uv.x, 0.001));
    float column_n = hash12(float2(column, 1.0));

    // One sine turn. Wrapping the phase keeps a long stream from stepping the drip.
    float turn = 6.28318530718;
    float phase = fmod(elapsed_time * speed, turn);
    float wave = 0.65 + 0.35 * sin(phase + column_n * turn);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = snapped - float2(center_x, center_y);
    from_center.x *= aspect;
    float edge = saturate(length(from_center) / max(0.72, 0.001));
    float gravity = saturate((snapped.y - center_y + 0.2) / max(0.8, 0.001));
    float falloff = saturate(edge * 0.65 + gravity * 0.35);
    float blocks_down = wave * intensity * (0.55 + 0.35 * amount) * lerp(0.55, 1.15, falloff);

    float2 melted_uv = clamp(snapped + float2(0.0, blocks_down * block_uv.y), 0.0, 1.0);
    float4 melted = image.Sample(textureSampler, melted_uv);

    float mix_weight = saturate(opacity);
    float3 rgb = lerp(source.rgb, saturate(melted.rgb), mix_weight);
    float sampled_alpha = lerp(source.a, melted.a, mix_weight);
    return float4(rgb, alphaOut(sampled_alpha));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
