// Filename: shader_125_tiktok_soft_glam.effect
// Category: Portrait / beauty expansion
// Effect: TikTok soft glam
// Visual principle: edge-aware skin softening, rosy highlight glow, lifted shadows, and a gentle face vignette.
// What makes it cool: a talking-head source keeps a recognizable face while the frame picks up a soft glam finish.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 sampleClamped(float2 uv)
{
    float2 safe_uv = clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0));
    return image.Sample(textureSampler, safe_uv);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = sampleClamped(uv);

    float reach = 1.25 + amount * 3.0;
    float2 near_px = uv_pixel_interval * reach;
    float2 far_px = near_px * 2.0;

    float3 soft_rgb = source.rgb * 0.36;
    soft_rgb += sampleClamped(uv + float2(near_px.x, 0.0)).rgb * 0.16;
    soft_rgb += sampleClamped(uv - float2(near_px.x, 0.0)).rgb * 0.16;
    soft_rgb += sampleClamped(uv + float2(0.0, near_px.y)).rgb * 0.16;
    soft_rgb += sampleClamped(uv - float2(0.0, near_px.y)).rgb * 0.16;

    float3 glow_rgb = sampleClamped(uv + float2(far_px.x, 0.0)).rgb;
    glow_rgb += sampleClamped(uv - float2(far_px.x, 0.0)).rgb;
    glow_rgb += sampleClamped(uv + float2(0.0, far_px.y)).rgb;
    glow_rgb += sampleClamped(uv - float2(0.0, far_px.y)).rgb;
    glow_rgb *= 0.25;

    float luma = dot(source.rgb, float3(0.299, 0.587, 0.114));
    float soft_luma = dot(soft_rgb, float3(0.299, 0.587, 0.114));
    float detail = saturate(abs(luma - soft_luma) * 7.0);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float center_dist = length(from_center);
    float face_reach = saturate(1.0 - center_dist * 0.85);
    float grade_amt = saturate(amount);
    float soften = saturate(grade_amt * 0.55) * (1.0 - detail) * lerp(0.65, 1.0, face_reach);

    float3 glam = lerp(source.rgb, soft_rgb, soften);
    float glam_luma = dot(glam, float3(0.299, 0.587, 0.114));
    glam += float3(1.0, 0.90, 0.86) * (1.0 - glam_luma) * 0.07 * grade_amt;
    glam = (glam - 0.5) * (1.0 + 0.08 * grade_amt) + 0.5;
    glam = lerp(glam, glam * float3(1.05, 0.96, 0.93), saturate(grade_amt * 0.70));

    float glow_luma = dot(glow_rgb, float3(0.299, 0.587, 0.114));
    float highlight = smoothstep(0.42, 0.85, glow_luma);
    // Default speed 1.73 * 0.45 is about 0.12 Hz, under a 3 Hz full-frame flash.
    float phase = fmod(elapsed_time * speed * 0.45, 6.283185307);
    float breathe = 0.90 + 0.10 * sin(phase);
    glam += glow_rgb * float3(1.0, 0.62, 0.70) * highlight * (0.16 * grade_amt) * breathe * lerp(0.45, 1.0, face_reach);

    float mid = saturate(1.0 - abs(glam_luma - 0.52) * 2.8);
    glam.r += mid * face_reach * 0.045 * grade_amt;
    glam.g += mid * face_reach * 0.012 * grade_amt;

    float vignette = smoothstep(1.25, 0.20, center_dist);
    glam *= lerp(1.0, lerp(0.90, 1.03, vignette), saturate(grade_amt * 0.55));

    float3 graded = lerp(source.rgb, saturate(glam), saturate(intensity * 0.72));
    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
