// Filename: shader_010_emergency_privacy_wipe.effect
// Category: Confidential / privacy pack
// Effect: Emergency privacy wipe
// Visual principle: large-kernel signal destruction with pixel quantization and procedural privacy noise.
// What makes it cool: it hides readable details but leaves the audience aware that real content exists underneath.
// Suggested source type: screen capture, browser source, IDEs, dashboards, documents
// Suggested shader-chain combinations: soft vignette -> this shader -> subtle noise or scanline overlay
// Performance cost: medium
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = saturate(sampled_alpha);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 plane = float2(uv.x * aspect, uv.y);
    float2 origin = float2(center_x * aspect, center_y);
    float dist = length(plane - origin);
    float frame_reach = length(float2(aspect * 0.5, 0.5));
    float wipe_radius = saturate(amount) * frame_reach * 1.5;
    float cover = saturate((wipe_radius - dist) * 12.0) * saturate(opacity);

    float2 pixels = max(uv_size, float2(1.0, 1.0));
    float crush = clamp(intensity, 0.0, 2.0);
    float crush_n = crush * 0.5;
    float block = max(lerp(28.0, 76.0, crush_n), 0.001);
    float2 cells = max(pixels / block, float2(1.0, 1.0));
    float2 cell_uv = (floor(uv * cells) + 0.5) / max(cells, float2(0.001, 0.001));
    cell_uv = clamp(cell_uv, 0.0, 1.0);

    float2 step_uv = max(uv_pixel_interval, float2(0.001, 0.001)) * (14.0 + amount * 26.0);
    // Corner taps are folded into the center so the shader stays at 6 samples.
    float4 kernel = image.Sample(textureSampler, cell_uv) * 0.60;
    kernel += image.Sample(textureSampler, clamp(cell_uv + float2(step_uv.x, 0.0), 0.0, 1.0)) * 0.10;
    kernel += image.Sample(textureSampler, clamp(cell_uv - float2(step_uv.x, 0.0), 0.0, 1.0)) * 0.10;
    kernel += image.Sample(textureSampler, clamp(cell_uv + float2(0.0, step_uv.y), 0.0, 1.0)) * 0.10;
    kernel += image.Sample(textureSampler, clamp(cell_uv - float2(0.0, step_uv.y), 0.0, 1.0)) * 0.10;

    float grain_cell = max(block * 0.4, 2.0);
    float tick = floor(elapsed_time * max(speed, 0.0) * 1.5);
    float grain = hash12(floor(uv * pixels / max(grain_cell, 0.001)) + tick);
    float gray = luma3(kernel.rgb);
    float3 plate = lerp(kernel.rgb, float3(gray, gray, gray), saturate(0.50 + 0.40 * crush_n));
    plate = lerp(plate, float3(0.080, 0.100, 0.120) * (0.40 + gray), saturate(0.22 + 0.40 * crush_n));
    plate += (grain - 0.5) * 0.16 * crush;
    float sweep = frac(elapsed_time * max(speed, 0.0) * 0.20);
    float band = saturate(1.0 - abs((uv.x + uv.y) * 0.5 - sweep) * 18.0);
    plate += band * 0.06 * crush_n;
    plate = saturate(plate);

    float3 out_rgb = lerp(source.rgb, plate, cover);
    return float4(out_rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
