// Filename: shader_105_strobe_smear.effect
// Category: VJ / music video expansion
// Effect: Strobe smear
// Visual principle: radial multi-tap smear around a stable center, stretched by a slow strobe.
// What makes it cool: the frame trails on a slow beat while a talking head stays readable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float2 delta = uv - float2(center_x, center_y);

    // 1.25 cycles per speed unit: default 0.65 is about 0.8 Hz, under a 3 Hz full-frame flash.
    float phase = frac(fmod(elapsed_time, 1024.0) * speed * 1.25);
    float rise = smoothstep(0.70, 0.86, phase);
    float fall = 1.0 - smoothstep(0.86, 0.97, phase);
    float pulse = rise * fall;

    float smear = (0.016 + 0.044 * pulse) * amount * intensity;
    float3 accum = source.rgb;
    float weight_sum = 1.0;

    [unroll]
    for (int tap = 1; tap <= 2; tap++)
    {
        float tap_f = float(tap);
        float weight = 1.0 / max(1.0 + tap_f, 0.001);
        float reach = tap_f * smear;
        float2 toward = clamp(uv - delta * reach, 0.0, 1.0);
        float2 away = clamp(uv + delta * reach, 0.0, 1.0);
        accum += image.Sample(textureSampler, toward).rgb * weight;
        accum += image.Sample(textureSampler, away).rgb * weight;
        weight_sum += weight * 2.0;
    }

    float3 smeared = accum / max(weight_sum, 0.001);
    float flash = 1.0 + pulse * 0.16 * intensity;
    float3 graded = saturate(smeared * flash);
    float3 shown = lerp(source.rgb, graded, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
