// Filename: shader_034_crt_scanlines.effect
// Category: Retro analog pack
// Effect: CRT scanlines
// Visual principle: CRT scanlines, slow field crawl, and mild phosphor chroma drift.
// What makes it cool: it sells nostalgic hardware instability with cheap procedural math.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float t = elapsed_time * speed;
    // 0.45*speed crawls the beam at 0.78 Hz when speed is 1.73, under a 3 Hz full-frame flash.
    float crawl = t * 0.45;
    float field = (frac(crawl) - 0.5) * uv_pixel_interval.y * amount;
    float drift = sin(crawl) * uv_pixel_interval.x * 1.5 * amount;
    float2 uv = clamp(v_in.uv + float2(0.0, field), 0.0, 1.0);
    float2 uv_r = clamp(uv + float2(drift, 0.0), 0.0, 1.0);
    float2 uv_b = clamp(uv - float2(drift, 0.0), 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float r = image.Sample(textureSampler, uv_r).r;
    float b = image.Sample(textureSampler, uv_b).b;
    float3 crt = float3(r, source.g, b);

    float row = uv.y * max(uv_size.y, 1.0) + (center_y - 0.5) * 2.0 + crawl;
    float scan = sin(row * 3.14159265) * 0.5 + 0.5;
    float line_strength = saturate(amount * 0.85);
    float scan_mul = lerp(1.0, lerp(0.42, 1.0, scan), line_strength);
    crt *= scan_mul;

    float pixel_x = floor(uv.x * max(uv_size.x, 1.0) + center_x * 3.0);
    float triad = max(3.0, 0.001);
    float sub = pixel_x - floor(pixel_x / triad) * 3.0;
    float3 grille = float3(
        lerp(0.86, 1.08, step(abs(sub - 0.0), 0.5)),
        lerp(0.86, 1.08, step(abs(sub - 1.0), 0.5)),
        lerp(0.86, 1.08, step(abs(sub - 2.0), 0.5)));
    crt *= lerp(float3(1.0, 1.0, 1.0), grille, line_strength * 0.25);

    float3 out_rgb = lerp(source.rgb, crt, saturate(intensity));
    return float4(saturate(out_rgb), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
