// Filename: shader_088_ink_outline.effect
// Category: Experimental art pack
// Effect: Ink outline
// Visual principle: Sobel luminance edges drawn as dark ink over the source.
// What makes it cool: it makes live footage look intentionally illustrated instead of merely filtered.
// Suggested source type: webcam, image source, video source, VJ visuals
// Suggested shader-chain combinations: this shader -> posterize or halftone -> light vignette
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float sampleLuma(float2 uv)
{
    float3 rgb = image.Sample(textureSampler, clamp(uv, 0.0, 1.0)).rgb;
    return dot(rgb, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float2 sample_uv = clamp(uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, sample_uv);

    float turn = 6.28318530718;
    float phase = fmod(elapsed_time * speed, turn);
    float pulse = 1.0 + 0.12 * sin(phase);
    float thickness = 0.5 + amount * 0.9;
    float2 px = uv_pixel_interval * thickness;

    float tl = sampleLuma(sample_uv + float2(-px.x, -px.y));
    float tc = sampleLuma(sample_uv + float2(0.0, -px.y));
    float tr = sampleLuma(sample_uv + float2(px.x, -px.y));
    float ml = sampleLuma(sample_uv + float2(-px.x, 0.0));
    float mr = sampleLuma(sample_uv + float2(px.x, 0.0));
    float bl = sampleLuma(sample_uv + float2(-px.x, px.y));
    float bc = sampleLuma(sample_uv + float2(0.0, px.y));
    float br = sampleLuma(sample_uv + float2(px.x, px.y));

    float gx = -tl - 2.0 * ml - bl + tr + 2.0 * mr + br;
    float gy = -tl - 2.0 * tc - tr + bl + 2.0 * bc + br;
    float edge = sqrt(gx * gx + gy * gy);

    // Webcam noise sits under this floor. A lower floor inks the cheeks.
    float edge_floor = 0.2;
    float outline = saturate((edge - edge_floor) / max(edge_floor, 0.001));
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (sample_uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float radial = saturate(length(from_center) / max(0.85, 0.001));
    float center_weight = lerp(0.72, 1.0, radial);
    float ink_weight = saturate(outline * intensity * center_weight * pulse) * saturate(opacity);
    float3 inked = lerp(source.rgb, float3(0.012, 0.012, 0.016), ink_weight);
    return float4(saturate(inked), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
