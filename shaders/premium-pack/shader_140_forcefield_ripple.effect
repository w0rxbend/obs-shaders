// Filename: shader_140_forcefield_ripple.effect
// Category: Sci-fi / fantasy expansion
// Effect: Forcefield ripple
// Visual principle: concentric energy rings expand from a stable center, bending the image and tinting each wavefront.
// What makes it cool: a sci-fi forcefield ripples across the shot while a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float alpha = sampled_alpha;
    if (!preserve_alpha)
    {
        alpha = 1.0;
    }
    return alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // Height-normalized so each forcefield ring stays circular.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 delta = uv - center;
    float2 stretched = float2(delta.x * aspect, delta.y);
    float radius = length(stretched);
    float2 radial = stretched / max(radius, 0.001);
    float2 dir = float2(radial.x / max(aspect, 0.001), radial.y);

    float drive = min(max(intensity, 0.0), 2.0);
    float density = saturate(amount * 0.5);
    float rings = lerp(5.0, 16.0, density);
    float strength = 0.55 + 0.45 * saturate(amount);
    // travel is cycles. Default speed 0.65 is 0.65 Hz, under the 3 Hz flash cap.
    float travel = fmod(elapsed_time * speed, 1.0);
    float wave = sin((radius * rings - travel) * 6.283185);
    float harmonic = sin((radius * rings * 2.0 - travel * 2.0) * 6.283185);
    float ripple = wave * 0.75 + harmonic * 0.25;
    float falloff = exp(-radius * 0.65);
    float center_guard = saturate(radius / 0.02);
    float push = ripple * falloff * center_guard * 0.012 * drive * strength;

    float2 sample_uv = clamp(uv + dir * push, 0.0, 1.0);
    float4 warped = image.Sample(textureSampler, sample_uv);

    float crest = pow(saturate(wave), 8.0);
    float echo = pow(saturate(harmonic), 10.0) * 0.45;
    float3 shield = float3(0.28, 0.78, 1.0);
    float glow = (crest + echo) * falloff * 0.32 * drive * strength;
    float3 styled = saturate(warped.rgb + shield * glow);
    float3 shown = lerp(source.rgb, styled, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
