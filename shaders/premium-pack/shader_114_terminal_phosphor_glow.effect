// Filename: shader_114_terminal_phosphor_glow.effect
// Category: Screen capture utility expansion
// Effect: Terminal phosphor glow
// Visual principle: green phosphor grade, soft highlight bloom, and steady scanlines around a chosen center.
// What makes it cool: a live source reads as a terminal CRT while the subject stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 sampleClamped(float2 uv)
{
    float2 safe_uv = clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0));
    return image.Sample(textureSampler, safe_uv);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = sampleClamped(uv);

    float spread = 1.25 + amount;
    float2 step_near = uv_pixel_interval * spread;
    float2 step_far = step_near * 2.0;

    float3 near_halo = sampleClamped(uv + float2(step_near.x, 0.0)).rgb;
    near_halo += sampleClamped(uv + float2(-step_near.x, 0.0)).rgb;
    near_halo += sampleClamped(uv + float2(0.0, step_near.y)).rgb;
    near_halo += sampleClamped(uv + float2(0.0, -step_near.y)).rgb;
    float3 far_halo = sampleClamped(uv + float2(step_far.x, 0.0)).rgb;
    far_halo += sampleClamped(uv + float2(-step_far.x, 0.0)).rgb;
    far_halo += sampleClamped(uv + float2(0.0, step_far.y)).rgb;
    far_halo += sampleClamped(uv + float2(0.0, -step_far.y)).rgb;
    float3 halo = near_halo * 0.16 + far_halo * 0.09;

    float luma = dot(source.rgb, float3(0.299, 0.587, 0.114));
    float halo_luma = dot(halo, float3(0.299, 0.587, 0.114));
    float highlight = smoothstep(0.28, 0.82, max(luma, halo_luma));
    float3 phosphor = float3(luma * 0.28, luma * 0.96, luma * 0.22);
    float grade_mix = saturate(0.45 + amount * 0.28);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float center_reach = saturate(1.0 - length(from_center));

    // Default speed 1.01 is about 0.16 Hz, under a 3 Hz full-frame flash.
    float breathe = 0.88 + 0.12 * sin(elapsed_time * speed);
    float rows = max(uv_size.y, 1.0);
    float scan = 0.92 + 0.08 * sin(uv.y * rows * 3.14159265);

    float3 glowed = lerp(source.rgb, phosphor, grade_mix);
    glowed += halo * float3(0.10, 0.42, 0.08) * highlight * breathe * lerp(0.7, 1.2, center_reach);
    glowed *= scan;

    float3 graded = lerp(source.rgb, glowed, saturate(intensity * 0.82));
    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
