// Filename: shader_111_focus_spotlight.effect
// Category: Screen capture utility expansion
// Effect: Focus spotlight
// Visual principle: a soft round pool keeps the subject bright while the unfocused field falls dark.
// What makes it cool: attention locks on a talking head without hiding the face.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);

    // Width/height keeps the pool round. Do not assume 16:9.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float dist = length(from_center);

    // One breath every several seconds. The pool stays on the subject.
    float cycle = frac(elapsed_time * speed * 0.125);
    float breath = sin(cycle * 6.283185) * 0.02;
    float inner = 0.36 + breath;
    float outer = inner + 0.22;
    float lit = 1.0 - smoothstep(inner, outer, dist);

    float edge_gain = 1.0 - saturate(amount);
    float falloff = (1.0 - lit) * saturate(intensity);
    float3 graded = saturate(lerp(color.rgb, color.rgb * edge_gain, falloff));
    float3 out_rgb = lerp(color.rgb, graded, saturate(opacity));
    return float4(out_rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
