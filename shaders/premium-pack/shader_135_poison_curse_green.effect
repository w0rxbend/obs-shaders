// Filename: shader_135_poison_curse_green.effect
// Category: Sci-fi / fantasy expansion
// Effect: Poison curse green
// Visual principle: sickly green veins, a slow curse ring, and edge mist over the source.
// What makes it cool: the frame looks poisoned while a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 color)
{
    return dot(color, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float alpha = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        alpha = 1.0;
    }
    return alpha * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float radius = length(from_center);

    // Wrap so a long stream does not quantize the curse phase.
    float clock = fmod(elapsed_time * speed, 1024.0);
    // Default speed 1.01 times 1.3 rad/s stays under one pulse per second.
    float pulse = 0.65 + 0.35 * sin(clock * 1.3);

    float vein_a = sin(from_center.x * 16.0 + from_center.y * 6.0 + clock * 1.1);
    float vein_b = sin(from_center.y * 21.0 - from_center.x * 4.5 - clock * 0.8);
    float veins = smoothstep(0.62, 0.94, saturate(vein_a * vein_b * 1.8));
    float ring_radius = 0.34 + 0.04 * sin(clock * 0.7);
    float ring = 1.0 - smoothstep(0.0, 0.03, abs(radius - ring_radius));
    float mist = smoothstep(0.42, 1.2, radius);
    float mask = saturate((veins * 0.85 + ring * 0.70 + mist * 0.40) * amount) * pulse;

    float2 boil = float2(
        sin(uv.y * 36.0 + clock * 2.0),
        sin(uv.x * 29.0 - clock * 1.7)) * (0.0035 * mask);
    float4 color = image.Sample(textureSampler, clamp(uv + boil, 0.0, 1.0));

    float shade = 1.0 - smoothstep(0.12, 0.82, luma3(color.rgb));
    float3 poison = float3(0.08, 0.78, 0.14);
    float3 sickly = color.rgb * float3(0.58, 1.22, 0.42);
    float3 graded = lerp(color.rgb, sickly, saturate(intensity * 0.28));
    float3 vein_color = saturate(sickly * 0.72 + poison * (0.35 + 0.45 * shade));
    float3 cursed = lerp(graded, vein_color, saturate(mask * intensity * 0.62));
    return float4(saturate(cursed), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
