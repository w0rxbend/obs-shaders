// Filename: shader_115_browser_privacy_haze.effect
// Category: Screen capture utility expansion
// Effect: Browser privacy haze
// Visual principle: wide horizontal smear and a cool fog veil so browser text dies while page color blocks remain.
// What makes it cool: it hides readable details but leaves the audience aware that real content exists underneath.
// Suggested source type: screen capture, browser source, IDEs, dashboards, documents
// Suggested shader-chain combinations: soft vignette -> this shader -> subtle noise or scanline overlay
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float2 px = max(abs(uv_pixel_interval), float2(0.001, 0.001));
    float spread = lerp(18.0, 72.0, saturate(amount * 0.5));
    float2 hx = float2(px.x * spread, 0.0);
    float2 vy = float2(0.0, px.y * spread * 0.28);

    float4 center = image.Sample(textureSampler, uv);
    float4 haze = center * 0.24;
    haze += image.Sample(textureSampler, clamp(uv + hx, 0.0, 1.0)) * 0.15;
    haze += image.Sample(textureSampler, clamp(uv - hx, 0.0, 1.0)) * 0.15;
    haze += image.Sample(textureSampler, clamp(uv + hx * 2.0, 0.0, 1.0)) * 0.10;
    haze += image.Sample(textureSampler, clamp(uv - hx * 2.0, 0.0, 1.0)) * 0.10;
    haze += image.Sample(textureSampler, clamp(uv + hx * 3.0, 0.0, 1.0)) * 0.05;
    haze += image.Sample(textureSampler, clamp(uv - hx * 3.0, 0.0, 1.0)) * 0.05;
    haze += image.Sample(textureSampler, clamp(uv + vy, 0.0, 1.0)) * 0.08;
    haze += image.Sample(textureSampler, clamp(uv - vy, 0.0, 1.0)) * 0.08;

    float gray = luma3(haze.rgb);
    float veil = saturate(0.22 + 0.24 * intensity);
    float3 fog = float3(0.62, 0.66, 0.70) * (0.50 + gray * 0.55);
    float3 rgb = lerp(haze.rgb, fog, veil);
    rgb = lerp(rgb, float3(gray, gray, gray), saturate(0.18 * intensity));

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float band = max(4.0 + amount * 3.0, 0.001);
    float tick = floor(elapsed_time * max(speed, 0.0) * 0.7);
    float2 fog_cell = floor(float2(uv.x * aspect, uv.y) * float2(3.0, band));
    float n = hash12(fog_cell + float2(center_x * 9.0, center_y * 7.0 + tick));
    rgb *= 1.0 + (n - 0.5) * 0.10 * saturate(intensity);

    float3 out_rgb = lerp(center.rgb, rgb, saturate(opacity));
    float out_a = center.a;
    [branch]
    if (!preserve_alpha)
    {
        out_a = saturate(center.a);
    }
    return float4(saturate(out_rgb), out_a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
