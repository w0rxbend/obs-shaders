// Filename: shader_093_smoke_drift.effect
// Category: Weather / atmosphere pack
// Effect: Smoke drift
// Visual principle: layered value-noise wisps drift upward across the frame and lightly veil the source.
// What makes it cool: slow smoke crosses a static camera while the subject stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 point)
{
    float3 point3 = frac(float3(point.x, point.y, point.x) * 0.1031);
    point3 += dot(point3, point3.yzx + 33.33);
    return frac((point3.x + point3.y) * point3.z);
}

float valueNoise(float2 point)
{
    float2 cell = floor(point);
    float2 fade = frac(point);
    fade = fade * fade * (3.0 - 2.0 * fade);
    float corner_00 = hash12(cell);
    float corner_10 = hash12(cell + float2(1.0, 0.0));
    float corner_01 = hash12(cell + float2(0.0, 1.0));
    float corner_11 = hash12(cell + float2(1.0, 1.0));
    return lerp(lerp(corner_00, corner_10, fade.x), lerp(corner_01, corner_11, fade.x), fade.y);
}

float smokeDensity(float2 field, float time_seconds, float coverage)
{
    float wisp_scale = 2.2 + coverage * 0.8;
    // Positive y drift moves wisps toward uv.y = 0, which is up the frame.
    float2 rise = float2(time_seconds * 0.07, time_seconds * 0.12);
    float2 cross = float2(-time_seconds * 0.05, time_seconds * 0.08);
    float coarse = valueNoise(field * wisp_scale + rise);
    float fine = valueNoise(field * (wisp_scale * 2.05) + cross + float2(4.2, 1.3));
    float billow = coarse * 0.68 + fine * 0.32;
    return smoothstep(0.34, 0.72, billow);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float time_seconds = elapsed_time * speed;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 field = (uv - center) * float2(aspect, 1.0);
    float density = smokeDensity(field, time_seconds, amount);
    float2 drift_nudge = float2(
        valueNoise(field * 3.1 + float2(time_seconds * 0.08, 2.0)),
        valueNoise(field * 3.1 + float2(8.0, time_seconds * 0.06))) - 0.5;
    float nudge_scale = 0.01 * intensity * amount;
    float2 sample_uv = clamp(uv + drift_nudge * nudge_scale, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 source = image.Sample(textureSampler, sample_uv);
    // Peak mix stays under a full veil so a face stays readable at the default sliders.
    float veil = saturate(density * 0.30 * intensity * amount);
    float luma = dot(source.rgb, float3(0.299, 0.587, 0.114));
    float3 gray = float3(luma, luma, luma);
    float3 hazy = lerp(source.rgb, gray, veil * 0.55);
    float3 smoke_rgb = float3(0.74, 0.76, 0.78);
    float3 graded = saturate(lerp(hazy, smoke_rgb, veil));
    return float4(graded, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
