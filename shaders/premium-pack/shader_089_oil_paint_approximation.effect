// Filename: shader_089_oil_paint_approximation.effect
// Category: Experimental art pack
// Effect: Oil paint approximation
// Visual principle: edge-preserving brush smears around a center, light pigment steps, and a faint canvas tooth.
// What makes it cool: live footage reads as oil paint while a talking head stays recognizable.
// Suggested source type: webcam, image source, video source, VJ visuals
// Suggested shader-chain combinations: this shader -> posterize or halftone -> light vignette
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float3 sampleRgb(float2 uv)
{
    return image.Sample(textureSampler, clamp(uv, 0.0, 1.0)).rgb;
}

float4 regionStats(float3 a, float3 b, float3 c)
{
    float3 mean = (a + b + c) / 3.0;
    float spread = length(a - mean) + length(b - mean) + length(c - mean);
    return float4(mean, spread);
}

float angle_from(float y, float x)
{
    // Pack rule rejects atan2. One-argument atan stays inside the effect compiler.
    float ax = max(abs(x), 0.0001);
    float a = atan(y / ax);
    if (x < 0.0)
        a = (y < 0.0 ? -3.14159265 : 3.14159265) - a;
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 src = image.Sample(textureSampler, clamp(uv, 0.0, 1.0));
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = float2((uv.x - center_x) * aspect, uv.y - center_y);
    float ang = angle_from(from_center.y, from_center.x) + sin(elapsed_time * speed) * 0.22;
    float2 dir = float2(cos(ang), sin(ang));
    float reach = 1.0 + amount * 2.5;
    float2 along = float2(dir.x * uv_pixel_interval.x, dir.y * uv_pixel_interval.y) * reach;
    float2 across = float2(-dir.y * uv_pixel_interval.x, dir.x * uv_pixel_interval.y) * reach;

    float4 r0 = regionStats(
        sampleRgb(uv - along * 2.0 - across * 2.0),
        sampleRgb(uv - along - across * 2.0),
        sampleRgb(uv - along * 2.0 - across));
    float4 r1 = regionStats(
        sampleRgb(uv + along * 2.0 - across * 2.0),
        sampleRgb(uv + along - across * 2.0),
        sampleRgb(uv + along * 2.0 - across));
    float4 r2 = regionStats(
        sampleRgb(uv - along * 2.0 + across * 2.0),
        sampleRgb(uv - along + across * 2.0),
        sampleRgb(uv - along * 2.0 + across));
    float4 r3 = regionStats(
        sampleRgb(uv + along * 2.0 + across * 2.0),
        sampleRgb(uv + along + across * 2.0),
        sampleRgb(uv + along * 2.0 + across));

    float4 chosen = r0;
    if (r1.a < chosen.a)
    {
        chosen = r1;
    }
    if (r2.a < chosen.a)
    {
        chosen = r2;
    }
    if (r3.a < chosen.a)
    {
        chosen = r3;
    }

    float levels = max(7.0 + amount * 2.0, 0.001);
    float3 pigment = floor(chosen.rgb * levels + 0.5) / levels;
    float3 paint = lerp(chosen.rgb, pigment, 0.4);
    float cell = max(8.0 + amount * 6.0, 0.001);
    float2 pixel = float2(uv.x * uv_size.x, uv.y * uv_size.y);
    paint += (hash12(floor(pixel / cell)) - 0.5) * 0.05;

    float cover = saturate(intensity * 0.7);
    float3 rgb = lerp(src.rgb, saturate(paint), cover);
    return float4(rgb, alphaOut(src.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
