// Filename: shader_038_interlaced_jitter.effect
// Category: Retro analog pack
// Effect: Interlaced jitter
// Visual principle: scanlines, field jitter, chroma drift, and time-varying tape damage.
// What makes it cool: it sells nostalgic hardware instability with cheap procedural math.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: medium
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = image.Sample(textureSampler, uv);
    // 1024 * 3 * pi is a whole turn, so the comb does not pop on a long stream.
    float t = fmod(elapsed_time * speed, 1024.0);
    float row = uv.y * max(uv_size.y, 1.0) + (center_y - 0.5) * 8.0 + 64.0;
    float odd = fmod(floor(row), 2.0);
    float aim = (center_x - 0.5) * 0.012 * amount;
    float comb = (odd * 2.0 - 1.0) * sin(t * 3.14159265 * 3.0) * 6.0 * uv_pixel_interval.x * amount;
    float band = floor(uv.y * 18.0 + (center_y - 0.5) * 4.0);
    float tear_tick = floor(t * 1.0);
    float tear_roll = hash12(float2(band, tear_tick));
    float tear_on = step(0.72, tear_roll);
    float tear = (hash12(float2(band, tear_tick + 9.0)) - 0.5) * 0.008 * amount * tear_on;
    float shift = comb + tear + aim;
    float chroma = sin(t * 3.14159265) * 2.5 * uv_pixel_interval.x * amount;
    float2 uv_g = clamp(uv + float2(shift, 0.0), 0.0, 1.0);
    float2 uv_r = clamp(uv + float2(shift + chroma, 0.0), 0.0, 1.0);
    float2 uv_b = clamp(uv + float2(shift - chroma * 0.65, 0.0), 0.0, 1.0);
    float3 rgb = float3(
        image.Sample(textureSampler, uv_r).r,
        image.Sample(textureSampler, uv_g).g,
        image.Sample(textureSampler, uv_b).b);
    float line_strength = saturate(intensity * 0.55);
    rgb *= lerp(1.0, 0.52, odd * line_strength);
    float grain_tick = floor(t * 2.0);
    float grain = hash12(floor(float2(uv.x * max(uv_size.x, 1.0), row) / 3.0) + grain_tick) - 0.5;
    rgb += grain * 0.04 * intensity;
    return float4(saturate(rgb), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
