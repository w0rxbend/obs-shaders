// Filename: shader_039_tape_wrinkle.effect
// Category: Retro analog pack
// Effect: Tape wrinkle
// Visual principle: vertical tape creases that pinch the picture sideways and catch light on the ridge.
// What makes it cool: it sells nostalgic hardware instability with cheap procedural math.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: medium
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float noise1d(float coord)
{
    float i = floor(coord);
    float f = frac(coord);
    float a = hash12(float2(i, 2.3));
    float b = hash12(float2(i + 1.0, 2.3));
    float u = f * f * (3.0 - 2.0 * f);
    return lerp(a, b, u);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    // Wrap so a long stream does not quantize the crease phase.
    float t = fmod(elapsed_time * speed, 1024.0);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float tilt = (center_y - 0.5) * 0.40;
    float along = uv.x + (uv.y - 0.5) * tilt;
    float travel = t * 0.08;

    float coarse = noise1d(along * 3.5 + travel);
    float mid = noise1d(along * 8.0 - travel * 1.3 + 4.2);
    float fine = noise1d(along * 21.0 + travel * 0.5 + 9.0);
    float fold = (coarse - 0.5) * 0.70 + (mid - 0.5) * 0.30;
    float crinkle = fine - 0.5;

    float crease_x = center_x + sin(t * 0.15) * 0.025;
    float dx = (along - crease_x) * aspect;
    float crest = 1.0 - smoothstep(0.0, 0.045, abs(dx));
    float pinch = crest * sin(uv.y * 9.0 + t * 0.45);

    // Worst-case shift is about 0.019 * amount, so default 1.17 stays near 2% of width.
    float shift = (fold * 0.014 + pinch * 0.012) * amount;
    float2 warped = clamp(uv + float2(shift, 0.0), 0.0, 1.0);
    float4 sampled = image.Sample(textureSampler, warped);
    float shine = (crest * 0.10 + fold * 0.045 + crinkle * 0.03) * intensity;
    float3 tape = saturate(sampled.rgb + shine);
    return float4(tape, alphaOut(sampled.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
