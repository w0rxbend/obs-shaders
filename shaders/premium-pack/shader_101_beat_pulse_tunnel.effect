// Filename: shader_101_beat_pulse_tunnel.effect
// Category: VJ / music video expansion
// Effect: Beat pulse tunnel
// Visual principle: aspect-correct radial tunnel that punches inward on each beat.
// What makes it cool: the kick pulls the frame down a tube while a face near center stays readable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 p = uv - center;
    p.x *= aspect;

    float span_x = max(center.x, 1.0 - center.x) * aspect;
    float span_y = max(center.y, 1.0 - center.y);
    float reach = max(length(float2(span_x, span_y)), 0.001);
    float radius = length(p);
    float r_n = saturate(radius / reach);
    float2 dir = p / max(radius, 0.001);

    // fmod keeps one kick per speed-unit from drifting on a long stream.
    float beat_hz = max(speed, 0.0);
    float beat_clock = fmod(elapsed_time * beat_hz, 1.0);
    float beat_live = saturate(beat_hz * 1000.0);
    float kick = pow(saturate(1.0 - beat_clock), 3.0) * beat_live;

    float drive = amount * intensity;
    // Cubic rim bends the border into a tube. The hold term cancels that bend near the face.
    float curved = r_n * (1.0 + drive * 0.28 * r_n * r_n);
    float compensate = 1.0 / max(1.0 + drive * 0.011, 0.001);
    float zoom_pulse = kick * drive * 0.08 * r_n * r_n;
    float ring_band = 1.0 - saturate(abs(r_n - beat_clock) * 12.0);
    float ring = ring_band * drive * 0.015 * r_n * beat_live;
    float sampled_n = (curved - zoom_pulse + ring) * compensate;

    float edge = saturate((r_n - 0.42) / max(0.58, 0.001));
    float twist = sin(beat_clock * 6.283185307) * kick * drive * 0.12 * edge;
    float twist_s = sin(twist);
    float twist_c = cos(twist);
    dir = float2(dir.x * twist_c - dir.y * twist_s, dir.x * twist_s + dir.y * twist_c);

    float2 warped_p = dir * sampled_n * reach;
    warped_p.x /= max(aspect, 0.001);
    float2 warped_uv = center + warped_p;
    float4 warped = image.Sample(textureSampler, clamp(warped_uv, float2(0.0, 0.0), float2(1.0, 1.0)));

    // Shade stays on the rim so a beat cannot flash the whole frame black.
    float rim = saturate((r_n - 0.45) / max(0.55, 0.001));
    float shade = rim * rim * (0.35 + 0.25 * kick) * saturate(drive);
    float3 rgb = saturate(warped.rgb * lerp(1.0, 0.80, shade));
    return float4(rgb, alphaOut(warped.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
