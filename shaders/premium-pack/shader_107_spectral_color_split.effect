// Filename: shader_107_spectral_color_split.effect
// Category: VJ / music video expansion
// Effect: Spectral color split
// Visual principle: wavelength-weighted channel samples fan apart from a center, so edges throw a thin spectrum.
// What makes it cool: flat color stays true and a talking-head stays recognizable while edges show a live spectral split.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float3 bandWeight(int band)
{
    if (band == 0)
        return float3(0.56, 0.02, 0.00);
    if (band == 1)
        return float3(0.28, 0.20, 0.02);
    if (band == 2)
        return float3(0.12, 0.52, 0.10);
    if (band == 3)
        return float3(0.04, 0.22, 0.30);
    return float3(0.00, 0.04, 0.58);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // x is in width-pixels, y in height-pixels; divide x so the fan is circular.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 pivot = float2(center_x, center_y);
    float2 from_pivot = (uv - pivot) * float2(aspect, 1.0);
    float reach = max(length(float2(aspect * 0.5, 0.5)), 0.001);
    float radial = saturate(length(from_pivot) / reach);

    float phase = elapsed_time * max(speed, 0.0);
    float angle = phase * 0.18;
    float pulse = 0.85 + 0.15 * sin(phase * 0.35);
    float2 axis = float2(cos(angle) / max(aspect, 0.001), sin(angle));
    float drive = max(intensity, 0.0) * max(amount, 0.0);
    float spread = 0.0032 * drive * pulse * (0.55 + 0.45 * radial);

    // Per-channel weights sum to 1, so a flat color is unchanged and only edges split.
    float3 split_rgb = float3(0.0, 0.0, 0.0);
    [unroll]
    for (int band = 0; band < 5; band++)
    {
        float along = (float(band) - 2.0) * spread;
        float2 tap_uv = clamp(uv + axis * along, 0.0, 1.0);
        split_rgb += image.Sample(textureSampler, tap_uv).rgb * bandWeight(band);
    }

    float3 shown = lerp(source.rgb, saturate(split_rgb), saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
