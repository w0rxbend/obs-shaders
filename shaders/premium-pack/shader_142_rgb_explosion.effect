// Filename: shader_142_rgb_explosion.effect
// Category: Extreme / transition expansion
// Effect: RGB explosion
// Visual principle: red, green, and blue channels burst outward from a center on a slow ring.
// What makes it cool: the subject stays readable while a radial RGB shock leaves the center.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = saturate(v_in.uv);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    float2 radial = float2(from_center.x * aspect, from_center.y);
    float radius = length(radial);
    float2 direction = radial / max(radius, 0.001);

    // fmod keeps the burst phase stable on a long stream. Both rates stay under 3 Hz at max speed.
    float clock = fmod(elapsed_time * max(speed, 0.0), 1024.0);
    float pulse = 0.55 + 0.45 * sin(clock * 2.2);
    float ring_radius = frac(clock * 0.35) * 1.25;
    float ring = saturate(1.0 - abs(radius - ring_radius) * 5.0) * saturate(radius * 2.5);
    float edge_weight = 0.35 + 0.65 * saturate(radius);
    float spread = (0.008 * edge_weight * pulse + 0.010 * ring) * intensity * amount;

    float2 shift = direction * spread;
    shift.x /= max(aspect, 0.001);

    float2 red_uv = saturate(uv + shift * 1.65);
    float2 green_uv = saturate(uv + shift * 0.35);
    float2 blue_uv = saturate(uv - shift * 1.15);

    float3 burst = float3(
        image.Sample(textureSampler, red_uv).r,
        image.Sample(textureSampler, green_uv).g,
        image.Sample(textureSampler, blue_uv).b);
    float3 shown = lerp(source.rgb, saturate(burst), saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
