// Filename: shader_064_chromatic_aberration.effect
// Category: Lens / distortion pack
// Effect: Chromatic aberration
// Visual principle: radial red and blue channel split from an optical center, stronger toward the frame edge.
// What makes it cool: lens-like color fringes while the subject stays in place and recognizable.
// Suggested source type: webcam, game capture, image source, video source
// Suggested shader-chain combinations: this shader -> bloom
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float2 center = float2(center_x, center_y);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - center;
    float2 radial = float2(from_center.x * aspect, from_center.y);
    float dist = length(radial);
    float2 direction = radial / max(dist, 0.001);
    // Wrap so a long stream does not lose sine precision. Speed 0.83 is far under 3 Hz.
    float phase = fmod(elapsed_time * speed, 6.283185);
    float pulse = 0.82 + 0.18 * sin(phase);
    // 0.012 keeps the written default as edge fringe, not a smear across a talking head.
    float shift = dist * 0.012 * intensity * amount * pulse;
    float2 shift_uv = float2(direction.x / max(aspect, 0.001), direction.y) * shift;

    float2 green_uv = clamp(uv, 0.0, 1.0);
    float2 red_uv = clamp(uv + shift_uv, 0.0, 1.0);
    float2 blue_uv = clamp(uv - shift_uv, 0.0, 1.0);

    float4 green_sample = image.Sample(textureSampler, green_uv);
    float red = image.Sample(textureSampler, red_uv).r;
    float blue = image.Sample(textureSampler, blue_uv).b;
    float3 aberrated = saturate(float3(red, green_sample.g, blue));
    float3 shown = lerp(green_sample.rgb, aberrated, saturate(opacity));
    return float4(shown, alphaOut(green_sample.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
