// Filename: shader_071_rounded_corners.effect
// Category: Streamer branding pack
// Effect: Rounded corners
// Visual principle: screen-space rounded rectangle; corners fall off, the subject stays in frame.
// What makes it cool: it turns a plain source into a branded layout element.
// Suggested source type: webcam camera source, streamer layouts, browser source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> animated border
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass rounded rect; no external textures; speed only breathes the radius under 1 Hz at the default.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.5;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float roundedDistance(float2 p, float2 half_extent, float radius)
{
    float2 q = abs(p) - half_extent + radius;
    return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - radius;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    if (aspect < 0.001)
    {
        aspect = 1.0;
    }

    float2 p = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float2 half_extent = float2(0.5 * aspect, 0.5);
    float shortest = max(min(half_extent.x, half_extent.y) - 0.001, 0.0);
    // fmod keeps the phase stable on a long stream. 0.83 / tau stays near 0.13 Hz.
    float phase = fmod(elapsed_time * max(speed, 0.0), 6.283185);
    float wobble = sin(phase) * 0.015 * saturate(speed);
    float radius = min(max(amount * 0.16 + wobble, 0.0), shortest);

    float aa = max(length(float2(uv_pixel_interval.x * aspect, uv_pixel_interval.y)), 0.001);
    float inside = 1.0 - smoothstep(-aa, aa, roundedDistance(p, half_extent, radius));
    float cover = lerp(1.0, inside, saturate(intensity) * saturate(opacity));

    float3 rgb = color.rgb;
    float alpha = color.a * cover;
    if (!preserve_alpha)
    {
        rgb = lerp(float3(0.02, 0.025, 0.03), color.rgb, cover);
        alpha = 1.0;
    }
    return float4(rgb, alpha);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
