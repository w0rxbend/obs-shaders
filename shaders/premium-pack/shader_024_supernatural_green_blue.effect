// Filename: shader_024_supernatural_green_blue.effect
// Category: Cinematic camera pack
// Effect: Supernatural green blue
// Visual principle: luminance-aware color remapping, contrast shaping, vignette, and animated grain.
// What makes it cool: it gives ordinary footage a clear emotional direction in one pass.
// Suggested source type: webcam, game capture, video source, cinematic scenes
// Suggested shader-chain combinations: exposure controls -> this shader -> film grain
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);
    float luma = luma3(color.rgb);
    float color_push = saturate(amount * 0.45);
    float grade = saturate(intensity);
    float mid = saturate(1.0 - abs(luma - 0.5) * 2.0);
    float shadow = 1.0 - smoothstep(0.0, 0.50, luma);
    float highlight = smoothstep(0.58, 1.0, luma);

    float3 graded = lerp(color.rgb, float3(luma, luma, luma), mid * color_push * 0.45);
    graded = (graded - 0.5) * (1.0 + 0.16 * grade) + 0.5;

    float shadow_w = shadow * color_push;
    float3 green_blue = float3(0.18, 0.62, 0.52);
    graded = lerp(graded, graded * green_blue + float3(0.015, 0.045, 0.035), shadow_w);

    float3 cool = float3(0.82, 0.94, 1.06);
    graded = lerp(graded, graded * cool, highlight * grade * 0.40);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float vig = 1.0 - smoothstep(0.62, 1.35, length(from_center));
    graded *= lerp(0.86, 1.0, vig);

    float2 grain_cell = floor(uv * max(uv_size, float2(1.0, 1.0)) * 0.5);
    float grain = hash12(grain_cell + float2(elapsed_time * speed, 17.0)) - 0.5;
    graded += grain * 0.03 * grade;

    float3 shown = lerp(color.rgb, saturate(graded), saturate(opacity));
    return float4(shown, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
