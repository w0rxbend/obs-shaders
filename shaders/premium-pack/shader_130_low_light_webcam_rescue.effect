// Filename: shader_130_low_light_webcam_rescue.effect
// Category: Portrait / beauty expansion
// Effect: Low light webcam rescue
// Visual principle: shadow lift plus a tight luma-weighted denoise so a dark webcam face stays readable.
// What makes it cool: it pulls a talking head out of crushed blacks without blowing highlights or smearing features.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float luma = luma3(source.rgb);

    // Sub-pixel only. Speed never flashes the frame.
    float2 jitter = float2(sin(elapsed_time * speed), cos(elapsed_time * speed * 0.73));
    jitter *= uv_pixel_interval * 0.25;
    float radius = 0.5 + max(amount, 0.0);

    float3 acc = float3(0.0, 0.0, 0.0);
    float wsum = 0.0;
    [unroll]
    for (int j = -1; j <= 1; j++)
    {
        [unroll]
        for (int i = -1; i <= 1; i++)
        {
            float2 tap_uv = uv + jitter + float2(float(i), float(j)) * uv_pixel_interval * radius;
            tap_uv = clamp(tap_uv, 0.0, 1.0);
            float3 tap = image.Sample(textureSampler, tap_uv).rgb;
            float delta = luma3(tap) - luma;
            float ax = abs(float(i));
            float ay = abs(float(j));
            float w = exp(-delta * delta * 48.0) * lerp(1.0, 0.55, saturate((ax + ay) * 0.5));
            acc += tap * w;
            wsum += w;
        }
    }

    float3 denoised = acc / max(wsum, 0.001);
    float y = luma3(denoised);
    float shadow = 1.0 - smoothstep(0.04, 0.40, y);
    float denoise_mix = saturate(amount) * lerp(0.25, 0.9, shadow);
    float3 cleaned = lerp(source.rgb, denoised, denoise_mix);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float focus = saturate(1.0 - length(from_center) * 0.7);
    float reach = lerp(0.6, 1.0, focus);
    float lift_amt = max(intensity, 0.0) * reach;
    float3 toe = float3(0.09, 0.09, 0.085) * shadow * lift_amt;
    float gain = 1.0 + shadow * lift_amt * 0.42;
    float3 rescued = saturate(cleaned * gain + toe);
    float3 rgb = lerp(source.rgb, rescued, saturate(opacity));
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
