// Filename: shader_059_scanner_sweep.effect
// Category: Cyberpunk / glitch pack
// Effect: Scanner sweep
// Visual principle: a cyan scan bar travels the frame with a short fading trail.
// What makes it cool: the source stays readable while a HUD scanner reads the subject.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);
    float3 rgb = color.rgb;

    // 0.45 keeps the default near one pass every two seconds, not a full-frame flash.
    float sweep = frac(elapsed_time * speed * 0.45 + (center_y - 0.5));
    float half_width = max(0.003 + 0.010 * amount, 0.001);
    float line = 1.0 - smoothstep(0.0, half_width, abs(uv.y - sweep));

    float trail_span = max(0.04 + 0.10 * amount, 0.001);
    float behind = sweep - uv.y;
    float trail = (1.0 - saturate(behind / trail_span)) * step(0.001, behind);
    trail *= trail * (1.0 - line);

    float column = 1.0 - smoothstep(0.12, 0.90, abs(uv.x - center_x));
    float lamp = lerp(0.50, 1.0, column);
    float3 scan = float3(0.20, 0.95, 0.82);
    float3 out_rgb = rgb + scan * (trail * 0.10 + line * 0.36) * lamp * intensity;
    out_rgb += line * lamp * intensity * 0.14;

    return float4(saturate(out_rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
