// Filename: shader_094_ash_particles.effect
// Category: Weather / atmosphere pack
// Effect: Ash particles
// Visual principle: slow falling ash flakes and a faint gray veil, thinner over the subject.
// What makes it cool: live footage sits in drifting ash while a talking head stays recognizable.
// Suggested source type: webcam, image source, video source, VJ visuals
// Suggested shader-chain combinations: this shader -> light vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float2 ashLayer(float2 uv, float time_s, float scale, float seed)
{
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float cells = max(scale, 0.001);
    float2 grid = float2(uv.x * aspect, uv.y) * cells;
    float fall_phase = frac(time_s * (0.06 + seed * 0.025));
    float wind = (center_x - 0.5) * 0.22;
    float lift = (center_y - 0.5) * 0.16;
    // phase * cells is an integer at the wrap, so flakes do not pop.
    grid.x += frac(time_s * wind) * cells;
    grid.y += (fall_phase + frac(time_s * lift)) * cells;

    float2 cell = floor(grid);
    float2 local = frac(grid) - 0.5;
    float flake_id = hash12(cell + float2(seed, 4.1));
    float spawn_cut = lerp(0.88, 0.50, saturate(amount * 0.5));
    float spawn = step(spawn_cut, flake_id);
    float2 jitter = float2(
        hash12(cell + float2(seed + 2.0, 1.3)),
        hash12(cell + float2(8.0, seed + 5.0))) - 0.5;
    float2 delta = local - jitter * 0.40;
    delta.x *= 1.2;
    float radius = max(0.08 + max(amount, 0.0) * 0.055, 0.001) * (0.55 + flake_id * 0.7);
    float flake = 1.0 - smoothstep(radius * 0.28, radius, length(delta));
    float2 lump = delta - float2((flake_id - 0.5) * 0.16, 0.04);
    float lump_edge = max(radius * 0.62, 0.001);
    float lump_flake = 1.0 - smoothstep(radius * 0.15, lump_edge, length(lump));
    flake = max(flake, lump_flake) * spawn;
    float warm = flake * step(0.945, flake_id);
    return float2(flake, warm);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float time_s = elapsed_time * speed;
    float2 coarse = ashLayer(uv, time_s, 8.0, 1.0);
    float2 mid = ashLayer(uv, time_s, 15.0, 2.0);
    float2 fine = ashLayer(uv, time_s, 26.0, 3.0);
    float ash = coarse.x * 0.85 + mid.x * 0.65 + fine.x * 0.40;
    float warm = coarse.y + mid.y + fine.y;

    // Ash thins over the subject so a centered talking head stays readable.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float edge_w = smoothstep(0.10, 0.72, length(from_center));
    float cover = saturate(ash) * saturate(intensity * 0.70) * lerp(0.50, 1.0, edge_w);
    cover *= saturate(opacity);

    float3 cool = float3(0.10, 0.09, 0.08);
    float3 hot = float3(0.48, 0.24, 0.12);
    float3 ash_rgb = lerp(cool, hot, saturate(warm));
    float3 graded = lerp(source.rgb, ash_rgb, cover);
    float veil = saturate(intensity) * 0.07 * lerp(0.25, 1.0, edge_w) * saturate(opacity);
    graded = lerp(graded, graded * float3(0.84, 0.82, 0.78), veil);
    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
