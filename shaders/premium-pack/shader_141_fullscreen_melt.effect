// Filename: shader_141_fullscreen_melt.effect
// Category: Extreme / transition expansion
// Effect: Fullscreen melt
// Visual principle: slow drips pull the frame downward, shorter near the subject.
// What makes it cool: the whole picture melts while a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float vnoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + float2(1.0, 0.0));
    float c = hash12(i + float2(0.0, 1.0));
    float d = hash12(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

float alphaOut(float sampled_alpha)
{
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 from_center = uv - center;
    from_center.x *= aspect;
    float radial = saturate(length(from_center) / max(0.55, 0.001));
    float below = saturate((uv.y - center.y) / max(1.0 - center.y, 0.001));
    // Hold the face. Drips stay short near center and grow toward the bottom edge.
    float body = lerp(0.35, 1.0, saturate(below * 0.72 + radial * 0.28));

    // 0.08 cycles per speed unit: slider max 4 stays near 0.32 Hz, under a 3 Hz flash.
    float phase = frac(elapsed_time * speed * 0.08);
    float wave = sin(phase * 6.2831853);
    float breath = 0.82 + 0.18 * wave;

    float freq = 3.0 + amount * 5.0;
    float n = vnoise(float2(uv.x * freq * aspect, uv.y * 1.6 + wave * 0.35));
    float n2 = vnoise(float2(uv.x * freq * 2.4 * aspect + 4.0, uv.y * 3.0 - wave * 0.2));
    float drip = saturate(n * 0.6 + n2 * 0.4);
    float reach = (0.02 + 0.06 * drip) * breath * intensity * amount * body;
    float smear = (n2 - 0.5) * reach * 0.45;

    // UV y grows downward, so a smaller y lets the picture sag.
    float2 melted_uv = clamp(uv - float2(smear, reach), 0.0, 1.0);
    float2 trail_uv = clamp(uv - float2(smear * 0.5, reach * 1.65), 0.0, 1.0);
    float4 melted = image.Sample(textureSampler, melted_uv);
    float4 trail = image.Sample(textureSampler, trail_uv);

    float mix_weight = saturate(opacity);
    float3 dripped = lerp(melted.rgb, trail.rgb, 0.4);
    float3 rgb = lerp(source.rgb, saturate(dripped), mix_weight);
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
