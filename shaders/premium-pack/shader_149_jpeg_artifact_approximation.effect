// Filename: shader_149_jpeg_artifact_approximation.effect
// Category: Extreme / transition expansion
// Effect: JPEG artifact approximation
// Visual principle: macroblock chroma, coarse quantization, edge ringing, and slow mosquito noise.
// What makes it cool: the picture looks JPEG-compressed while a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 color)
{
    return dot(color, float3(0.299, 0.587, 0.114));
}

float3 quantizeRgb(float3 color, float steps)
{
    float safe_steps = max(steps, 0.001);
    return floor(color * safe_steps + 0.5) / safe_steps;
}

float3 lumaWithChroma(float luma, float3 chroma_rgb)
{
    float chroma_luma = luma3(chroma_rgb);
    float cr = chroma_rgb.r - chroma_luma;
    float cb = chroma_rgb.b - chroma_luma;
    float green = luma - (0.299 * cr + 0.114 * cb) / max(0.587, 0.001);
    return float3(luma + cr, green, luma + cb);
}

float alphaOut(float sampled_alpha)
{
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float block_px = lerp(8.0, 16.0, saturate(amount * 0.5));
    float2 pixel = max(abs(uv_pixel_interval), float2(0.001, 0.001));
    float2 block_uv = max(pixel * block_px, float2(0.001, 0.001));
    float2 origin = float2(center_x, center_y);
    float2 block_id = floor((uv - origin) / block_uv);
    float2 block_center = clamp(origin + (block_id + 0.5) * block_uv, 0.0, 1.0);
    float3 block = image.Sample(textureSampler, block_center).rgb;

    float sharp_y = luma3(source.rgb);
    float block_y = luma3(block);
    float luma_steps = max(8.0, 28.0 - intensity * 6.0);
    float chroma_steps = max(5.0, 16.0 - intensity * 5.0);
    float3 quantized_block = quantizeRgb(block, chroma_steps);
    float sharp_q = quantizeRgb(float3(sharp_y, sharp_y, sharp_y), luma_steps).x;
    float block_q = quantizeRgb(float3(block_y, block_y, block_y), luma_steps).x;
    float y = lerp(sharp_q, block_q, saturate(amount * 0.22));

    float2 away = uv - block_center;
    float2 dir = away / max(length(away), 0.001);
    float2 ring_uv = clamp(uv + dir * pixel * 2.5, 0.0, 1.0);
    float ring_y = luma3(image.Sample(textureSampler, ring_uv).rgb);
    float edge = saturate(abs(sharp_y - block_y) * 6.0);
    float ring = (sharp_y - ring_y) * edge * 0.22 * saturate(intensity * 0.5);
    // Default speed retargets edge speckle under 1 Hz, not a full-frame flash.
    float tick = floor(elapsed_time * speed * 0.6);
    float speckle = hash12(block_id + float2(tick, 5.0)) - 0.5;
    float mosquito = speckle * edge * 0.045 * saturate(intensity);
    y += ring + mosquito;

    float chroma_mix = saturate(0.65 + amount * 0.15);
    float3 chroma_rgb = lerp(source.rgb, quantized_block, chroma_mix);
    float3 jpeg = saturate(lumaWithChroma(y, chroma_rgb));
    float3 shown = lerp(source.rgb, jpeg, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
