// Filename: shader_056_matrix_terminal_green.effect
// Category: Cyberpunk / glitch pack
// Effect: Matrix terminal green
// Visual principle: phosphor-green terminal grade, scanlines, and falling matrix rain.
// What makes it cool: the source reads as a green terminal while a talking head stays recognizable.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, clamp(uv, 0.0, 1.0));
    float luma = luma3(color.rgb);

    float steps = 6.0;
    float quant = floor(luma * steps) / max(steps - 1.0, 0.001);
    float tone = lerp(luma, quant, saturate(amount * 0.30));
    float3 phosphor = float3(0.10, 0.92, 0.22);
    float3 green = phosphor * (0.12 + 0.95 * tone);
    float3 graded = lerp(color.rgb, green, saturate(intensity * 0.70));

    // Rain thins near the subject so a centered talking head stays readable.
    float aspect = max(uv_size.x / max(uv_size.y, 1.0), 0.001);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float edge_w = smoothstep(0.10, 0.85, length(from_center));

    float scan = lerp(0.80, 1.0, frac(uv.y * max(uv_size.y, 1.0) * 0.5));
    graded *= lerp(1.0, scan, saturate(amount * 0.45));

    float cols = 18.0 + 28.0 * saturate(amount);
    float rows = cols / aspect;
    float col = floor(uv.x * cols);
    float col_h = hash12(float2(col, 2.71));
    float clock = fmod(max(elapsed_time, 0.0), 4096.0);
    float head = frac(col_h * 8.0 + clock * speed * (0.45 + col_h * 0.90));
    float behind = frac(head - uv.y);
    float trail = saturate(1.0 - behind * (2.4 + col_h * 2.2));

    float2 cell = float2(col, floor(uv.y * rows));
    float2 cell_uv = frac(float2(uv.x * cols, uv.y * rows));
    float glyph_tick = floor(clock * (0.8 + speed));
    float glyph_h = hash12(cell + float2(glyph_tick, col_h * 13.0));
    float inside = step(0.15, cell_uv.x) * step(cell_uv.x, 0.85);
    inside *= step(0.08, cell_uv.y) * step(cell_uv.y, 0.92);
    float bits = step(0.45, frac(cell_uv.x * 3.0 + glyph_h * 2.0));
    bits *= step(0.40, frac(cell_uv.y * 5.0 + glyph_h));
    float glyph = inside * bits * step(0.28, glyph_h);

    float rain_gain = saturate(amount * 0.50) * saturate(intensity) * lerp(0.40, 1.0, edge_w);
    graded += float3(0.05, 0.55, 0.12) * trail * rain_gain;
    graded += float3(0.45, 1.0, 0.55) * glyph * trail * rain_gain;
    graded += float3(0.70, 1.0, 0.75) * smoothstep(0.06, 0.0, behind) * glyph * rain_gain;

    return float4(saturate(graded), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
