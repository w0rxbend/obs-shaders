// Filename: shader_113_dashboard_glass_dim.effect
// Category: Screen capture utility expansion
// Effect: Dashboard glass dim
// Visual principle: a wide cool glass pane dims and lightly frosts the picture, edged by a thin rim and a slow sheen.
// What makes it cool: dashboard glass lowers a bright capture while a talking head stays in place and recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float alpha = sampled_alpha;
    if (!preserve_alpha)
    {
        alpha = 1.0;
    }
    return alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float strength = saturate(intensity * 0.5);
    float reach = saturate(amount * 0.5);
    float half_w = lerp(0.46, 0.40, reach);
    float half_h = lerp(0.44, 0.38, reach);
    float2 center = float2(center_x, center_y);
    float2 from_center = uv - center;
    float2 delta = abs(from_center) - float2(half_w, half_h);
    float2 delta_h = float2(delta.x * aspect, delta.y);
    float signed_distance = length(max(delta_h, float2(0.0, 0.0))) + min(max(delta_h.x, delta_h.y), 0.0);
    float inside = 1.0 - smoothstep(0.0, 0.02, signed_distance);
    float rim = 1.0 - smoothstep(0.0, 0.012, abs(signed_distance));

    float2 texel = float2(1.0 / max(uv_size.x, 1.0), 1.0 / max(uv_size.y, 1.0));
    float frost_px = lerp(1.5, 4.5, reach);
    float2 frost_step = texel * frost_px;
    float3 blurred = source.rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(frost_step.x, 0.0), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv - float2(frost_step.x, 0.0), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(0.0, frost_step.y), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv - float2(0.0, frost_step.y), 0.0, 1.0)).rgb;
    blurred *= 0.2;

    float dim = lerp(1.0, 0.58, saturate(intensity * 0.50));
    float3 cooled = blurred * float3(0.90, 0.96, 1.04);
    float3 pane = lerp(blurred, cooled, saturate(intensity * 0.40)) * dim;

    // 0.045 UV/s at speed 1. Default 0.83 takes about 27 seconds to cross, under the 3 Hz flash cap.
    float sheen_travel = elapsed_time * max(speed, 0.0) * 0.045;
    float along = from_center.x * 0.72 + from_center.y * 0.38;
    float sheen_band = exp(-abs(frac((along - sheen_travel) / max(1.4, 0.001)) - 0.35) * 14.0);
    pane += float3(0.85, 0.92, 1.0) * sheen_band * inside * reach * 0.10;

    float surround_dim = lerp(1.0, 0.88, saturate(intensity * 0.50));
    float3 framed = lerp(source.rgb * surround_dim, pane, inside);
    framed = lerp(framed, float3(0.80, 0.88, 0.96), rim * strength * 0.40);
    framed = saturate(framed);

    float3 shown = lerp(source.rgb, framed, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
