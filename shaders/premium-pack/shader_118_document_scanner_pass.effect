// Filename: shader_118_document_scanner_pass.effect
// Category: Screen capture utility expansion
// Effect: Document scanner pass
// Visual principle: flatbed photocopy tone, a short CCD smear, feeder lines, and a slow scanner lamp.
// What makes it cool: a live source reads as a document scan while the person stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float smear = max(amount, 0.0);
    float2 px = float2(max(uv_pixel_interval.x, 0.0) * smear, 0.0);
    float3 left_rgb = image.Sample(textureSampler, clamp(uv - px, 0.0, 1.0)).rgb;
    float3 right_rgb = image.Sample(textureSampler, clamp(uv + px, 0.0, 1.0)).rgb;
    float3 smeared = (source.rgb + left_rgb + right_rgb) * 0.3333333;

    float contrast = 1.0 + 0.38 * intensity;
    float tone = saturate((luma3(smeared) - 0.48) * contrast + 0.50);
    float3 scanned = lerp(float3(0.10, 0.11, 0.12), float3(0.94, 0.95, 0.93), tone);

    float row = uv.y * max(uv_size.y, 1.0);
    float feeder = 0.5 + 0.5 * sin(row * 0.62);
    scanned *= lerp(0.955, 1.0, feeder);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 bed_uv = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float bed = smoothstep(0.35, 1.25, length(bed_uv));
    scanned = lerp(scanned, scanned * 0.82, bed * 0.40);

    // Default speed 1.73 moves the lamp at 0.38 Hz, under a 3 Hz full-frame flash.
    float rate = min(max(speed, 0.0) * 0.22, 2.0);
    float sweep = frac(elapsed_time * rate + (center_y - 0.5));
    float half_width = max(0.010 + 0.004 * amount, 0.001);
    float lamp = 1.0 - smoothstep(0.0, half_width, abs(uv.y - sweep));
    float aim = 1.0 - smoothstep(0.0, 0.85, abs(uv.x - center_x));
    float behind = sweep - uv.y;
    float trail_span = max(0.07, 0.001);
    float trail = (1.0 - saturate(behind / trail_span)) * step(0.0, behind) * (1.0 - lamp);
    scanned += float3(0.70, 0.74, 0.76) * lamp * aim * 0.22 * intensity;
    scanned += float3(0.22, 0.23, 0.21) * trail * aim * 0.20 * intensity;

    float2 grain_px = floor(uv * max(uv_size, float2(1.0, 1.0)));
    scanned += (hash12(grain_px) - 0.5) * 0.028 * intensity;

    float scan_mix = saturate(0.55 + 0.12 * intensity);
    float3 graded = lerp(smeared, scanned, scan_mix);
    float cover = saturate(amount * 0.80);
    float3 out_rgb = lerp(source.rgb, graded, cover);
    return float4(saturate(out_rgb), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
