// Filename: shader_095_lightning_flash.effect
// Category: Weather / atmosphere pack
// Effect: Lightning flash
// Visual principle: short cool-white strikes and a jagged bolt; the face stays visible between flashes.
// What makes it cool: it adds environmental storytelling without external image textures.
// Suggested source type: webcam, game capture, video source, image source
// Suggested shader-chain combinations: this shader -> cinematic grade -> lens dirt
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.37;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    // speed 1.37 opens a slot about every 1.7s. Peaks are 90ms, so the default stays under one strike a second.
    float slot_hz = speed * 0.42;
    float strike_clock = fmod(elapsed_time * slot_hz, 4096.0);
    float slot = floor(strike_clock);
    float age = frac(strike_clock) / max(slot_hz, 0.001);
    float strike_gate = step(0.28, hash12(float2(slot, 3.1))) * step(0.001, speed);
    float primary = pow(saturate(1.0 - age / max(0.09, 0.001)), 2.0);
    float echo_age = age - 0.14;
    float echo = pow(saturate(1.0 - echo_age / max(0.07, 0.001)), 2.0);
    float echo_gate = step(0.72, hash12(float2(slot, 9.2))) * step(0.0, echo_age) * step(echo_age, 0.07);
    float flash = strike_gate * saturate(primary + echo_gate * echo * 0.65);

    float row = floor(uv.y * 24.0);
    float row_frac = saturate(uv.y * 24.0 - row);
    float jag = lerp(
        hash12(float2(row, slot + 1.0)) - 0.5,
        hash12(float2(row + 1.0, slot + 1.0)) - 0.5,
        row_frac) * 0.18 * amount;
    float bolt_anchor = center_x + (hash12(float2(slot, 4.4)) - 0.5) * 0.62;
    float dist = abs((uv.x - bolt_anchor) * aspect - jag);
    float bolt_width = 0.01 + 0.02 * amount;
    float core = saturate(1.0 - dist / max(bolt_width, 0.001));
    float glow = saturate(1.0 - dist / max(bolt_width * 5.0, 0.001));
    float branch_anchor = bolt_anchor + (hash12(float2(slot, 6.6)) - 0.5) * 0.12;
    float branch_dist = abs((uv.x - branch_anchor) * aspect - (hash12(float2(row, slot + 8.0)) - 0.5) * 0.10 * amount);
    float branch = saturate(1.0 - branch_dist / max(bolt_width * 0.55, 0.001));
    branch = branch * branch * step(uv.y, center_y + 0.05);
    float near_center = saturate(1.15 - abs(uv.y - center_y));
    float bolt_mask = saturate(core * core + glow * 0.28 + branch * 0.7) * near_center * flash;

    float3 src = color.rgb;
    float3 rgb = src * (1.0 - 0.06 * saturate(amount));
    rgb += src * flash * 0.35 * intensity;
    rgb += float3(0.75, 0.86, 1.0) * flash * 0.12 * intensity;
    rgb += float3(0.90, 0.96, 1.0) * bolt_mask * intensity;
    rgb = lerp(rgb, rgb * float3(0.90, 0.95, 1.06), 0.10 * saturate(amount));
    return float4(saturate(rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
