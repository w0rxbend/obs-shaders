// Filename: shader_057_hologram_flicker.effect
// Category: Cyberpunk / glitch pack
// Effect: Hologram flicker
// Visual principle: cyan holographic tint, scanlines, sparse band dropouts, and a slow refresh beam.
// What makes it cool: the source stays recognizable while the picture flickers like a projected hologram.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // 2 Hz times speed. Default 0.83 steps near 1.7 Hz, under a 3 Hz full-frame flash.
    float wrapped = fmod(elapsed_time * speed, 1024.0);
    float tick = floor(wrapped * 2.0);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float edge = saturate(length(from_center));

    float band_rows = 16.0 + amount * 12.0;
    float band_row = floor(uv.y * band_rows);
    float band_on = step(0.9, hash12(float2(band_row, tick)));
    float jitter = (hash12(float2(band_row, tick + 4.0)) - 0.5) * 0.0035 * amount * band_on;
    float spread = 0.0022 * intensity + abs(center_x - 0.5) * 0.004;

    float2 shifted = clamp(uv + float2(jitter, 0.0), 0.0, 1.0);
    float rch = image.Sample(textureSampler, clamp(shifted + float2(spread, 0.0), 0.0, 1.0)).r;
    float gch = image.Sample(textureSampler, shifted).g;
    float bch = image.Sample(textureSampler, clamp(shifted - float2(spread, 0.0), 0.0, 1.0)).b;
    float3 rgb = float3(rch, gch, bch);

    float luma = dot(rgb, float3(0.299, 0.587, 0.114));
    float3 cyan = float3(0.20, 0.92, 1.0) * luma;
    float3 holo = lerp(rgb, cyan, saturate(intensity) * 0.52);

    float row_px = uv.y * max(uv_size.y, 1.0);
    float scan = sin((row_px + (center_y - 0.5) * 48.0) * 3.14159265);
    float scan_gate = saturate(scan * 0.5 + 0.5);
    float scan_mul = lerp(1.0, lerp(0.72, 1.0, scan_gate), saturate(amount) * 0.75);
    holo *= scan_mul;

    float dwell = hash12(float2(tick, 9.0));
    float flick = lerp(0.86, 1.0, dwell);
    float edge_dim = lerp(1.0, 0.9, edge);
    holo *= flick * edge_dim;

    float band_dim = lerp(1.0, 0.72, band_on * saturate(intensity));
    holo *= band_dim;

    float travel = frac(uv.y - center_y + wrapped * 0.15);
    float beam = 1.0 - smoothstep(0.0, 0.012, abs(travel - 0.5));
    holo += beam * float3(0.40, 0.90, 1.0) * 0.14 * saturate(intensity);

    float3 graded = saturate(holo);
    float3 out_rgb = lerp(source.rgb, graded, saturate(opacity));
    return float4(out_rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
