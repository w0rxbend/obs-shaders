// Filename: shader_126_instagram_peach_fade.effect
// Category: Portrait / beauty expansion
// Effect: Instagram peach fade
// Visual principle: lifted peach blacks, milky contrast, and a warm midtone fade.
// What makes it cool: a webcam gets the washed peach look of a faded film preset while the face stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float luma = luma3(source.rgb);

    float drive = intensity * 0.65 + amount * 0.35;
    float pulse = sin(elapsed_time * speed * 0.45) * 0.045 * saturate(drive);
    float strength = saturate(drive * 0.72 + pulse);

    float3 peach_shadow = float3(0.95, 0.55, 0.38);
    float lift = 0.15 * strength;
    float gain = 1.0 - 0.12 * strength;
    float3 graded = source.rgb * gain + peach_shadow * lift;

    float faded_luma = luma3(graded);
    float milk = 0.14 * strength;
    graded = lerp(graded, float3(faded_luma, faded_luma, faded_luma), milk);

    float skin_band = smoothstep(0.16, 0.34, luma) * (1.0 - smoothstep(0.60, 0.86, luma));
    graded = lerp(graded, graded * float3(1.08, 0.95, 0.84), skin_band * strength * 0.60);

    float highlight = smoothstep(0.68, 0.96, luma);
    graded = lerp(graded, graded * float3(1.02, 0.97, 0.90), highlight * strength * 0.35);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float edge = smoothstep(0.45, 1.30, length(from_center)) * strength * 0.14;
    graded = graded * (1.0 - edge) + peach_shadow * edge * 0.18;

    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
