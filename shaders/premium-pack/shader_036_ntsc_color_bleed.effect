// Filename: shader_036_ntsc_color_bleed.effect
// Category: Retro analog pack
// Effect: NTSC color bleed
// Visual principle: luma stays sharp while low-bandwidth NTSC chroma smears sideways, with a slow subcarrier crawl and a little comb leak.
// What makes it cool: it sells nostalgic hardware instability with cheap procedural math.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float3 rgb_to_yiq(float3 rgb)
{
    float y = dot(rgb, float3(0.299, 0.587, 0.114));
    float i = dot(rgb, float3(0.596, -0.274, -0.322));
    float q = dot(rgb, float3(0.211, -0.523, 0.312));
    return float3(y, i, q);
}

float3 yiq_to_rgb(float3 yiq)
{
    float r = yiq.x + 0.956 * yiq.y + 0.621 * yiq.z;
    float g = yiq.x - 0.272 * yiq.y - 0.647 * yiq.z;
    float b = yiq.x - 1.106 * yiq.y + 1.703 * yiq.z;
    return float3(r, g, b);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    // Wrap the clock so the crawl stays stable on a long stream.
    float clock = fmod(elapsed_time * speed, 1024.0);
    // 1.5 rad/s is about 0.24 Hz at the default speed, under a 3 Hz flash.
    float crawl = sin(clock * 1.5);
    float presence = saturate(intensity);
    // 0..1 fades the bleed in. Above 1 only widens it, so the slider does not double-fade.
    float smear = lerp(1.0, 2.0, saturate(intensity - 1.0));

    // Luma stays on this pixel. Only I/Q smear, which is the NTSC bandwidth limit.
    float tap_px = uv_pixel_interval.x * (0.5 + max(amount, 0.0) * 2.2) * smear;
    float bias_uv = ((center_x - 0.5) * 12.0 + crawl * 1.25) * uv_pixel_interval.x * smear;
    float leak_uv = (center_y - 0.5) * 4.0 * uv_pixel_interval.y * smear;

    float3 center_yiq = rgb_to_yiq(source.rgb);
    float2 chroma = center_yiq.yz;
    float weight_sum = 1.0;

    for (int tap = 1; tap <= 3; tap++)
    {
        float tap_f = float(tap);
        float weight = exp(-tap_f * 0.55);
        float2 uv_pos = clamp(float2(uv.x + bias_uv + tap_f * tap_px, uv.y + leak_uv), 0.0, 1.0);
        float2 uv_neg = clamp(float2(uv.x + bias_uv - tap_f * tap_px, uv.y + leak_uv), 0.0, 1.0);
        float3 yiq_pos = rgb_to_yiq(image.Sample(textureSampler, uv_pos).rgb);
        float3 yiq_neg = rgb_to_yiq(image.Sample(textureSampler, uv_neg).rgb);
        chroma += (yiq_pos.yz + yiq_neg.yz) * weight;
        weight_sum += weight * 2.0;
    }

    chroma /= max(weight_sum, 0.001);
    float3 graded = yiq_to_rgb(float3(center_yiq.x, chroma.x, chroma.y));
    float3 shown = lerp(source.rgb, saturate(graded), saturate(opacity) * presence);
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
