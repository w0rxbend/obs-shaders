// Filename: shader_072_animated_neon_border.effect
// Category: Streamer branding pack
// Effect: Animated neon border
// Visual principle: alpha-safe geometric masking, decorative frames, and procedural edge treatment.
// What makes it cool: it turns a plain source into a branded layout element.
// Suggested source type: webcam camera source, streamer layouts, browser source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> animated border
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.01;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float3 hueToRgb(float hue)
{
    float x = hue * 0.95492966;
    float r = abs(x - 3.0) - 1.0;
    float g = 2.0 - abs(x - 2.0);
    float b = 2.0 - abs(x - 4.0);
    return saturate(float3(r, g, b));
}

float alphaOut(float sampled_alpha)
{
    float alpha = sampled_alpha;
    if (!preserve_alpha)
    {
        alpha = 1.0;
    }
    return alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 edge = min(uv, float2(1.0, 1.0) - uv);
    float2 edge_in_height = float2(edge.x * aspect, edge.y);
    float inward = min(edge_in_height.x, edge_in_height.y);

    float on_horizontal = step(edge_in_height.y, edge_in_height.x);
    float on_left = step(uv.x, 0.5);
    float on_low_y = step(uv.y, 0.5);
    float low_y_along = uv.x;
    float high_y_along = 2.0 + (1.0 - uv.x);
    float right_along = 1.0 + uv.y;
    float left_along = 3.0 + (1.0 - uv.y);
    float horizontal_along = lerp(high_y_along, low_y_along, on_low_y);
    float vertical_along = lerp(right_along, left_along, on_left);
    float around = lerp(vertical_along, horizontal_along, on_horizontal) * 0.25;

    // 0.18*speed Hz chase and 0.25*speed Hz pulse. Both stay under 3 Hz at speed 1.01, and only the rim moves.
    float chase = frac(around + elapsed_time * speed * 0.18 + (center_x - 0.5));
    float pulse_phase = frac(elapsed_time * speed * 0.25 + (center_y - 0.5));
    float hue = frac(chase + elapsed_time * speed * 0.05) * 6.283185;
    float wave = 0.62 + 0.38 * sin(chase * 6.283185);
    float pulse = 0.78 + 0.22 * sin(pulse_phase * 6.283185);

    float width = 0.020 * max(amount, 0.0);
    float border_t = saturate(inward / max(width, 0.001));
    float core = 1.0 - smoothstep(0.0, 0.30, border_t);
    float halo = 1.0 - smoothstep(0.20, 1.0, border_t);
    float glow = (core * 0.80 + halo * 0.45) * wave * pulse * max(intensity, 0.0);

    float3 neon = hueToRgb(hue);
    float3 hot = lerp(neon, float3(0.85, 0.95, 1.0), saturate(core));
    float3 styled = saturate(source.rgb + hot * glow * saturate(opacity));
    float in_band = 1.0 - smoothstep(0.92, 1.0, border_t);
    float3 out_rgb = lerp(source.rgb, styled, in_band);
    return float4(out_rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
