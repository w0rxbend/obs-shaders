// Filename: shader_122_warm_portrait_lift.effect
// Category: Portrait / beauty expansion
// Effect: Warm portrait lift
// Visual principle: warm shadow lift, peach midtone bias, and a soft portrait vignette.
// What makes it cool: it flatters a webcam face with amber lift while the person stays recognizable.
// Suggested source type: webcam camera source, smartphone camera, portrait video
// Suggested shader-chain combinations: low-light correction -> this shader -> soft drop shadow
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float luma = luma3(source.rgb);
    float lift = min(intensity, 2.0);
    float warm_t = saturate(amount * 0.50 + sin(elapsed_time * speed * 0.40) * 0.04);

    float contrast = 1.0 + 0.05 * lift;
    float3 graded = (source.rgb - 0.5) * contrast + 0.5;

    float shadow = 1.0 - smoothstep(0.0, 0.42, luma);
    float3 neutral_lift = float3(0.050, 0.050, 0.050);
    float3 peach_lift = float3(0.130, 0.050, 0.016);
    graded += lerp(neutral_lift, peach_lift, warm_t) * shadow * lift * 0.55;
    graded += float3(0.018, 0.010, 0.004) * lift;

    float mid = smoothstep(0.06, 0.32, luma) * (1.0 - smoothstep(0.58, 0.90, luma));
    float3 warm_gain = lerp(float3(1.0, 1.0, 1.0), float3(1.09, 0.97, 0.88), warm_t);
    graded = lerp(graded, graded * warm_gain, saturate(mid * lift * 0.42));

    float highlight = smoothstep(0.78, 1.0, luma);
    graded = lerp(graded, graded * float3(0.98, 0.99, 1.0), highlight * saturate(lift) * 0.25);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float vignette = 1.0 - smoothstep(0.40, 1.20, length(from_center));
    float edge_dim = min(0.16, 0.09 * lift);
    graded *= lerp(1.0 - edge_dim, 1.0, vignette);

    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
