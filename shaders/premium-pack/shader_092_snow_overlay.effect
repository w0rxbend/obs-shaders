// Filename: shader_092_snow_overlay.effect
// Category: Weather / atmosphere pack
// Effect: Snow overlay
// Visual principle: two layers of falling flakes drift across the source without masking it.
// What makes it cool: snow reads clearly while a talking head stays recognizable.
// Suggested source type: webcam camera source, streamer layouts, browser source
// Suggested shader-chain combinations: this shader -> cool grade -> soft vignette
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float snowLayer(float2 uv, float cells, float fall_rate, float flake_scale)
{
    // uv is 0..1, so scale x by aspect or flakes stretch on wide frames.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float clock = elapsed_time * speed;
    float wind = (center_x - 0.5) * clock * 0.025;
    float2 grid = float2(
        uv.x * cells * aspect + wind * cells,
        uv.y * cells + clock * fall_rate + (center_y - 0.5) * cells);
    float2 id = floor(grid);
    float2 local = frac(grid) - 0.5;
    float n = hash12(id);
    float sway = sin(clock * 1.3 + n * 6.2) * 0.12;
    float dist = length(local - float2(sway, 0.0));
    float radius = (0.14 + 0.06 * hash12(id + float2(3.1, 8.4))) * flake_scale;
    float body = 1.0 - smoothstep(radius * 0.35, radius, dist);
    float keep = step(saturate(0.78 - 0.06 * amount), n);
    return body * keep;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);
    float near_flakes = snowLayer(uv, 14.0, 2.5, 1.0);
    float far_flakes = snowLayer(uv, 26.0, 4.0, 0.58);
    float cover = saturate(near_flakes + far_flakes * 0.7);
    float snow_mix = saturate(cover * 0.62 * intensity) * saturate(opacity);
    float3 snow = float3(0.93, 0.96, 1.0);
    float3 out_rgb = lerp(color.rgb, snow, snow_mix);
    return float4(saturate(out_rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
