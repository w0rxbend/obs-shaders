// Filename: shader_106_bass_glow_throb.effect
// Category: VJ / music video expansion
// Effect: Bass glow throb
// Visual principle: aspect-correct warm glow and a short highlight bloom on a slow bass throb.
// What makes it cool: the frame swells like a sub hit while a talking head stays readable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = max(uv_size.x / max(uv_size.y, 1.0), 0.001);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float dist = length(from_center);

    // speed is hits per second. Default 0.83 stays under a 3 Hz full-frame flash.
    float cycle = frac(fmod(elapsed_time, 1024.0) * speed);
    float wave = pow(0.5 + 0.5 * sin(cycle * 6.28318530718), 1.6);
    float throb = 0.40 + 0.60 * wave;

    float spread = saturate(amount * 0.5);
    float body_span = lerp(0.018, 0.085, spread);
    float body = exp(-(dist * dist) / max(body_span, 0.001));
    float core = exp(-(dist * dist) / max(0.007, 0.001));

    float reach = lerp(0.006, 0.030, spread);
    float reach_x = reach / max(aspect, 0.001);
    float3 bloom = float3(0.0, 0.0, 0.0);
    [unroll]
    for (int tap = 0; tap < 4; tap++)
    {
        float ang = 1.57079632679 * float(tap);
        float2 off = float2(cos(ang) * reach_x, sin(ang) * reach);
        float2 tap_uv = clamp(uv + off, 0.0, 1.0);
        float3 tap_rgb = image.Sample(textureSampler, tap_uv).rgb;
        float luma = dot(tap_rgb, float3(0.299, 0.587, 0.114));
        bloom += tap_rgb * luma;
    }
    bloom *= 0.25;

    float3 glow = float3(1.0, 0.36, 0.08) * body * 0.20;
    glow += float3(1.0, 0.62, 0.28) * core * 0.08;
    glow += bloom * float3(1.0, 0.48, 0.20) * 0.14;
    glow *= intensity * throb;

    float3 lit = saturate(source.rgb + glow);
    float3 shown = lerp(source.rgb, lit, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
