// Filename: shader_109_mirror_stage_flip.effect
// Category: VJ / music video expansion
// Effect: Mirror stage flip
// Visual principle: fold one stage wing across a center seam, then flip which wing is the mirror.
// What makes it cool: the set mirrors the performer and turns over without clearing the frame.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    // Height-relative x keeps a tilted seam circular on a wide frame.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 p = uv - center;
    p.x *= aspect;

    // 0.17 and 0.11 both close on 200*pi, so the wrap does not pop the seam.
    float motion_repeat = 628.318530718;
    float quarter_turn = 1.57079632679;
    float motion = fmod(elapsed_time * max(speed, 0.0), motion_repeat);
    float axis = sin(motion * 0.17) * quarter_turn * saturate(amount);
    float wave = cos(motion * 0.11);
    float swap = smoothstep(-0.15, 0.15, wave);

    float2 axis_dir = float2(cos(axis), sin(axis));
    float side = dot(p, axis_dir);
    float2 mirrored_p = p - axis_dir * (side * 2.0);
    mirrored_p.x /= max(aspect, 0.001);
    float2 mirrored_uv = clamp(center + mirrored_p, 0.0, 1.0);
    float4 mirrored = image.Sample(textureSampler, mirrored_uv);

    float reflect_weight = swap;
    if (side < 0.0)
    {
        reflect_weight = 1.0 - swap;
    }
    reflect_weight *= saturate(intensity);

    float3 rgb = lerp(source.rgb, mirrored.rgb, reflect_weight);
    float shown_alpha = lerp(source.a, mirrored.a, reflect_weight);
    return float4(rgb, alphaOut(shown_alpha));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
