// Filename: shader_054_broken_signal.effect
// Category: Cyberpunk / glitch pack
// Effect: Broken signal
// Visual principle: channel separation, block displacement, horizontal tears, and quantized corruption.
// What makes it cool: it creates readable digital failure while keeping the source recognizable.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: medium
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    // Wrap so a long stream does not quantize the hash into a stuck pattern.
    float wrapped = fmod(elapsed_time * speed, 1024.0);
    // Hold stays near 1 Hz at the default speed so the raster does not strobe.
    float hold = floor(wrapped * 0.65);

    float row_id = floor(uv.y * (28.0 + amount * 20.0));
    float tear_on = step(0.74, hash12(float2(row_id, hold)));
    float tear = (hash12(float2(row_id * 2.3, hold + 5.0)) - 0.5) * 0.04 * amount * tear_on;
    float pull = (center_x - 0.5) * 0.018 * amount;

    float block_x = floor(uv.x * 14.0);
    float block_y = floor(uv.y * 9.0);
    float block_id = block_x + block_y * 19.0;
    float block_on = step(0.88, hash12(float2(block_id, hold + 2.0)));
    float block_shift = (hash12(float2(block_id, hold + 8.0)) - 0.5) * 0.022 * amount * block_on;

    float hold_slip = sin(wrapped * 0.55) * 0.003 * amount;
    float2 duv = float2(tear + block_shift + pull, hold_slip);
    float spread = (0.0035 + tear_on * 0.007) * intensity;

    float2 base_uv = clamp(uv + duv, 0.0, 1.0);
    float2 red_uv = clamp(uv + duv + float2(spread, 0.0), 0.0, 1.0);
    float2 blue_uv = clamp(uv + duv - float2(spread, 0.0), 0.0, 1.0);

    float source_a = image.Sample(textureSampler, clamp(uv, 0.0, 1.0)).a;
    float4 base = image.Sample(textureSampler, base_uv);
    float3 rgb = float3(
        image.Sample(textureSampler, red_uv).r,
        base.g,
        image.Sample(textureSampler, blue_uv).b);

    float3 burst = float3(rgb.b, rgb.g, rgb.r);
    rgb = lerp(rgb, burst, tear_on * 0.28 * saturate(intensity));

    float3 quant = floor(rgb * 4.0) / max(3.0, 0.001);
    rgb = lerp(rgb, quant, block_on * 0.5 * saturate(intensity));

    float drop = step(0.91, hash12(float2(row_id, hold + 3.0)));
    float snow = hash12(float2(floor(uv.x * 200.0) + floor(wrapped * 1.2), row_id));
    rgb = lerp(rgb, float3(snow, snow, snow), drop * 0.32 * saturate(amount));

    float phase = frac((uv.y - center_y) + wrapped * 0.04);
    float notch = 1.0 - smoothstep(0.0, 0.01, abs(phase - 0.5));
    rgb *= 1.0 - notch * 0.45 * saturate(intensity);

    return float4(saturate(rgb), alphaOut(source_a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
