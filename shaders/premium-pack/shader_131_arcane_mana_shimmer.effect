// Filename: shader_131_arcane_mana_shimmer.effect
// Category: Sci-fi / fantasy expansion
// Effect: Arcane mana shimmer
// Visual principle: thin violet-cyan mana ribbons and sparse glints drift over a slight refraction, stronger near the center.
// What makes it cool: arcane energy shimmers across the shot while a talking head stays recognizable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 color)
{
    return dot(color, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    // Wrap the clock so a long stream does not lose shimmer-phase precision.
    float clock = elapsed_time - floor(elapsed_time * (1.0 / 180.0)) * 180.0;
    float motion = clock * speed;
    float energy = min(max(amount, 0.0), 1.5) * min(max(intensity, 0.0), 1.5);
    float breath = 0.88 + 0.12 * sin(motion * 0.45);

    float2 field = float2(uv.x * aspect, uv.y);
    float2 wobble = float2(
        sin(field.y * 24.0 + motion * 1.35) + 0.45 * sin(field.x * 9.0 - motion * 0.8),
        cos(field.x * 19.0 - motion * 1.05) + 0.35 * sin(field.y * 13.0 + motion * 0.6)
    );
    float2 sample_uv = clamp(uv + wobble * (0.0032 * energy), 0.0, 1.0);
    float4 source = image.Sample(textureSampler, sample_uv);

    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float flow_a = sin(from_center.x * 9.0 + from_center.y * 6.5 + motion * 1.25);
    float flow_b = sin(from_center.y * 12.0 - from_center.x * 4.5 - motion * 0.75);
    float band = saturate(flow_a * flow_b);
    float ribbon = pow(band, 2.0);
    float core = pow(band, 6.0);
    float aura = exp(-dot(from_center, from_center) * 1.35);
    float glint_wave = sin(from_center.x * 46.0 + motion * 2.1) * sin(from_center.y * 39.0 - motion * 1.7);
    float glint = pow(saturate(glint_wave), 16.0);
    float catch_light = smoothstep(0.05, 0.55, luma3(source.rgb));
    float glow = (ribbon * 0.16 + core * 0.32 + glint * 0.42) * energy * breath;
    glow *= lerp(0.62, 1.0, catch_light);
    glow *= lerp(0.72, 1.0, aura);

    float3 mana = lerp(float3(0.50, 0.12, 0.95), float3(0.18, 0.82, 1.0), 0.5 + 0.5 * flow_a);
    float3 styled = saturate(source.rgb + mana * glow);
    float3 shown = lerp(source.rgb, styled, saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
