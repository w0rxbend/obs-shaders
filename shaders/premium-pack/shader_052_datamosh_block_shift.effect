// Filename: shader_052_datamosh_block_shift.effect
// Category: Cyberpunk / glitch pack
// Effect: Datamosh block shift
// Visual principle: channel separation, block displacement, horizontal tears, and quantized corruption.
// What makes it cool: it creates readable digital failure while keeping the source recognizable.
// Suggested source type: screen capture, game capture, music visuals, alerts
// Suggested shader-chain combinations: this shader -> RGB split -> digital noise
// Performance cost: medium
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    if (preserve_alpha)
    {
        return sampled_alpha;
    }
    return saturate(sampled_alpha);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 focus = float2(center_x, center_y);
    float2 from_focus = (uv - focus) * float2(aspect, 1.0);
    float reach = lerp(0.75, 1.0, saturate(length(from_focus) * 1.8));

    float cols = max(10.0 + amount * 8.0, 0.001);
    float rows = max(6.0 + amount * 5.0, 0.001);
    float2 grid = float2(cols, rows);
    float2 block_id = floor(uv * grid + focus);
    // Default speed retargets macroblocks under 2 Hz, not a full-frame strobe.
    float tick = floor(elapsed_time * speed * 1.5);
    float row_id = floor(uv.y * rows + focus.y);
    float gate = step(0.62, hash12(block_id + float2(tick, 2.0)));
    float tear_gate = step(0.82, hash12(float2(row_id, tick + 4.0)));
    float slide = hash12(block_id.yx + float2(tick, 7.0)) - 0.5;
    float lift = hash12(block_id + float2(11.0, tick)) - 0.5;
    float tear = (hash12(float2(row_id * 3.1, tick + 1.0)) - 0.5) * 0.012 * amount * tear_gate;
    float mag = 0.035 * intensity * amount * gate * reach;
    float2 duv = float2(slide * 2.0 * mag + tear, lift * 2.0 * mag * 0.28);
    float spread = 0.003 * intensity * gate;
    float2 moved = clamp(uv + duv, 0.0, 1.0);
    float2 chunk_uv = clamp((floor(moved * grid) + 0.5) / grid, 0.0, 1.0);

    float rch = image.Sample(textureSampler, clamp(moved + float2(spread, 0.0), 0.0, 1.0)).r;
    float gch = image.Sample(textureSampler, moved).g;
    float bch = image.Sample(textureSampler, clamp(moved - float2(spread, 0.0), 0.0, 1.0)).b;
    float3 shifted = float3(rch, gch, bch);
    float3 chunk = image.Sample(textureSampler, chunk_uv).rgb;
    float corrupt = saturate(0.22 * intensity) * gate;
    float3 glitched = saturate(lerp(shifted, chunk, corrupt));
    float moved_mix = saturate(max(gate, tear_gate));
    float3 moshed = lerp(source.rgb, glitched, moved_mix);
    float3 out_rgb = lerp(source.rgb, moshed, saturate(opacity));
    return float4(out_rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
