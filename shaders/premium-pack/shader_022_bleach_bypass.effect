// Filename: shader_022_bleach_bypass.effect
// Category: Cinematic camera pack
// Effect: Bleach bypass
// Visual principle: luminance-aware color remapping, contrast shaping, vignette, and animated grain.
// What makes it cool: it gives ordinary footage a clear emotional direction in one pass.
// Suggested source type: webcam, game capture, video source, cinematic scenes
// Suggested shader-chain combinations: exposure controls -> this shader -> film grain
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float overlayChannel(float base, float blend)
{
    float below = 2.0 * base * blend;
    float above = 1.0 - 2.0 * (1.0 - base) * (1.0 - blend);
    return (base <= 0.5) ? below : above;
}

float3 silverOverlay(float3 base, float silverLuma)
{
    return float3(
        overlayChannel(base.r, silverLuma),
        overlayChannel(base.g, silverLuma),
        overlayChannel(base.b, silverLuma));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 source = image.Sample(textureSampler, uv);
    float3 src = source.rgb;
    float bypass = saturate(amount);
    float silverLuma = luma3(src);
    float3 retained = lerp(src, silverOverlay(src, silverLuma), saturate(0.75 * amount));
    float contrast = 1.0 + 0.24 * intensity * bypass;
    retained = (retained - 0.5) * contrast + 0.5;
    float retainedLuma = luma3(retained);
    retained = lerp(retained, float3(retainedLuma, retainedLuma, retainedLuma), saturate(0.40 * amount));

    // Scale x by aspect so the vignette stays circular on non-square frames.
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 fromCenter = uv - float2(center_x, center_y);
    fromCenter.x *= aspect;
    float vignette = 1.0 - smoothstep(0.35, 1.15, length(fromCenter));
    retained *= lerp(1.0, lerp(0.82, 1.0, vignette), 0.65 * bypass);

    float2 grainCell = floor(uv * max(uv_size, float2(1.0, 1.0)) * 0.5);
    float grain = hash12(grainCell + floor(elapsed_time * speed * 8.0)) - 0.5;
    retained += grain * 0.04 * intensity * bypass;

    return float4(saturate(retained), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
