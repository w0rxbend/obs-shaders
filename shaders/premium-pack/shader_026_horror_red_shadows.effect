// Filename: shader_026_horror_red_shadows.effect
// Category: Cinematic camera pack
// Effect: Horror red shadows
// Visual principle: dark tones shift toward crimson, highlights stay natural, and a slow red vignette breathes.
// What makes it cool: shadows turn horror-red while a talking head stays recognizable.
// Suggested source type: webcam, game capture, video source, cinematic scenes
// Suggested shader-chain combinations: exposure controls -> this shader -> film grain
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);
    float weight = max(amount, 0.0);
    float strength = max(intensity, 0.0);
    float contrast = 1.0 + 0.16 * strength * weight;
    float3 shaped = (color.rgb - 0.5) * contrast + 0.5;
    float tone = luma3(max(shaped, float3(0.0, 0.0, 0.0)));
    float shade = 1.0 - smoothstep(0.05, 0.58, tone);
    shaped = lerp(shaped, float3(tone, tone, tone), shade * 0.40 * weight);

    // Wrap before scaling so a long stream keeps a stable pulse.
    float wrapped_time = fmod(elapsed_time, 1024.0);
    float pulse = 0.86 + 0.14 * sin(wrapped_time * speed);
    float push = shade * weight * (0.10 + 0.11 * strength) * pulse;
    float3 graded = shaped;
    graded.r = graded.r + push * (1.0 - saturate(graded.r));
    graded.g = graded.g * (1.0 - push * 0.62);
    graded.b = graded.b * (1.0 - push * 0.82);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float reach = max(length(float2(aspect * 0.5, 0.5)), 0.001);
    float edge = smoothstep(0.50, 1.20, length(from_center) / reach);
    float edge_mix = edge * saturate(0.34 * strength) * weight;
    graded *= lerp(float3(1.0, 1.0, 1.0), float3(0.46, 0.10, 0.08), edge_mix);

    graded = saturate(graded);
    float3 out_rgb = lerp(color.rgb, graded, saturate(opacity));
    return float4(out_rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
