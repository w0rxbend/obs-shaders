// Filename: shader_021_teal_and_orange.effect
// Category: Cinematic camera pack
// Effect: Teal and orange
// Visual principle: luminance-aware color remapping, contrast shaping, vignette, and animated grain.
// What makes it cool: it gives ordinary footage a clear emotional direction in one pass.
// Suggested source type: webcam, game capture, video source, cinematic scenes
// Suggested shader-chain combinations: exposure controls -> this shader -> film grain
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, float2(0.0, 0.0), float2(1.0, 1.0));
    float4 source = image.Sample(textureSampler, uv);
    float luma = luma3(source.rgb);
    float grade = amount * intensity;
    float contrast = 1.0 + 0.18 * saturate(grade);
    float3 shaped = (source.rgb - 0.5) * contrast + 0.5;

    float shadow_w = 1.0 - smoothstep(0.0, 0.55, luma);
    float highlight_w = smoothstep(0.28, 0.92, luma);
    float3 teal = float3(0.12, 0.62, 0.68);
    float3 orange = float3(1.0, 0.58, 0.22);
    float3 graded = shaped;
    graded = lerp(graded, graded * teal * 1.45, saturate(shadow_w * grade * 0.55));
    graded = lerp(graded, graded * orange * 1.12, saturate(highlight_w * grade * 0.62));

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float vignette = smoothstep(1.35, 0.40, length(from_center));
    graded *= lerp(1.0 - 0.18 * saturate(grade), 1.0, vignette);

    float2 grain_cell = floor(uv * max(uv_size, float2(1.0, 1.0)) * 0.5);
    float grain_tick = floor(elapsed_time * speed * 6.0);
    float grain = hash12(grain_cell + float2(grain_tick, grain_tick * 0.37)) - 0.5;
    graded += grain * 0.028 * saturate(grade);

    return float4(saturate(graded), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
