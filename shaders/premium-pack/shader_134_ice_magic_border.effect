// Filename: shader_134_ice_magic_border.effect
// Category: Sci-fi / fantasy expansion
// Effect: Ice magic border
// Visual principle: jagged cyan ice crystals, facet cracks, and a slow frost gleam form a frame on the source edge.
// What makes it cool: a magical ice border frames the shot while the talking head stays clear.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float alphaOut(float sampled_alpha)
{
    float alpha = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        alpha = 1.0;
    }
    return alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 edge = min(uv, float2(1.0, 1.0) - uv);
    float2 edge_in_height = float2(edge.x * aspect, edge.y);
    float inward = min(edge_in_height.x, edge_in_height.y);

    float on_horizontal = step(edge_in_height.y, edge_in_height.x);
    float on_left = step(uv.x, 0.5);
    float on_low_y = step(uv.y, 0.5);
    float low_y_along = uv.x;
    float high_y_along = 2.0 + (1.0 - uv.x);
    float right_along = 1.0 + uv.y;
    float left_along = 3.0 + (1.0 - uv.y);
    float horizontal_along = lerp(high_y_along, low_y_along, on_low_y);
    float vertical_along = lerp(right_along, left_along, on_left);
    float around = lerp(vertical_along, horizontal_along, on_horizontal) * 0.25;

    // Wrap so a multi-hour stream does not lose border-phase precision.
    float clock = elapsed_time - floor(elapsed_time * (1.0 / 180.0)) * 180.0;
    float motion = clock * speed;

    float cell_scale = 22.0 + center_y * 8.0;
    float cell_pos = around * cell_scale + center_x * 4.0;
    float cell_id = floor(cell_pos);
    float cell_frac = frac(cell_pos);
    float tooth = saturate(1.0 - abs(cell_frac - 0.5) * 2.0);
    tooth = tooth * tooth;
    float fine_frac = frac(cell_pos * 2.0 + 1.7);
    float fine_tooth = saturate(1.0 - abs(fine_frac - 0.5) * 2.0);
    float seed = hash12(float2(cell_id, 2.0));
    float breathe = 0.72 + 0.28 * sin(motion * 1.1 + seed * 6.283185);
    float spike = (0.28 + 0.72 * seed) * (0.4 + 0.6 * tooth) * (0.72 + 0.28 * fine_tooth) * breathe;

    float width = 0.016 * max(amount, 0.0);
    float reach = width * (0.75 + spike * 2.35);
    float alive = step(0.0008, max(amount, 0.0));
    float border_t = saturate(inward / max(reach, 0.001));
    float core = 1.0 - smoothstep(0.0, 0.26, border_t);
    float frost = 1.0 - smoothstep(0.12, 1.0, border_t);
    float crack = smoothstep(0.10, 0.0, min(cell_frac, 1.0 - cell_frac));

    float gleam_phase = around * 6.283185 + (center_x - 0.5) * 3.2 + (center_y - 0.5) * 2.1;
    // 0.12 Hz at speed 0.83. The gleam stays on the rim and under 1 Hz at the slider max.
    float gleam = 0.64 + 0.36 * sin(gleam_phase - motion * 0.9);
    float twinkle_wave = 0.5 + 0.5 * sin(motion * 1.6 + seed * 11.0);
    float twinkle = smoothstep(0.84, 1.0, twinkle_wave) * core;

    float2 from_center = uv - float2(0.5, 0.5);
    from_center.x *= aspect;
    float2 out_dir = from_center / max(length(from_center), 0.001);
    out_dir.x /= max(aspect, 0.001);
    float2 frost_uv = clamp(uv + out_dir * (0.006 * spike), 0.0, 1.0);
    float3 frost_rgb = image.Sample(textureSampler, frost_uv).rgb;

    float strength = saturate(opacity) * max(intensity, 0.0);
    float shell = saturate(core * min(strength, 1.65) * gleam) * alive;
    float haze = saturate(frost * 0.55 * min(strength, 1.45)) * alive;

    float3 ice_deep = float3(0.32, 0.58, 0.90);
    float3 ice_body = float3(0.58, 0.84, 1.0);
    float3 ice_tip = float3(0.94, 0.98, 1.0);
    float3 ice = lerp(ice_deep, ice_body, saturate(tooth * 0.7 + gleam * 0.45));
    ice = lerp(ice, ice_tip, saturate(core * 0.7 + twinkle));
    ice = lerp(ice, ice * 0.62, crack * 0.55);

    float mask = saturate(max(haze, shell));
    float3 refracted = lerp(source.rgb, frost_rgb, saturate(haze * 0.5));
    float3 styled = lerp(refracted, ice, saturate(haze * 0.82));
    styled = lerp(styled, saturate(ice + twinkle * 0.45), shell);
    styled = saturate(styled);
    float3 rgb = lerp(source.rgb, styled, mask);
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
