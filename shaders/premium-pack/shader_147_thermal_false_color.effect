// Filename: shader_147_thermal_false_color.effect
// Category: Extreme / transition expansion
// Effect: Thermal false color
// Visual principle: luminance maps through a black, blue, cyan, red, yellow, white heat palette.
// What makes it cool: a talking-head stays readable as a live thermal camera, with a slow sensor drift instead of a strobe.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.65;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float3 thermalFalseColor(float heat)
{
    float t = saturate(heat);
    float3 black = float3(0.0, 0.0, 0.0);
    float3 blue = float3(0.02, 0.04, 0.62);
    float3 cyan = float3(0.0, 0.70, 0.88);
    float3 red = float3(0.90, 0.06, 0.04);
    float3 yellow = float3(1.0, 0.86, 0.05);
    float3 white = float3(1.0, 1.0, 1.0);
    float3 color = lerp(black, blue, saturate(t * 5.0));
    color = lerp(color, cyan, saturate((t - 0.2) * 5.0));
    color = lerp(color, red, saturate((t - 0.4) * 5.0));
    color = lerp(color, yellow, saturate((t - 0.6) * 5.0));
    color = lerp(color, white, saturate((t - 0.8) * 5.0));
    return color;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float luma = dot(source.rgb, float3(0.299, 0.587, 0.114));
    float heat = saturate((luma - 0.5) * max(amount, 0.0) + 0.5);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 delta = uv - float2(center_x, center_y);
    float radius = length(float2(delta.x * aspect, delta.y));
    float hotspot = saturate(1.0 - radius) * 0.06;

    // Default speed 0.65 is about 0.10 Hz, under the 3 Hz full-frame flash limit.
    float phase = fmod(elapsed_time * max(speed, 0.0), 1024.0);
    float drift = sin(phase) * 0.03;
    heat = saturate(heat + hotspot + drift);

    float3 thermal = saturate(thermalFalseColor(heat));
    float3 rgb = lerp(source.rgb, thermal, saturate(intensity));
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
