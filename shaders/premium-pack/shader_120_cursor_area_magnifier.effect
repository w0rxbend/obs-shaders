// Filename: shader_120_cursor_area_magnifier.effect
// Category: Screen capture utility expansion
// Effect: Cursor area magnifier
// Visual principle: a circular lens at the cursor center magnifies that area; the rest of the frame stays 1:1.
// What makes it cool: a detail under the cursor gets larger without scaling the whole OBS source.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform float2 uv_size;
uniform float2 uv_pixel_interval;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.85;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 center = float2(center_x, center_y);
    float2 from_center = uv - center;
    from_center.x *= aspect;
    float dist = length(from_center);

    // Wrap the phase so a long stream does not collapse the sine.
    float phase = fmod(elapsed_time * speed, 6.283185307);
    float magnify = 1.0 + max(intensity, 0.0) * (1.15 + sin(phase) * 0.06);
    magnify = max(magnify, 0.001);
    float radius = max(amount, 0.0) * 0.26;
    float pixel_span = length(float2(uv_pixel_interval.x * aspect, uv_pixel_interval.y));
    float edge = max(pixel_span * 2.0, 0.0015);
    float lens_end = max(radius, edge);
    float lens = 1.0 - smoothstep(max(lens_end - edge, 0.0), lens_end, dist);
    float rim = 1.0 - smoothstep(0.0, edge, abs(dist - lens_end));

    float2 magnified = from_center / magnify;
    magnified.x /= max(aspect, 0.001);
    float2 magnified_uv = center + magnified;

    float4 base = image.Sample(textureSampler, clamp(uv, float2(0.0, 0.0), float2(1.0, 1.0)));
    float4 zoomed = image.Sample(textureSampler, clamp(magnified_uv, float2(0.0, 0.0), float2(1.0, 1.0)));
    float3 rgb = lerp(base.rgb, zoomed.rgb, lens);
    rgb = lerp(rgb, lerp(rgb, float3(1.0, 1.0, 1.0), 0.45), rim);
    float sampled_alpha = lerp(base.a, zoomed.a, lens);
    return float4(rgb, alphaOut(sampled_alpha));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
