// Filename: shader_102_neon_kaleido_wash.effect
// Category: VJ / music video expansion
// Effect: Neon kaleido wash
// Visual principle: mirrored wedges around a center, washed with a slow cyan-magenta neon tint.
// What makes it cool: the frame folds into neon kaleidoscope color while a talking head stays readable.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float angle_from(float y, float x)
{
    // Pack rule rejects atan2. One-argument atan stays inside the effect compiler.
    float ax = max(abs(x), 0.0001);
    float a = atan(y / ax);
    if (x < 0.0)
        a = (y < 0.0 ? -3.14159265 : 3.14159265) - a;
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 origin = float2(center_x, center_y);
    float2 from_center = (uv - origin) * float2(aspect, 1.0);
    float radius = length(from_center);

    float tau = 6.28318530718;
    float slices = 3.0 + floor(saturate(amount * 0.5) * 5.0);
    float slice = tau / max(slices, 0.001);
    float spin = fmod(elapsed_time * speed * 0.15, tau);
    float ang = angle_from(from_center.y, from_center.x) + spin;
    float sector = fmod(ang, slice);
    if (sector < 0.0)
    {
        sector += slice;
    }
    float half_slice = slice * 0.5;
    float folded_angle = half_slice - abs(sector - half_slice);

    float2 folded = float2(
        cos(folded_angle) * radius / max(aspect, 0.001),
        sin(folded_angle) * radius);
    float2 sample_uv = clamp(origin + folded, 0.0, 1.0);
    float3 mirrored = image.Sample(textureSampler, sample_uv).rgb;

    float luma = dot(mirrored, float3(0.299, 0.587, 0.114));
    float hue = 0.5 + 0.5 * sin(folded_angle + spin);
    float3 neon = lerp(float3(0.0, 0.85, 1.0), float3(1.0, 0.05, 0.75), hue);
    float neon_amt = saturate(0.55 + 0.25 * (amount - 1.0));
    float3 tinted = saturate(lerp(mirrored, neon * (0.30 + 0.70 * luma), neon_amt));

    // Center stays close to the source so a talking head still reads at the default.
    float edge = smoothstep(0.18, 0.70, radius);
    float wash = saturate((0.22 + 0.78 * edge) * intensity * opacity);
    float3 rgb = saturate(lerp(source.rgb, tinted, wash));
    return float4(rgb, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
