// Filename: shader_032_silent_movie_projector.effect
// Category: Retro analog pack
// Effect: Silent movie projector
// Visual principle: silver nitrate grade, lamp flicker under 3 Hz, gate weave, dust, and a projector vignette.
// What makes it cool: it sells nostalgic hardware instability with cheap procedural math.
// Suggested source type: game capture, retro scenes, video source, screen capture
// Suggested shader-chain combinations: this shader -> chromatic aberration -> vignette
// Performance cost: low
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.30;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.01;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.37;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    [branch]
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float t = elapsed_time * speed;
    // 2*speed keeps the default lamp step at 2.74 Hz, under a 3 Hz full-frame flash.
    float frame = floor(t * 2.0);
    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float weave_x = (hash12(float2(frame, 1.7)) - 0.5) * 0.008 * amount;
    float weave_y = (hash12(float2(frame, 4.2)) - 0.5) * 0.006 * amount;
    float slip = (hash12(float2(floor(t * 0.35), 9.1)) - 0.5) * 0.008 * amount;
    float2 uv = clamp(v_in.uv + float2(weave_x, weave_y + slip), 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float luma = luma3(source.rgb);
    float contrast = 1.0 + 0.22 * amount;
    float graded = saturate((luma - 0.5) * contrast + 0.5);
    float3 shadow = float3(0.08, 0.07, 0.06);
    float3 paper = float3(0.96, 0.93, 0.84);
    float3 silver = lerp(shadow, paper, graded);

    float lamp = 0.94 + 0.06 * hash12(float2(frame, 2.4));
    lamp *= 1.0 + 0.02 * intensity * sin(t * 2.1);
    silver *= lamp;

    float grain = hash12(floor(uv * uv_size) + float2(frame, 0.37)) - 0.5;
    silver += grain * 0.04 * intensity;

    float2 cell = floor(uv * float2(96.0, 54.0));
    float2 local = frac(uv * float2(96.0, 54.0));
    float dust_seed = hash12(cell + float2(frame, 3.0));
    float2 speck_at = float2(hash12(cell + 1.3), hash12(cell + 7.7));
    float speck = 1.0 - smoothstep(0.0, 0.16, length(local - speck_at));
    float dust = step(0.994, dust_seed) * speck;

    float column = floor(uv.x * aspect * 240.0);
    float scratch_seed = hash12(float2(column, floor(t * 0.4)));
    float hair = 1.0 - smoothstep(0.0, 0.35, abs(frac(uv.x * aspect * 240.0) - 0.5));
    float band = step(0.72, frac(uv.y * 2.0 + scratch_seed * 5.0));
    float scratch = step(0.997, scratch_seed) * hair * band;
    silver += (dust * 0.45 + scratch * 0.28) * intensity;

    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float vig = 1.0 - smoothstep(0.55, 1.35, length(from_center)) * 0.42 * saturate(amount);
    silver *= vig;

    float3 out_rgb = lerp(source.rgb, saturate(silver), saturate(intensity));
    return float4(saturate(out_rgb), alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
