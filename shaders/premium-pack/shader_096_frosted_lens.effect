// Filename: shader_096_frosted_lens.effect
// Category: Weather / atmosphere pack
// Effect: Frosted lens
// Visual principle: small-kernel diffusion through a milky lens, stronger away from center, with a cool highlight veil.
// What makes it cool: it adds environmental storytelling without external image textures.
// Suggested source type: webcam, game capture, video source, image source
// Suggested shader-chain combinations: this shader -> cinematic grade -> lens dirt
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;
uniform float2 uv_pixel_interval;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;
uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 0.93;
uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.55;
uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;
uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;
uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    from_center.x *= aspect;
    float edge = saturate(length(from_center));

    float phase = fmod(elapsed_time * speed * 0.45, 6.28318530718);
    float breathe = 0.85 + 0.15 * sin(phase);
    float spread = (1.6 + amount * 2.2) * breathe * max(intensity, 0.0);
    float2 px = uv_pixel_interval * spread;

    float3 blurred = color.rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(-px.x, -px.y), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(0.0, -px.y), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(px.x, -px.y), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(-px.x, 0.0), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(px.x, 0.0), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(-px.x, px.y), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(0.0, px.y), 0.0, 1.0)).rgb;
    blurred += image.Sample(textureSampler, clamp(uv + float2(px.x, px.y), 0.0, 1.0)).rgb;
    blurred /= max(9.0, 0.001);

    float luma = dot(color.rgb, float3(0.299, 0.587, 0.114));
    float highlight = saturate((luma - 0.62) / max(0.38, 0.001));
    float frost_mix = saturate((0.42 + 0.28 * edge) * intensity * (0.55 + 0.45 * saturate(amount)));
    float3 milk = float3(0.86, 0.91, 0.96);
    float3 diffused = lerp(color.rgb, blurred, frost_mix);
    float3 frosted = lerp(diffused, milk, frost_mix * (0.08 + 0.10 * highlight));
    frosted = saturate(frosted);

    float3 rgb = lerp(color.rgb, frosted, saturate(opacity));
    return float4(rgb, alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
