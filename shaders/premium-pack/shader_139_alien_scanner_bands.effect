// Filename: shader_139_alien_scanner_bands.effect
// Category: Sci-fi / fantasy expansion
// Effect: Alien scanner bands
// Visual principle: several green scan bands travel the frame while the subject stays readable.
// What makes it cool: HUD scan bands read the subject without hiding a talking-head source.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.15;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.17;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = 1.0;
    }
    return a * saturate(opacity);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);
    // 0.22 keeps the default under one band pass every two seconds.
    float travel = elapsed_time * speed * 0.22 + (center_y - 0.5);

    float wide_span = max(0.07 + 0.035 * amount, 0.001);
    float wide = 1.0 - smoothstep(0.0, wide_span, abs(frac(uv.y - travel) - 0.5));

    float tick_span = max(0.010 + 0.006 * amount, 0.001);
    float tick = 1.0 - smoothstep(0.0, tick_span, abs(frac(uv.y * 3.0 - travel * 1.15) - 0.5));

    float hair_span = max(0.006 + 0.004 * amount, 0.001);
    float hair = 1.0 - smoothstep(0.0, hair_span, abs(frac(uv.y * 2.0 + travel * 0.63 + center_x) - 0.5));

    float column = 1.0 - smoothstep(0.08, 0.92, abs(uv.x - center_x));
    float lamp = lerp(0.62, 1.0, column);

    float luma = dot(color.rgb, float3(0.299, 0.587, 0.114));
    float3 alien = float3(luma * 0.28, luma * 0.90, luma * 0.42);
    float grade = saturate(0.22 * intensity);
    float3 rgb = lerp(color.rgb, alien, grade);

    float3 band = float3(0.42, 1.0, 0.58);
    rgb += band * (wide * 0.09 + tick * 0.40 + hair * 0.26) * lamp * intensity;

    float scan = sin(uv.y * 210.0) * 0.5 + 0.5;
    rgb *= lerp(0.90, 1.0, scan);

    return float4(saturate(rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
