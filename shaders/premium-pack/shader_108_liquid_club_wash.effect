// Filename: shader_108_liquid_club_wash.effect
// Category: VJ / music video expansion
// Effect: Liquid club wash
// Visual principle: a slow liquid UV flow under moving magenta, cyan, and amber club light washes.
// What makes it cool: the picture ripples like liquid while colored club lights wash across a recognizable talking head.
// Suggested source type: webcam camera source, image source, video source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> color grade
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 1.19;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float alphaOut(float sampled_alpha)
{
    [branch]
    if (!preserve_alpha)
    {
        return 1.0;
    }
    return sampled_alpha;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 source = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float2 field = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    float t = elapsed_time * speed;

    float wave_x = sin(field.y * 7.5 + t * 1.05);
    float wave_y = cos(field.x * 6.0 - t * 0.82);
    float wave_d = sin((field.x + field.y) * 4.5 + t * 0.64);
    // amount 1.09 stays near a 1% UV shift so a talking head stays readable.
    float amp = amount * 0.010;
    float2 offset = float2(wave_x + wave_d * 0.40, wave_y - wave_d * 0.30) * amp;
    float2 liquid_uv = clamp(uv + offset, 0.0, 1.0);
    float4 flowed = image.Sample(textureSampler, liquid_uv);

    float sweep = field.x * 0.45 + field.y;
    float mag_w = pow(saturate(0.5 + 0.5 * sin(sweep * 2.4 + t * 0.50)), 2.0);
    float cyn_w = pow(saturate(0.5 + 0.5 * sin(sweep * 1.8 - t * 0.38 + 2.1)), 2.0);
    float amb_w = pow(saturate(0.5 + 0.5 * sin(field.y * 2.7 + t * 0.29 + 4.0)), 2.0);

    // Spatial gels move near 0.1 Hz at the default speed, so the frame never strobes.
    float wash = max(intensity, 0.0) * 0.16;
    float3 gel = float3(1.00, 0.10, 0.58) * mag_w;
    gel += float3(0.06, 0.70, 1.00) * cyn_w;
    gel += float3(1.00, 0.46, 0.08) * amb_w;
    gel *= wash;

    float3 lit = flowed.rgb + gel * (1.0 - flowed.rgb);
    float3 shown = lerp(source.rgb, saturate(lit), saturate(opacity));
    return float4(shown, alphaOut(source.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
