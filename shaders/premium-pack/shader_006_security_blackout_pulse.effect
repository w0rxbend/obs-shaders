// Filename: shader_006_security_blackout_pulse.effect
// Category: Confidential / privacy pack
// Effect: Security blackout pulse
// Visual principle: large-kernel signal destruction with pixel quantization and procedural privacy noise.
// What makes it cool: it hides readable details but leaves the audience aware that real content exists underneath.
// Suggested source type: screen capture, browser source, IDEs, dashboards, documents
// Suggested shader-chain combinations: soft vignette -> this shader -> subtle noise or scanline overlay
// Performance cost: medium
// Alpha safe: no
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.93;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.5;
    float step = 0.01;
> = 1.73;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = false;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hash12(float2 p)
{
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return frac((p3.x + p3.y) * p3.z);
}

float luma3(float3 c)
{
    return dot(c, float3(0.299, 0.587, 0.114));
}

float alphaOut(float sampled_alpha)
{
    float a = sampled_alpha;
    if (!preserve_alpha)
    {
        a = sampled_alpha * saturate(opacity);
    }
    return a;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);
    float2 pixels = max(uv_size, float2(1.0, 1.0));
    float block = max(lerp(16.0, 56.0, saturate(amount)), 0.001);
    float2 cells = max(pixels / block, float2(1.0, 1.0));
    float2 quant_uv = (floor(uv * cells) + 0.5) / max(cells, float2(0.001, 0.001));
    quant_uv = clamp(quant_uv, 0.0, 1.0);
    float4 blocked = image.Sample(textureSampler, quant_uv);

    // speed is hertz. Cap at 2.5 so a full close stays under 3 per second.
    float pulse_hz = min(max(speed, 0.0), 2.5);
    float pulse = 0.5 + 0.5 * sin(elapsed_time * pulse_hz * 6.2831853);
    float phase = floor(elapsed_time * pulse_hz);
    float grain = hash12(floor(uv * cells) + phase);

    float gray = luma3(blocked.rgb);
    float strength = saturate(intensity);
    float3 secured = lerp(blocked.rgb, float3(gray, gray, gray), 0.75 * strength);
    secured *= lerp(1.0, 0.78, strength);
    secured = lerp(secured, secured * float3(0.55, 0.68, 0.78), 0.40 * strength);
    float scan = 0.88 + 0.12 * frac(uv.y * pixels.y * 0.5);
    secured *= scan;
    secured += (grain - 0.5) * 0.08 * strength;

    float aspect = pixels.x / max(pixels.y, 1.0);
    float2 from_center = uv - float2(center_x, center_y);
    float dist = length(float2(from_center.x * aspect, from_center.y));
    float close = saturate(pulse * amount);
    float radius = lerp(1.45, -0.06, close * strength);
    float shutter = smoothstep(radius, radius + 0.045, dist);
    float3 blackout = lerp(secured, float3(0.0, 0.0, 0.0), shutter);

    float3 out_rgb = lerp(color.rgb, blackout, saturate(opacity));
    return float4(saturate(out_rgb), alphaOut(color.a));
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
