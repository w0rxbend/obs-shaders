// Filename: shader_078_hexagon_crop.effect
// Category: Streamer branding pack
// Effect: Hexagon crop
// Visual principle: alpha-safe geometric masking, decorative frames, and procedural edge treatment.
// What makes it cool: it turns a plain source into a branded layout element.
// Suggested source type: webcam camera source, streamer layouts, browser source
// Suggested shader-chain combinations: this shader -> soft drop shadow -> animated border
// Performance cost: low
// Alpha safe: yes
// Limitations: single-pass approximation; no external textures; heavy multi-pass reference looks are simplified for live OBS use.
// OBS Shaderfilter compatibility notes: HLSL-like .effect syntax, mainImage entry point, image.Sample(textureSampler, uv), no GLSL/Shadertoy-only uniforms.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_pixel_interval;
uniform float2 uv_size;

uniform float intensity <
    string label = "Intensity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.00;

uniform float amount <
    string label = "Amount";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 2.0;
    float step = 0.01;
> = 1.09;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 4.0;
    float step = 0.01;
> = 0.83;

uniform float center_x <
    string label = "Center X";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float center_y <
    string label = "Center Y";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5;

uniform float opacity <
    string label = "Opacity";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 1.0;

uniform bool preserve_alpha = true;

sampler_state textureSampler {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float hexagonDistance(float2 p, float radius)
{
    float2 sector = float2(-0.866025404, 0.5);
    float flat_half = 0.577350269 * radius;
    p = abs(p);
    p -= 2.0 * min(dot(sector, p), 0.0) * sector;
    p -= float2(clamp(p.x, -flat_half, flat_half), radius);
    return length(p) * sign(p.y);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = clamp(v_in.uv, 0.0, 1.0);
    float4 color = image.Sample(textureSampler, uv);

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    if (aspect < 0.001)
    {
        aspect = 1.0;
    }

    float2 p = (uv - float2(center_x, center_y)) * float2(aspect, 1.0);
    // fmod keeps the phase stable on a long stream. 0.83 / tau stays near 0.13 Hz.
    float phase = fmod(elapsed_time * max(speed, 0.0), 6.283185);
    float breath = sin(phase) * 0.015 * saturate(speed);
    float radius = max(0.385 * amount + breath, 0.0);
    float dist = hexagonDistance(p, radius);
    float aa = max(length(uv_pixel_interval * float2(aspect, 1.0)), 0.001);
    float mask = 1.0 - smoothstep(-aa, aa, dist);
    float cover = lerp(1.0, mask, saturate(intensity));

    float3 rgb = color.rgb;
    float alpha = color.a * cover * saturate(opacity);
    if (!preserve_alpha)
    {
        rgb = lerp(float3(0.02, 0.025, 0.03), color.rgb, cover);
        alpha = saturate(opacity);
    }
    return float4(rgb, alpha);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
