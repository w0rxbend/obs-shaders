// L7 — arctic-blue
// Performance: low
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Cold arctic blue grade — heavy blue-cyan push, high contrast, clean whites
// Chain order: early in chain; add cold-moonlight for deeper night look

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float blue_strength <
    string label = "Blue Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.6;

uniform float contrast <
    string label = "Contrast";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 3.0;
    float step = 0.01;
> = 1.5;

uniform float saturation <
    string label = "Saturation";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.5;
    float step = 0.01;
> = 0.7;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float luma(float3 c)
{
    return dot(c, float3(0.2126, 0.7152, 0.0722));
}

float4 mainImage(VertData v_in) : TARGET
{
    float4 col = image.Sample(textureSampler, v_in.uv);
    float3 c   = col.rgb;

    // Saturation adjustment
    float lum = luma(c);
    float3 grey = float3(lum, lum, lum);
    c = lerp(grey, c, saturation);

    // High contrast
    float pivot = 0.5;
    c = (c - pivot) * contrast + pivot;

    // Arctic blue-cyan push
    // Lift blue strongly, slight cyan (lift G a bit), crush red
    c.b += blue_strength * 0.32;
    c.g += blue_strength * 0.10;
    c.r -= blue_strength * 0.18;

    // Keep whites clean — prevent blue from going purple in highlights
    float highlightMask = smoothstep(0.7, 1.0, luma(c));
    c.r += highlightMask * blue_strength * 0.10;
    c.g += highlightMask * blue_strength * 0.05;

    c = clamp(c, 0.0, 1.0);
    return float4(c, col.a);
}

technique Draw
{
    pass p0
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
