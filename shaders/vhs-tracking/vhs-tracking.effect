// C8 — vhs-tracking
// VHS tape tracking noise — animated horizontal bands that shift and tear.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float band_count <
    string label = "Band Count";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 10.0;
    float step = 0.1;
> = 3.0;

uniform float shift_strength <
    string label = "Shift Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.05;
    float step = 0.001;
> = 0.015;

uniform float noise_strength <
    string label = "Noise Strength";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.3;
    float step = 0.01;
> = 0.1;

uniform float speed <
    string label = "Speed";
    string widget_type = "slider";
    float minimum = 0.2;
    float maximum = 3.0;
    float step = 0.1;
> = 0.8;

uniform texture2d image;
uniform float elapsed_time;
uniform float2 uv_size;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

float Hash11(float x)
{
    return frac(sin(x * 127.1) * 43758.5453);
}

float Hash21(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv = v_in.uv;

    // Integer period keeps frac(bandPhase) continuous when the clock wraps.
    float t = fmod(elapsed_time * speed, 1024.0);
    float bandPhase = uv.y * band_count - t;
    float bandY = frac(bandPhase);
    float bandId = floor(bandPhase);
    // 64 divides 1024, so a clock wrap does not change which band is hashed.
    float bandSlot = fmod(fmod(bandId, 64.0) + 64.0, 64.0);

    float bandRand = Hash11(bandSlot * 7.3 + floor(t * 0.25));
    float bandShift = (Hash11(bandSlot * 13.7 + floor(t * 0.5)) - 0.5) * 2.0;

    float tearFactor = smoothstep(0.0, 0.15, bandY) * (1.0 - smoothstep(0.85, 1.0, bandY));
    float hShift = bandShift * shift_strength * tearFactor * bandRand;

    float aspect = uv_size.x / max(uv_size.y, 1.0);
    float noiseY = floor(uv.y * 180.0);
    float noiseX = floor(uv.x * 180.0 * aspect);
    float noiseTick = fmod(floor(t * 15.0), 256.0);
    float noiseVal = Hash21(float2(noiseX, noiseY) + float2(noiseTick, 0.0));
    noiseVal = noiseVal * 2.0 - 1.0;

    float2 shiftedUv = saturate(float2(uv.x + hShift, uv.y));
    float4 col = image.Sample(textureSampler, shiftedUv);

    float noiseMask = tearFactor * bandRand * noise_strength;
    col.rgb = saturate(col.rgb + float3(noiseVal, noiseVal, noiseVal) * noiseMask);

    float luma = dot(col.rgb, float3(0.299, 0.587, 0.114));
    float desatAmt = tearFactor * bandRand * noise_strength * 2.0;
    col.rgb = lerp(col.rgb, float3(luma, luma, luma), saturate(desatAmt));

    return float4(saturate(col.rgb), col.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader = mainImage(v_in);
    }
}
