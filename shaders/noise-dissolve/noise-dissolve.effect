// Performance: medium
// Webcam safe: yes
// Preserves alpha: yes
// Use case: Noise-threshold dissolve — pixels disappear based on 2D noise pattern
// Chain order: Apply last; great after grain/film-grain for organic texture stacking

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_offset;
uniform float2 uv_scale;

uniform float progress <
    string label = "Progress";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 1.0;
    float step = 0.01;
> = 0.5; // 0.0 = fully visible, 1.0 = fully dissolved

uniform float noise_scale <
    string label = "Noise Scale";
    string widget_type = "slider";
    float minimum = 1.0;
    float maximum = 10.0;
    float step = 0.1;
> = 4.0; // 1.0–10.0 spatial frequency of noise

uniform float softness <
    string label = "Softness";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.2;
    float step = 0.001;
> = 0.05; // 0.0–0.2 transition softness

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// 2D value noise
float hash2(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float noise2d(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f); // smooth
    float a  = hash2(i + float2(0.0, 0.0));
    float b  = hash2(i + float2(1.0, 0.0));
    float c  = hash2(i + float2(0.0, 1.0));
    float d  = hash2(i + float2(1.0, 1.0));
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Two-octave fBm for richer texture
float fbm(float2 p)
{
    float v = 0.0;
    v += 0.60 * noise2d(p);
    v += 0.30 * noise2d(p * 2.1 + float2(3.7, 1.3));
    v += 0.10 * noise2d(p * 4.3 + float2(7.1, 5.9));
    return v;
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv    = v_in.uv;
    float4 color = image.Sample(textureSampler, uv);

    float n      = fbm(uv * noise_scale);

    // Pixel survives when n > progress threshold
    float half_s = max(softness, 0.001);
    float visible = 1.0 - smoothstep(n - half_s, n + half_s, progress);

    color.rgb *= visible;
    return color;
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
