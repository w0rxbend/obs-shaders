// F2 — posterize
// Reduces colour depth to N steps per channel with optional ordered dithering.

uniform float4x4 ViewProj;
uniform float2 uv_offset;
uniform float2 uv_scale;
uniform int levels <
    string label = "Levels";
    string widget_type = "slider";
    int minimum = 2;
    int maximum = 16;
    int step = 1;
> = 4;
uniform float dither <
    string label = "Dither";
    string widget_type = "slider";
    float minimum = 0.0;
    float maximum = 0.5;
    float step = 0.01;
> = 0.0; // 0.0 – 0.5  dither strength (0 = none)

uniform float2    uv_pixel_interval;
uniform texture2d image;

sampler_state textureSampler {
    Filter   = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};

struct VertData {
    float4 pos : POSITION;
    float2 uv  : TEXCOORD0;
};


VertData VSDefault(VertData v_in)
{
    VertData vert_out;
    vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
    vert_out.uv  = v_in.uv * uv_scale + uv_offset;
    return vert_out;
}

// 4x4 Bayer ordered-dither matrix, values in [0,1).
float bayer4x4(float2 pixelPos)
{
    // Flatten: we compute the matrix value analytically.
    // Cap at 3 so frac*4 never indexes past the 16-entry table.
    float2 p = min(frac(pixelPos / 4.0) * 4.0, float2(3.0, 3.0));
    int ix = int(p.x);
    int iy = int(p.y);

    // 16-entry Bayer matrix (row-major).
    float mat[16];
    mat[0]  =  0.0 / 16.0;  mat[1]  =  8.0 / 16.0;  mat[2]  =  2.0 / 16.0;  mat[3]  = 10.0 / 16.0;
    mat[4]  = 12.0 / 16.0;  mat[5]  =  4.0 / 16.0;  mat[6]  = 14.0 / 16.0;  mat[7]  =  6.0 / 16.0;
    mat[8]  =  3.0 / 16.0;  mat[9]  = 11.0 / 16.0;  mat[10] =  1.0 / 16.0;  mat[11] =  9.0 / 16.0;
    mat[12] = 15.0 / 16.0;  mat[13] =  7.0 / 16.0;  mat[14] = 13.0 / 16.0;  mat[15] =  5.0 / 16.0;

    return mat[iy * 4 + ix];
}

float4 mainImage(VertData v_in) : TARGET
{
    float2 uv  = v_in.uv;
    float4 src = image.Sample(textureSampler, uv);

    float2 pixelPos = uv / max(uv_pixel_interval, float2(0.001, 0.001));
    float  thresh   = bayer4x4(pixelPos) - 0.5; // [-0.5, +0.5)

    float lvls = clamp(float(levels), 2.0, 16.0);
    float steps = max(lvls - 1.0, 0.001);

    // Dither: offset each channel by the threshold scaled by dither amount,
    // then quantise to the nearest step.
    float3 ditherOffset = float3(thresh, thresh, thresh) * dither;
    float3 biased = saturate(src.rgb + ditherOffset);
    float3 quantised = floor(biased * steps + 0.5) / steps;

    return float4(saturate(quantised), src.a);
}

technique Draw
{
    pass
    {
        vertex_shader = VSDefault(v_in);
        pixel_shader  = mainImage(v_in);
    }
}
